# MemoFlow 开发环境配置
# =============================================================================
# 此文件包含开发环境的默认值，可安全提交到 Git
# 敏感配置请在 .env.local 或 .env.development.local 中覆盖
# =============================================================================

# =============================================================================
# 1️⃣  应用基础配置
# =============================================================================
NODE_ENV=development
API_PORT=20221
API_HOST=localhost
LOG_LEVEL=debug
TZ=Asia/Shanghai
APP_NAME=MemoFlow
APP_VERSION=0.1.0

# =============================================================================
# 2️⃣  Docker 镜像配置（开发环境本地运行时用）
# =============================================================================
# REGISTRY=docker.io
# IMAGE_NAMESPACE=MemoFlow
# API_TAG=v1.0.3
# WEB_TAG=v1.0.1
API_HOST_PORT=20221
WEB_HOST_PORT=20220
POWERSYNC_HOST_PORT=20222
POSTGRES_HOST_PORT=20230
REDIS_HOST_PORT=20231

# =============================================================================
# 3️⃣  数据库配置（对齐当前本地 Docker PostgreSQL）
# =============================================================================
DB_HOST=localhost
DB_PORT=20230
DB_NAME=MemoFlow
DB_USER=MemoFlow
DB_PASSWORD=MemoFlow123
DATABASE_URL=postgresql://MemoFlow:MemoFlow123@localhost:20230/MemoFlow?schema=public

# =============================================================================
# 4️⃣  Redis 缓存配置（对齐当前本地 Docker Redis）
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=20231
REDIS_PASSWORD=MemoFlow123
REDIS_DB=0

# =============================================================================
# 5️⃣  JWT 认证配置
# =============================================================================
# 开发环境使用简单密钥即可，生产环境必须强密钥！
JWT_SECRET=dev-only-jwt-secret-do-not-use-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# =============================================================================
# 6️⃣  CORS 跨域配置（开发环境允许本地访问）
# =============================================================================
CORS_ORIGIN=http://localhost:20220,http://127.0.0.1:20220,http://localhost:20221,http://127.0.0.1:20221

# =============================================================================
# 7️⃣  Web 前端配置
# =============================================================================
WEB_PORT=8080
POWERSYNC_PORT=8080
VITE_DEV_PORT=20220
# GCP host-dev defaults to Vite's bundled dev mode so a workstation browser does not
# fetch the entire native-ESM module graph over SSH/Tailscale. Set false in
# .env.development.local for the legacy unbundled Vite server when debugging it.
MEMOFLOW_VITE_BUNDLED_DEV=true
# Remote host-dev prefers a stable upfront bundle. Rolldown lazy compilation turns
# each dynamic-import boundary into a request/compile round trip and can amplify
# Tailnet latency into repeated pending/reload cycles. Override to true only for A/B.
MEMOFLOW_VITE_BUNDLED_DEV_LAZY=false

# (前端请求前缀)，浏览器会向 http://localhost:20220/api/v1 发请求，从而触发 Vite 的本地代理。
VITE_API_BASE_URL=/api/v1

# (后端真实地址 / 代理目标)它告诉本地的 Vite 代理服务器：“当你拦截到前端发来的 /api/v1 请求时，请把它悄悄转发给本地跑在 http://localhost:20221 的后端代码”。
PROXY_TARGET_URL=http://localhost:20221      # 开发环境直接访问 API
APP_DOMAIN=localhost
API_DOMAIN=localhost
AUTH_BASE_URL=http://localhost:20221/api/auth
MEMOFLOW_WEB_URL=http://localhost:20220

# Merged from apps/web/.env.development
VITE_UPLOAD_BASE_URL=http://localhost:3888/api/v1/upload
VITE_LOG_LEVEL=debug
VITE_ENABLE_DEVTOOLS=true
# Set to true to enable MSW (Mock Service Worker) — intercepts API requests with mock data.
# Useful when the backend is unavailable. Requires public/mockServiceWorker.js to be present.
VITE_ENABLE_MOCK_API=false

# =============================================================================
# 8️⃣  文件上传配置
# =============================================================================
UPLOAD_MAX_SIZE=10485760                # 10MB

# =============================================================================
# 9️⃣  功能开关
# =============================================================================
ENABLE_DAILY_ANALYSIS=true              # 开发环境启用分析便于测试
USE_PRIORITY_QUEUE_SCHEDULER=true

# =============================================================================
# 🔟 开发环境可选配置
# =============================================================================
# Sentry 错误追踪（开发时可启用，便于测试）
# SENTRY_DSN=

# AI 服务（可选）
# OPENAI_API_KEY=sk-test-key（开发环境测试用）
# OPENAI_MODEL=gpt-4-turbo-preview

# =============================================================================
# =============================================================================

# 可选：live eval 使用真实 provider 时再在 .env.local / .env.development.local 覆盖

