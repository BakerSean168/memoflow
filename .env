# MemoFlow 共享基础配置
# =============================================================================
# 此文件仅包含所有环境都稳定不变的共享默认值
# ⚠️  由于当前 Nx 环境加载优先级问题，根 .env 中不要放会因环境变化而变化的变量
# ⚠️  例如：DATABASE_URL、REDIS_URL、CORS_ORIGIN、JWT_SECRET、VITE_ENABLE_MOCK_API 等
# 这些变量应放到 .env.development / .env.test / .env.production / .env.staging
# =============================================================================

# 时区
TZ=Asia/Shanghai

# JWT 过期时间（默认值）
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# 文件上传限制（10MB）
UPLOAD_MAX_SIZE=10485760

# 功能开关默认值
ENABLE_DAILY_ANALYSIS=true
USE_PRIORITY_QUEUE_SCHEDULER=true

# Merged from apps/web/.env（环境无关配置）
VITE_APP_NAME=MemoFlow Web

# Merged from packages/governance/.env
GOVERNANCE_DATABASE_URL="file:./governance.db"
