{
  "name": "memoflow",
  "$schema": "node_modules/nx/schemas/project-schema.json",
  "tags": [
    "scope:meta",
    "type:meta"
  ],
  "targets": {
    "docs-check": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/AGENT.md",
        "{workspaceRoot}/AGENTS.md",
        "{workspaceRoot}/CLAUDE.md",
        "{workspaceRoot}/README.md",
        "{workspaceRoot}/docs/**/*",
        "{workspaceRoot}/.github/copilot-instructions.md",
        "{workspaceRoot}/.github/GITFLOW*.md",
        "{workspaceRoot}/.github/prompts/*.md",
        "{workspaceRoot}/nx.json",
        "{workspaceRoot}/eslint.config.ts",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/project.json",
        "{workspaceRoot}/tools/test/hard-7101-failure-matrix.json",
        "{workspaceRoot}/tools/test/hard-7101-failure-matrix.mjs",
        "{workspaceRoot}/product.identity.json",
        "{workspaceRoot}/tools/docs/check-docs-config.mjs"
      ],
      "options": {
        "command": "node ./tools/docs/check-docs-config.mjs"
      }
    },
    "target-baseline-check": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/apps/**/project.json",
        "{workspaceRoot}/packages/**/project.json",
        "{workspaceRoot}/tools/**/project.json",
        "{workspaceRoot}/project.json",
        "{workspaceRoot}/tools/governance/target-baseline-manifest.json",
        "{workspaceRoot}/tools/governance/target-baseline-audit.mjs"
      ],
      "options": {
        "command": "node ./tools/governance/target-baseline-audit.mjs"
      }
    },
    "governance-check": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": [
        "test:governance",
        "governance-tools:test",
        "test-system-v2:test",
        "test-system-v2:test:governance",
        "test-system-v2:ruleset"
      ],
      "inputs": [
        "{workspaceRoot}/AGENT.md",
        "{workspaceRoot}/AGENTS.md",
        "{workspaceRoot}/CLAUDE.md",
        "{workspaceRoot}/README.md",
        "{workspaceRoot}/docs/**/*",
        "{workspaceRoot}/.github/copilot-instructions.md",
        "{workspaceRoot}/.github/GITFLOW*.md",
        "{workspaceRoot}/.github/prompts/*.md",
        "{workspaceRoot}/apps/**/project.json",
        "{workspaceRoot}/packages/**/project.json",
        "{workspaceRoot}/tools/**/project.json",
        "{workspaceRoot}/**/eslint.config.*",
        "{workspaceRoot}/nx.json",
        "{workspaceRoot}/eslint.config.ts",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/project.json",
        "{workspaceRoot}/product.identity.json",
        "{workspaceRoot}/tools/docs/check-docs-config.mjs",
        "{workspaceRoot}/tools/governance/apply-product-identity.mjs",
        "{workspaceRoot}/tools/governance/product-identity-audit.mjs",
        "{workspaceRoot}/tools/governance/product-identity.schema.json",
        "{workspaceRoot}/tools/governance/file-naming-audit.mjs",
        "{workspaceRoot}/tools/governance/failure-contract-inventory-audit.mjs",
        "{workspaceRoot}/tools/governance/failure-contract-baseline.json",
        "{workspaceRoot}/tools/governance/target-baseline-manifest.json",
        "{workspaceRoot}/tools/governance/target-baseline-audit.mjs",
        "{workspaceRoot}/tools/governance/governance-module-docs-audit.mjs",
        "{workspaceRoot}/tools/governance/platform-leakage-audit.mjs",
        "{workspaceRoot}/tools/governance/singleton-audit.mjs",
        "{workspaceRoot}/tools/governance/desktop-runtime-locator-audit.mjs",
        "{workspaceRoot}/tools/governance/vitest-no-tests-audit.mjs",
        "{workspaceRoot}/tools/governance/server-feature-shape-audit.mjs",
        "{workspaceRoot}/tools/governance/package-internal-boundary-audit.mjs",
        "{workspaceRoot}/tools/governance/package-export-audit.mjs",
        "{workspaceRoot}/tools/governance/public-surface-audit.mjs",
        "{workspaceRoot}/tools/governance/raw-event-bus-audit.mjs",
        "{workspaceRoot}/tools/governance/mitt-rpc-forbidden-audit.mjs",
        "{workspaceRoot}/tools/governance/schedule-notification-separation-audit.mjs",
        "{workspaceRoot}/tools/governance/core-vnext-architecture-lock-audit.mjs",
        "{workspaceRoot}/tools/governance/__tests__/core-vnext-architecture-lock.test.mjs",
        "{workspaceRoot}/tools/governance/unflushed-events-audit.mjs",
        "{workspaceRoot}/tools/governance/scope-constraint-audit.mjs",
        "{workspaceRoot}/tools/governance/reka-ui-primitive-audit.mjs",
        "{workspaceRoot}/tools/governance/date-fns-import-audit.mjs",
        "{workspaceRoot}/tools/governance/api-runtime-dependency-audit.mjs",
        "{workspaceRoot}/tools/governance/time-registry.json",
        "{workspaceRoot}/tools/governance/lib/**/*.mjs",
        "{workspaceRoot}/apps/**/src/**/*",
        "{workspaceRoot}/packages/**/src/**/*",
        "{workspaceRoot}/tools/governance/architecture-surface-audit.mjs",
        "{workspaceRoot}/tools/governance/architecture-surface-manifest.json",
        "{workspaceRoot}/tools/governance/public-surface-jsdoc-audit.mjs",
        "{workspaceRoot}/.github/workflows/**/*",
        "{workspaceRoot}/.github/actions/**/*",
        "{workspaceRoot}/tools/governance/github-action-pinning-audit.mjs",
        "{workspaceRoot}/tools/governance/vnext-retirement-manifest.json",
        "{workspaceRoot}/tools/governance/vnext-retirement-audit.mjs",
        "{workspaceRoot}/tools/governance/__tests__/vnext-retirement.test.mjs"
      ],
      "options": {
        "command": "node ./tools/docs/check-docs-config.mjs && node ./tools/test/hard-7101-failure-matrix.mjs --check && node ./tools/governance/product-identity-audit.mjs && node ./tools/governance/target-baseline-audit.mjs && node ./tools/governance/file-naming-audit.mjs && node ./tools/governance/github-action-pinning-audit.mjs && node ./tools/governance/failure-contract-inventory-audit.mjs && node ./tools/governance/governance-module-docs-audit.mjs && node ./tools/governance/platform-leakage-audit.mjs && node ./tools/governance/singleton-audit.mjs && node ./tools/governance/desktop-runtime-locator-audit.mjs && node ./tools/governance/vitest-no-tests-audit.mjs && node ./tools/governance/server-feature-shape-audit.mjs && node ./tools/governance/package-internal-boundary-audit.mjs && node ./tools/governance/package-export-audit.mjs && node ./tools/governance/public-surface-audit.mjs && node ./tools/governance/raw-event-bus-audit.mjs && node ./tools/governance/mitt-rpc-forbidden-audit.mjs && node ./tools/governance/schedule-notification-separation-audit.mjs && node ./tools/governance/core-vnext-architecture-lock-audit.mjs && node ./tools/governance/vnext-retirement-audit.mjs && node ./tools/governance/unflushed-events-audit.mjs && node ./tools/governance/scope-constraint-audit.mjs && node ./tools/governance/reka-ui-primitive-audit.mjs && node ./tools/governance/accessible-interaction-audit.mjs && node ./tools/governance/date-fns-import-audit.mjs && node ./tools/governance/architecture-surface-audit.mjs && node ./tools/governance/public-surface-jsdoc-audit.mjs && node ./tools/governance/api-runtime-dependency-audit.mjs"
      }
    },
    "test:governance": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/tools/agent-skills/validate-local-deploy/scripts/image-freshness.spec.mjs",
        "{workspaceRoot}/tools/docker/local-compose.env-shadow.spec.mjs",
        "{workspaceRoot}/tools/runtime/load-profiles.spec.mjs"
      ],
      "options": {
        "command": "node --test tools/agent-skills/validate-local-deploy/scripts/image-freshness.spec.mjs tools/docker/local-compose.env-shadow.spec.mjs tools/runtime/load-profiles.spec.mjs"
      }
    },
    "local-registry": {
      "executor": "@nx/js:verdaccio",
      "options": {
        "port": 4873,
        "config": ".verdaccio/config.yml",
        "storage": "tmp/local-registry/storage"
      }
    },
    "test:failure-matrix:check": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/tools/test/hard-7101-failure-matrix.json",
        "{workspaceRoot}/tools/test/hard-7101-failure-matrix.mjs",
        "{workspaceRoot}/apps/**/src/**/*",
        "{workspaceRoot}/apps/**/e2e/**/*",
        "{workspaceRoot}/packages/**/src/**/*"
      ],
      "options": {
        "command": "node ./tools/test/hard-7101-failure-matrix.mjs --check"
      }
    },
    "test:failure-matrix": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node ./tools/test/hard-7101-failure-matrix.mjs --run"
      }
    }
  }
}
