{
  "name": "@memoflow/test-utils",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/test-utils/src",
  "projectType": "library",
  "tags": [
    "scope:test-utils",
    "type:lib",
    "layer:testing"
  ],
  "targets": {
    "build": {
      "executor": "nx:noop",
      "outputs": [],
      "dependsOn": [],
