{
  "name": "@memoflow/test-utils",
  "version": "0.0.1",
  "type": "module",
  "description": "Unified testing utilities for MemoFlow monorepo",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./helpers": "./src/helpers/index.ts",
    "./helpers/*": "./src/helpers/*.ts",
    "./mocks": "./src/mocks/index.ts",
    "./fixtures": "./src/fixtures/index.ts",
    "./fixtures/*": "./src/fixtures/*.ts",
    "./setup": "./src/setup/database.ts",
    "./setup/*": "./src/setup/*.ts"
  },
  "dependencies": {
    "@memoflow/database": "workspace:*",
    "@memoflow/domain-shared": "workspace:*",
    "@vue/test-utils": "^2.5.1",
    "pg": "8.23.0",
    "pinia": "^4.0.3",
    "vitest": "4.1.11"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vue": "^3.5.43"
  }
}
