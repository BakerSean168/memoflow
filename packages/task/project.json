{
  "name": "task",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/task/src",
  "projectType": "library",
  "tags": [
    "scope:task",
    "type:lib",
    "layer:domain"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/dist"
      ],
      "dependsOn": [
        "^build"
      ],
      "options": {
        "command": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && node ../../node_modules/tsup/dist/cli-default.js --clean=false && tsc -p tsconfig.build.json --emitDeclarationOnly",
        "cwd": "packages/task"
      }
    },
    "lint": {
      "options": {
        "args": [
          "**/*.{ts,js}"
        ]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p tsconfig.json",
        "cwd": "packages/task"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "inputs": [
        "default",
        "^production"
      ],
      "cache": true,
      "options": {
        "command": "node ../../node_modules/vitest/vitest.mjs run --config vitest.config.ts",
        "cwd": "packages/task"
      }
    },
    "test:watch": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node ../../node_modules/vitest/vitest.mjs --config vitest.config.ts",
        "cwd": "packages/task"
      }
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "inputs": [
        "default",
        "^production"
      ],
      "cache": false,
      "options": {
        "command": "node ../../node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts",
        "cwd": "packages/task"
      }
    },
    "test:perf": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}-perf"
      ],
      "inputs": [
        "default",
        "^production"
      ],
      "cache": false,
      "options": {
        "command": "node ../../node_modules/vitest/vitest.mjs run --config vitest.performance.config.ts",
        "cwd": "packages/task"
      }
    },
    "test:perf:experiment": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node --expose-gc ../../node_modules/vitest/vitest.mjs run --config vitest.performance-experiment.config.ts --reporter=json --outputFile=../../reports/test-system-v2/performance-experiment.json",
        "cwd": "packages/task"
      }
    },
    "test:coverage": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "inputs": [
        "default",
        "^production"
      ],
      "cache": true,
      "options": {
        "commands": [
          {
            "command": "node ../../node_modules/vitest/vitest.mjs run --config vitest.config.ts --coverage",
            "forwardAllArgs": false
          },
          {
            "command": "node ../../node_modules/vitest/vitest.mjs run --config vitest.use-cases.config.ts --coverage",
            "forwardAllArgs": false
          },
          {
            "command": "node ../../node_modules/vitest/vitest.mjs run --config vitest.mappers.config.ts --coverage",
            "forwardAllArgs": false
          }
        ],
        "parallel": false,
        "cwd": "packages/task"
      }
    }
  }
}
