{
  "extends": "../../tsconfig.workspace-src.json",
  "compilerOptions": {
    "noEmit": true,
    "incremental": false,
    "lib": ["ES2020", "DOM"],
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts"]
}
