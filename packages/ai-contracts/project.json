{
  "name": "ai-contracts",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/ai-contracts/src",
  "tags": ["scope:shared", "type:lib", "layer:shared", "tier:core"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --build packages/ai-contracts/tsconfig.json"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/packages/ai-contracts/dist"],
      "cache": true,
      "options": {
        "command": "node ../../node_modules/tsup/dist/cli-default.js && tsc -p tsconfig.build.json",
        "cwd": "packages/ai-contracts"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node ../../node_modules/tsup/dist/cli-default.js --watch",
        "cwd": "packages/ai-contracts"
      }
    },
    "lint": {
      "options": {
        "args": ["**/*.{ts,js}"]
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "inputs": ["default", "^production"],
      "cache": true,
      "options": {
        "command": "node ../../node_modules/vitest/vitest.mjs run --config vitest.config.ts",
        "cwd": "packages/ai-contracts"
      }
    },
    "test:watch": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node ../../node_modules/vitest/vitest.mjs --config vitest.config.ts",
        "cwd": "packages/ai-contracts"
      }
    },
    "test:contract": {
      "executor": "nx:run-commands",
      "inputs": ["default", "^production"],
      "cache": true,
      "dependsOn": ["build"],
      "options": {
        "command": "node ../../node_modules/vitest/vitest.mjs run --config vitest.config.ts",
        "cwd": "packages/ai-contracts"
      }
    }
  }
}
