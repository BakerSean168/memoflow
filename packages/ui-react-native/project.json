{
  "name": "ui-react-native",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/ui-react-native/src",
  "tags": [
    "scope:ui",
    "type:lib",
    "type:react-native",
    "layer:ui"
  ],
  "targets": {
    "lint": {
      "options": {
        "args": [
          "**/*.{ts,tsx}"
        ]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p tsconfig.json",
        "cwd": "packages/ui-react-native"
      }
    }
  }
}
