{
  // 继承基础配置
  "extends": "../../tsconfig.workspace-src.json",

  "compilerOptions": {
    // ============================================================
    // 路径和输出配置
    // ============================================================

    "outDir": "./dist",

    // ============================================================
    // 纯 tsup 模式配置
    // ============================================================

    "noEmit": true,

    "incremental": false,

    // ============================================================
    // 库环境配置（Repository Contracts 包）
    // ============================================================

    "lib": ["ES2020"],
    "types": ["node"],

    // ============================================================
    // 本地路径别名配置
    // ============================================================

    "paths": {
      "@/*": ["./src/*"]
    }
  },

  "include": ["src"],

  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts"]
}
