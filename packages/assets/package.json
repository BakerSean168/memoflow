{
  "name": "@memoflow/assets",
  "version": "0.0.1",
  "description": "Shared static assets for MemoFlow applications (images, audio, fonts)",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./images": {
      "types": "./dist/images/index.d.ts",
      "import": "./dist/images/index.js"
    },
    "./audio": {
      "types": "./dist/audio/index.d.ts",
      "import": "./dist/audio/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "devDependencies": {
    "rimraf": "^6.0.1",
    "typescript": "~6.0.3",
    "vite": "8.3.0",
    "vite-plugin-dts": "5.0.3"
  },
  "keywords": [
    "assets",
    "static-resources",
    "monorepo"
  ],
  "author": "BakerSean168",
  "license": "MIT"
}
