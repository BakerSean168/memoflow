{
  "name": "app-react",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/app-react/src",
  "tags": [
    "scope:app-react",
    "type:lib",
    "type:react",
    "platform:mobile",
    "layer:ui"
  ],
  "targets": {
    "lint": {
      "options": {
        "args": [
          "**/*.{ts,tsx}"
        ]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p tsconfig.json",
        "cwd": "packages/app-react"
      }
    }
  }
}
