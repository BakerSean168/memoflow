{
  "name": "@memoflow/ui-core",
  "version": "0.0.1",
  "description": "Framework-agnostic headless UI logic for MemoFlow applications",
  "private": false,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles/globals.css": "./src/styles/globals.css",
    "./styles/theme.css": "./src/styles/theme.css"
  },
  "files": [
    "dist",
    "src/styles"
  ],
  "dependencies": {
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "rimraf": "^6.1.3",
    "tsup": "^8.0.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "4.1.11"
  }
}
