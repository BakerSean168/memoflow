{
  "extends": "../../tsconfig.workspace-src.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "composite": false,
    "incremental": false,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "@memoflow/goal-ui/host": ["../goal-ui/dist/goal-ui-host.d.ts"],
      "@memoflow/goal-ui": ["../goal-ui/dist/index.d.ts"],
      "@memoflow/goal-ui/composables/useGoal": ["../goal-ui/dist/composables/useGoal.d.ts"],
      "@memoflow/goal-ui/*": ["../goal-ui/dist/*.d.ts"],
      "@memoflow/notification-ui/host": ["../notification-ui/dist/notification-ui-host.d.ts"],
      "@memoflow/notification-ui": ["../notification-ui/dist/index.d.ts"],
      "@memoflow/setting-ui/host": ["../setting-ui/dist/setting-ui-host.d.ts"],
      "@memoflow/setting-ui": ["../setting-ui/dist/index.d.ts"],
      "@memoflow/contracts": ["../../packages/contracts/src/index.ts"],
      "@memoflow/contracts/account": ["../../packages/contracts/src/modules/account/index.ts"],
      "@memoflow/contracts/ai": ["../../packages/contracts/src/modules/ai/index.ts"],
      "@memoflow/goal-contracts": ["../../packages/goal-contracts/src/index.ts"],
      "@memoflow/notification-contracts": ["../../packages/notification-contracts/src/index.ts"],
      "@memoflow/notification-contracts/*": ["../../packages/notification-contracts/src/*.ts"],
      "@memoflow/contracts/primitives": ["../../packages/contracts/src/primitives/index.ts"],
      "@memoflow/contracts/repository": [
        "../../packages/contracts/src/modules/repository/index.ts"
      ],
      "@memoflow/contracts/result": ["../../packages/contracts/src/result/index.ts"],
      "@memoflow/schedule-contracts": ["../../packages/schedule-contracts/src/index.ts"],
      "@memoflow/schedule-contracts/*": ["../../packages/schedule-contracts/src/*.ts"],
      "@memoflow/setting-contracts": ["../../packages/setting-contracts/src/index.ts"],
      "@memoflow/setting-contracts/*": ["../../packages/setting-contracts/src/*.ts"],
      "@memoflow/desktop-contracts": ["../../packages/desktop-contracts/src/index.ts"],
      "@memoflow/desktop-contracts/*": ["../../packages/desktop-contracts/src/*.ts"],
      "@memoflow/contracts/shared": ["../../packages/contracts/src/shared/index.ts"],
      "@memoflow/contracts/task": ["../../packages/contracts/src/modules/task/index.ts"],
      "@memoflow/contracts/*": [
        "../../packages/contracts/src/modules/*/index.ts",
        "../../packages/contracts/src/*/index.ts"
      ],
      "@memoflow/assets": ["../../packages/assets/src/index.ts"],
      "@memoflow/assets/audio": ["../../packages/assets/src/audio/index.ts"],
      "@memoflow/assets/images": ["../../packages/assets/src/images/index.ts"],
      "@memoflow/ui-vue-shadcn": ["../../packages/ui-vue-shadcn/dist/index.d.ts"],
      "@memoflow/ui-vue-shadcn/components/ui/*": [
        "../../packages/ui-vue-shadcn/dist/components/ui/*/index.d.ts"
      ],
      "@memoflow/ui-vue-shadcn/composables/*": [
        "../../packages/ui-vue-shadcn/dist/composables/*.d.ts"
      ],
      "@memoflow/ui-vue-shadcn/*": ["../../packages/ui-vue-shadcn/dist/*"],
      "@memoflow/http-client": ["../../packages/http-client/src/index.ts"],
      "@memoflow/ai/client": ["../../packages/ai/dist/client/index.d.ts"],
      "@memoflow/goal-client": ["../../packages/goal-client/dist/index.d.ts"],
      "@memoflow/schedule-client": ["../../packages/schedule-client/dist/index.d.ts"],
      "@memoflow/notification-client": ["../../packages/notification-client/dist/index.d.ts"],
      "@memoflow/setting-client": ["../../packages/setting-client/dist/index.d.ts"],
      "@memoflow/routine-client": ["../../packages/routine-client/dist/index.d.ts"],
      "@memoflow/task/client": ["../../packages/task/dist/client/index.d.ts"],
      "@memoflow/repository/client": ["../../packages/repository/dist/client/index.d.ts"],
      "@memoflow/test-utils": ["../../packages/test-utils/src/index.ts"],
      "@memoflow/test-utils/*": [
        "../../packages/test-utils/src/*",
        "../../packages/test-utils/src/*.ts"
      ]
    }
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "src/test",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/*.stories.ts",
    "**/*.test.tsx",
    "**/*.spec.tsx"
  ]
}
