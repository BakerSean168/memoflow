{
  "extends": "../../tsconfig.workspace-src.json",
  "compilerOptions": {
    "baseUrl": ".",
    "declaration": true,
    "declarationMap": true,
    "composite": false,
    "incremental": false,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node",
      "vite/client"
    ],
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@memoflow/contracts": [
        "../../packages/contracts/src/index.ts"
      ],
      "@memoflow/contracts/account": [
        "../../packages/contracts/src/modules/account/index.ts"
      ],
      "@memoflow/contracts/ai": [
        "../../packages/contracts/src/modules/ai/index.ts"
      ],
      "@memoflow/contracts/goal": [
        "../../packages/contracts/src/modules/goal/index.ts"
      ],
      "@memoflow/contracts/notification": [
        "../../packages/contracts/src/modules/notification/index.ts"
      ],
      "@memoflow/contracts/primitives": [
        "../../packages/contracts/src/primitives/index.ts"
      ],
      "@memoflow/contracts/repository": [
        "../../packages/contracts/src/modules/repository/index.ts"
      ],
      "@memoflow/contracts/result": [
        "../../packages/contracts/src/result/index.ts"
      ],
      "@memoflow/contracts/schedule": [
        "../../packages/contracts/src/modules/schedule/index.ts"
      ],
      "@memoflow/contracts/setting": [
        "../../packages/contracts/src/modules/setting/index.ts"
      ],
      "@memoflow/contracts/shared": [
        "../../packages/contracts/src/shared/index.ts"
      ],
      "@memoflow/contracts/task": [
        "../../packages/contracts/src/modules/task/index.ts"
      ],
      "@memoflow/contracts/*": [
        "../../packages/contracts/src/modules/*/index.ts",
        "../../packages/contracts/src/*/index.ts"
      ],
      "@memoflow/assets": [
        "../../packages/assets/src/index.ts"
      ],
      "@memoflow/assets/audio": [
        "../../packages/assets/src/audio/index.ts"
      ],
      "@memoflow/assets/images": [
        "../../packages/assets/src/images/index.ts"
      ],
      "@memoflow/ui-vue-shadcn": [
        "../../packages/ui-vue-shadcn/dist/index.d.ts"
      ],
      "@memoflow/ui-vue-shadcn/components/ui/*": [
        "../../packages/ui-vue-shadcn/dist/components/ui/*/index.d.ts"
      ],
      "@memoflow/ui-vue-shadcn/composables/*": [
        "../../packages/ui-vue-shadcn/dist/composables/*.d.ts"
      ],
      "@memoflow/ui-vue-shadcn/*": [
        "../../packages/ui-vue-shadcn/dist/*"
      ],
      "@memoflow/http-client": [
        "../../packages/http-client/src/index.ts"
      ],
      "@memoflow/ai/client": [
        "../../packages/ai/dist/client/index.d.ts"
      ],
      "@memoflow/goal/client": [
        "../../packages/goal/dist/client/index.d.ts"
      ],
      "@memoflow/schedule/client": [
        "../../packages/schedule/dist/client/index.d.ts"
      ],
      "@memoflow/notification/client": [
        "../../packages/notification/dist/client/index.d.ts"
      ],
      "@memoflow/reminder/client": [
        "../../packages/reminder/dist/client/index.d.ts"
      ],
      "@memoflow/task/client": [
        "../../packages/task/dist/client/index.d.ts"
      ],
      "@memoflow/governance/client": [
        "../../packages/governance/dist/client/index.d.ts"
      ],
      "@memoflow/repository/client": [
        "../../packages/repository/dist/client/index.d.ts"
      ],
      "@memoflow/test-utils": [
        "../../packages/test-utils/src/index.ts"
      ],
      "@memoflow/test-utils/*": [
        "../../packages/test-utils/src/*",
        "../../packages/test-utils/src/*.ts"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/test",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/*.stories.ts",
    "**/*.test.tsx",
    "**/*.spec.tsx"
  ]
}
