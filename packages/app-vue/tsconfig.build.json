{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@memoflow/goal-ui/host": ["../goal-ui/dist/goal-ui-host.d.ts"],
      "@memoflow/goal-ui": ["../goal-ui/dist/index.d.ts"],
      "@memoflow/goal-ui/composables/useGoal": ["../goal-ui/dist/composables/useGoal.d.ts"],
      "@memoflow/goal-ui/*": ["../goal-ui/dist/*.d.ts"],
      "@memoflow/notification-ui/host": ["../notification-ui/dist/notification-ui-host.d.ts"],
      "@memoflow/notification-ui": ["../notification-ui/dist/index.d.ts"],
      "@memoflow/setting-ui/host": ["../setting-ui/dist/setting-ui-host.d.ts"],
      "@memoflow/setting-ui": ["../setting-ui/dist/index.d.ts"],
      "@memoflow/contracts": ["../contracts/dist/index.d.ts"],
      "@memoflow/contracts/*": [
        "../contracts/dist/modules/*/index.d.ts",
        "../contracts/dist/*/index.d.ts"
      ],
      "@memoflow/assets": ["../assets/dist/index.d.ts"],
      "@memoflow/assets/*": ["../assets/dist/*/index.d.ts"],
      "@memoflow/ui-vue-shadcn": ["../ui-vue-shadcn/dist/index.d.ts"],
      "@memoflow/ui-vue-shadcn/components/ui/*": [
        "../ui-vue-shadcn/dist/components/ui/*/index.d.ts"
      ],
      "@memoflow/ui-vue-shadcn/composables/*": ["../ui-vue-shadcn/dist/composables/*.d.ts"],
      "@memoflow/ui-vue-shadcn/*": ["../ui-vue-shadcn/dist/*"],
      "@memoflow/http-client": ["../http-client/dist/index.d.ts"],
      "@memoflow/ai/client": ["../ai/dist/client/index.d.ts"],
      "@memoflow/goal-client": ["../goal-client/dist/index.d.ts"],
      "@memoflow/schedule-client": ["../schedule-client/dist/index.d.ts"],
      "@memoflow/notification-client": ["../notification-client/dist/index.d.ts"],
      "@memoflow/setting-client": ["../setting-client/dist/index.d.ts"],
      "@memoflow/desktop-contracts": ["../desktop-contracts/dist/index.d.ts"],
      "@memoflow/desktop-contracts/*": ["../desktop-contracts/dist/*.d.ts"],
      "@memoflow/reminder/client": ["../reminder/dist/client/index.d.ts"],
      "@memoflow/task/client": ["../task/dist/client/index.d.ts"],
      "@memoflow/repository/client": ["../repository/dist/client/index.d.ts"]
    }
  }
}
