{
  "name": "app-vue",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/app-vue/src",
  "tags": [
    "scope:app-vue",
    "type:lib",
    "type:vue",
    "layer:ui"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/packages/app-vue/dist"
      ],
      "dependsOn": [
        "^build"
      ],
      "options": {
        "command": "node ../../node_modules/vite/bin/vite.js build",
        "cwd": "packages/app-vue"
      }
    },
    "lint": {
      "options": {
        "args": [
          "**/*.{ts,tsx,vue}"
        ]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "^build"
      ],
      "options": {
        "command": "node ../../node_modules/vue-tsc/bin/vue-tsc.js --noEmit --declaration false --declarationMap false -p tsconfig.json",
        "cwd": "packages/app-vue"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "inputs": [
        "default",
        "^production"
      ],
      "cache": true,
      "options": {
        "command": "node ../../node_modules/vitest/vitest.mjs run --config vitest.config.ts",
        "cwd": "packages/app-vue"
      }
    },
    "test:package-exports": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "options": {
        "command": "node scripts/verify-package-exports.mjs",
        "cwd": "packages/app-vue"
      }
    },
    "test:watch": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node ../../node_modules/vitest/vitest.mjs --config vitest.config.ts",
        "cwd": "packages/app-vue"
      }
    },
    "test:coverage": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "inputs": [
        "default",
        "^production"
      ],
      "cache": true,
      "options": {
        "command": "vitest run --config vitest.store-coverage.config.ts --coverage",
        "cwd": "packages/app-vue"
      }
    }
  }
}
