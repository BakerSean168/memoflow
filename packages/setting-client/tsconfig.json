{
  "extends": "../../tsconfig.workspace-src.json",
  "compilerOptions": {
    "lib": ["ES2020"],
    "types": ["node", "vitest/globals"],
    "paths": {
      "@/*": ["./src/*"],
      "@memoflow/desktop-contracts": ["../desktop-contracts/src/index.ts"],
      "@memoflow/desktop-contracts/*": ["../desktop-contracts/src/*.ts"],
      "@memoflow/http-client": ["../http-client/src/index.ts"],
      "@memoflow/ipc-client": ["../ipc-client/src/index.ts"],
      "@memoflow/setting-contracts": ["../setting-contracts/src/index.ts"],
      "@memoflow/setting-contracts/*": ["../setting-contracts/src/*.ts"],
      "@memoflow/transport-contracts": ["../transport-contracts/src/index.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts"]
}
