{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@memoflow/goal-contracts": ["../goal-contracts/dist/index.d.ts"],
      "@memoflow/schedule-contracts": ["../schedule-contracts/dist/index.d.ts"],
      "@memoflow/schedule-contracts/*": ["../schedule-contracts/dist/*.d.ts"],
      "@memoflow/schedule-client": ["../schedule-client/dist/index.d.ts"],
      "@memoflow/http-client": ["../http-client/dist/index.d.ts"],
      "@memoflow/time": ["../time/dist/index.d.ts"],
      "@memoflow/ui-vue-shadcn": ["../ui-vue-shadcn/dist/index.d.ts"],
