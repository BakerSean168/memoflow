// ==========================================
// Notification Module
// 通知 Fact、Inbox、交互与投递执行
// ==========================================

model Notification {
  id                String    @id
  identityId        String    @map("identity_id")
  type              String
  category          String
  workflowKey       String    @map("workflow_key")
  topic             String
  idempotencyKey    String    @map("idempotency_key")
  title             String
  content           String
  importance        String
  urgency           String
  relatedEntityType String?   @map("related_entity_type")
  relatedEntityId   String?   @map("related_entity_id")
  metadata          String?
  actions           String?
  navigationIntent  String?   @map("navigation_intent")
  correlationId     String?   @map("correlation_id")
  causationId       String?   @map("causation_id")
  readAt            DateTime? @map("read_at")
  expiresAt         DateTime? @map("expires_at")
  version           Int       @default(1)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")
  archivedAt        DateTime? @map("archived_at")
  isRead            Boolean   @default(false) @map("is_read")

  history  NotificationHistory[]
  dispatchOutboxes NotificationDispatchOutbox[]
  deliveryDecisions NotificationDeliveryDecisionRecord[]
  account  Account               @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@unique([identityId, idempotencyKey])
  @@index([identityId, workflowKey])
  @@index([identityId, archivedAt, createdAt])
  @@map("notifications")
}

model NotificationHistory {
  id             String   @id
  identityId     String   @map("identity_id")
  notificationId String   @map("notification_id")
  action         String
  details        String?
  actorId        String?  @map("actor_id")
  createdAt      DateTime @default(now()) @map("created_at")

  identity     Account      @relation("AccountNotificationHistory", fields: [identityId], references: [id])
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([identityId])
  @@index([notificationId])
  @@map("notification_history")
}

model NotificationDeliveryDecisionRecord {
  id               String    @id
  identityId       String    @map("identity_id")
  notificationId   String    @map("notification_id")
  channel          String
  outcome          String
  reason           String
  preferenceSource String?   @map("preference_source")
  retryAt          DateTime? @map("retry_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel])
  @@index([identityId])
  @@map("notification_delivery_decisions")
}

model NotificationPreference {
  id           String    @id
  identityId   String    @unique @map("identity_id")
  globalChannels    String    @default("{}") @map("global_channels")
  workflowOverrides String    @default("{}") @map("workflow_overrides")
  doNotDisturb String?   @map("do_not_disturb")
  rateLimit    String?   @map("rate_limit")
  version      Int       @default(1)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  @@index([identityId])
  @@map("notification_preferences")
}

/// NotificationDispatchOutbox 投递意图/Outbox（W2: LeaseClaim 与 durable receipt）
model NotificationDispatchOutbox {
  id                  String    @id
  identityId          String    @map("identity_id")
  notificationId      String    @map("notification_id")
  source              String    @default("notification")
  occurrenceKey       String    @map("occurrence_key")
  channel             String
  payloadJson         String    @map("payload_json")
  idempotencyKey      String    @unique @map("idempotency_key")
  status              String
  attempt             Int       @default(0)
  ownerToken          String?   @map("owner_token")
  claimId             String?   @map("claim_id")
  fencingToken        Int       @default(0) @map("fencing_token")
  leaseExpiresAt      DateTime? @map("lease_expires_at")
  lastHeartbeatAt     DateTime? @map("last_heartbeat_at")
  heartbeatIntervalMs Int?      @map("heartbeat_interval_ms")
  lastError           String?   @map("last_error")
  nextRetryAt         DateTime? @map("next_retry_at")
  deadLetterAt        DateTime? @map("dead_letter_at")
  correlationId       String?   @map("correlation_id")
  causationId         String?   @map("causation_id")
  attemptsHistoryJson String?   @map("attempts_history_json")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  finishedAt          DateTime? @map("finished_at")

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  account      Account      @relation("AccountNotificationDispatchOutboxes", fields: [identityId], references: [id])

  @@index([identityId])
  @@index([status])
  @@index([leaseExpiresAt])
  @@map("notification_dispatch_outbox")
}

