model OauthAccessToken {
  id                      String             @id @default(uuid())
  token                   String
  clientId                String
  oauthclient             OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?
  cloudauthsession        CloudAuthSession?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String?
