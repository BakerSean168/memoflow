/// Short-lived, identity-bound GitHub App installation orchestration intent.
/// Only a SHA-256 hash of the provider state is persisted; no raw state or token is stored.
model KnowledgeRepositoryInstallationIntent {
  id                 String    @id
  identityId         String    @map("identity_id")
  stateHash          String    @unique @map("state_hash")
  routeKey           String    @map("route_key")
  clientKind         String    @map("client_kind")
  returnPath         String    @map("return_path")
  status             String    @default("Pending")
  installationId     String?   @map("installation_id")
  providerAccountId  String?   @map("provider_account_id")
  setupAction        String?   @map("setup_action")
  expiresAt          DateTime  @map("expires_at")
  callbackReceivedAt DateTime? @map("callback_received_at")
  finalizedAt        DateTime? @map("finalized_at")
  consumedAt         DateTime? @map("consumed_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  account Account @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId, status])
  @@index([installationId, status])
  @@index([expiresAt])
  @@map("knowledge_repository_installation_intents")
}

/// Stable logical knowledge space shared by local/remote bindings.
model KnowledgeSpace {
  id        String   @id
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  remoteBindings     KnowledgeRemoteBinding[]
  documentIdentities KnowledgeDocumentIdentity[]

  @@map("knowledge_spaces")
}

/// ADR-090 durable identity registry. `id` is a technical row key; the product key is
/// `(knowledgeSpaceId, knowledgeDocumentId)` and the external identity is carried by Markdown.
model KnowledgeDocumentIdentity {
  id                  String   @id @default(uuid())
  knowledgeSpaceId    String   @map("knowledge_space_id")
  knowledgeDocumentId String   @map("knowledge_document_id")
  origin              String
  originRequestId     String?  @map("origin_request_id")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  knowledgeSpace KnowledgeSpace @relation(fields: [knowledgeSpaceId], references: [id], onDelete: Cascade)

  @@unique([knowledgeSpaceId, knowledgeDocumentId])
  @@index([knowledgeSpaceId])
  @@map("knowledge_document_identities")
}

/// ADR-089 durable user choice: one GitHub repository is bound to a KnowledgeSpace.
/// Provider health, sync history safety and projection state live in separate models.
model KnowledgeRemoteBinding {
  id                         String    @id
  knowledgeSpaceId           String    @map("knowledge_space_id")
  identityId                 String    @map("identity_id")
  provider                   String    @default("GitHub")
  installationId             String    @map("installation_id")
  repositoryId               String    @map("repository_id")
  repositoryFullNameSnapshot String    @map("repository_full_name_snapshot")
  connectedAt                DateTime  @map("connected_at")
  disconnectedAt             DateTime? @map("disconnected_at")
  version                    Int       @default(1)

  knowledgeSpace          KnowledgeSpace                    @relation(fields: [knowledgeSpaceId], references: [id], onDelete: Cascade)
  account                 Account                           @relation(fields: [identityId], references: [id], onDelete: Cascade)
  observation             RemoteRepositoryObservation?
  historyFence            RemoteHistoryFence?
  projectionCheckpoint    KnowledgeProjectionCheckpoint?
  webhookDeliveries       GithubWebhookDelivery[]
  noteProjections         KnowledgeNoteProjection[]
  attachmentProjections   KnowledgeAttachmentProjection[]
  attachmentContentCaches KnowledgeAttachmentContentCache[]
  writeRequests           KnowledgeWriteRequest[]

  @@unique([identityId, repositoryId])
  @@unique([repositoryId])
  @@index([identityId, disconnectedAt])
  @@index([knowledgeSpaceId, disconnectedAt])
  @@index([installationId])
  @@map("knowledge_remote_bindings")
}

/// Latest provider observation. Provider loss never disconnects the durable binding.
model RemoteRepositoryObservation {
  bindingId             String   @id @map("binding_id")
  observedAt            DateTime @map("observed_at")
  accountId             String   @map("account_id")
  repositoryFullName    String   @map("repository_full_name")
  defaultBranch         String   @map("default_branch")
  isPrivate             Boolean  @map("is_private")
  archived              Boolean
  disabled              Boolean
  contentsPermission    String   @map("contents_permission")
  installationSuspended Boolean  @map("installation_suspended")
  eligibilityState      String   @map("eligibility_state")
  blockReason           String?  @map("block_reason")

  binding KnowledgeRemoteBinding @relation(fields: [bindingId], references: [id], onDelete: Cascade)

  @@index([eligibilityState])
  @@map("remote_repository_observations")
}

/// Remote Git history safety cursor confirmed by the Desktop Git runtime + server preflight.
model RemoteHistoryFence {
  bindingId                  String   @id @map("binding_id")
  defaultBranch              String   @map("default_branch")
  lastConfirmedRemoteHeadSha String   @map("last_confirmed_remote_head_sha")
  confirmedAt                DateTime @map("confirmed_at")

  binding KnowledgeRemoteBinding @relation(fields: [bindingId], references: [id], onDelete: Cascade)

  @@map("remote_history_fences")
}

/// Server projection cursor/failure axis, independent from binding/provider state.
model KnowledgeProjectionCheckpoint {
  bindingId          String    @id @map("binding_id")
  branch             String
  projectedCommitSha String?   @map("projected_commit_sha")
  state              String
  failureCode        String?   @map("failure_code")
  failureMessage     String?   @map("failure_message")
  lastAttemptAt      DateTime? @map("last_attempt_at")
  projectedAt        DateTime? @map("projected_at")

  binding KnowledgeRemoteBinding @relation(fields: [bindingId], references: [id], onDelete: Cascade)

  @@index([state])
  @@map("knowledge_projection_checkpoints")
}

/// Deduplication and processing cursor for GitHub webhook deliveries.
model GithubWebhookDelivery {
  id           String    @id
  bindingId    String    @map("binding_id")
  deliveryId   String    @unique @map("delivery_id")
  eventName    String    @map("event_name")
  beforeSha    String?   @map("before_sha")
  afterSha     String?   @map("after_sha")
  forced       Boolean   @default(false)
  status       String    @default("RECEIVED")
  errorMessage String?   @map("error_message")
  receivedAt   DateTime  @default(now()) @map("received_at")
  processedAt  DateTime? @map("processed_at")

  binding KnowledgeRemoteBinding @relation(fields: [bindingId], references: [id], onDelete: Cascade)

  @@index([bindingId, status])
  @@map("github_webhook_deliveries")
}

/// Rebuildable read model derived only from the connected repository default branch.
model KnowledgeNoteProjection {
  id                  String    @id
  bindingId           String    @map("binding_id")
  knowledgeDocumentId String?   @map("knowledge_document_id")
  relativePath        String    @map("relative_path")
  commitSha           String    @map("commit_sha")
  blobSha             String    @map("blob_sha")
  contentHash         String    @map("content_hash")
  frontmatter         Json      @default("{}")
  markdownContent     String    @map("markdown_content") @db.Text
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")

  binding KnowledgeRemoteBinding @relation(fields: [bindingId], references: [id], onDelete: Cascade)

  @@unique([bindingId, relativePath])
  @@index([bindingId, commitSha])
  @@index([knowledgeDocumentId])
  @@index([contentHash])
  @@map("knowledge_note_projections")
}

model KnowledgeAttachmentProjection {
  id           String    @id
  bindingId    String    @map("binding_id")
  relativePath String    @map("relative_path")
  commitSha    String    @map("commit_sha")
  blobSha      String    @map("blob_sha")
  byteSize     Int?      @map("byte_size")
  mediaType    String    @map("media_type")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  binding KnowledgeRemoteBinding @relation(fields: [bindingId], references: [id], onDelete: Cascade)

  @@unique([bindingId, relativePath])
  @@index([bindingId, commitSha])
  @@index([blobSha])
  @@map("knowledge_attachment_projections")
}

/// Short-lived shared cache for immutable GitHub attachment bytes.
model KnowledgeAttachmentContentCache {
  bindingId    String   @map("binding_id")
  blobSha      String   @map("blob_sha")
  byteSize     Int      @map("byte_size")
  contentBytes Bytes    @map("content_bytes")
  cachedAt     DateTime @default(now()) @map("cached_at")
  expiresAt    DateTime @map("expires_at")

  binding KnowledgeRemoteBinding @relation(fields: [bindingId], references: [id], onDelete: Cascade)

  @@id([bindingId, blobSha])
  @@index([expiresAt])
  @@map("knowledge_attachment_content_cache")
}

/// Idempotency ledger for confirmed Web note creation requests.
/// The Git commit state (`status`/`commitSha`) and the projection operation
/// state (`projectionStatus`/`projectionError*`/`projectedAt`) are tracked
/// separately so a Committed note whose projection is pending/failed stays
/// visible and replayable instead of being conflated with the commit result.
model KnowledgeWriteRequest {
  id                     String    @id
  identityId             String    @map("identity_id")
  bindingId              String    @map("binding_id")
  knowledgeDocumentId    String    @map("knowledge_document_id")
  requestId              String    @map("request_id")
  requestHash            String    @map("request_hash")
  relativePath           String    @map("relative_path")
  status                 String    @default("PENDING")
  commitSha              String?   @map("commit_sha")
  errorCode              String?   @map("error_code")
  errorMessage           String?   @map("error_message")
  projectionStatus       String    @default("PENDING") @map("projection_status")
  projectionErrorCode    String?   @map("projection_error_code")
  projectionErrorMessage String?   @map("projection_error_message")
  projectionAttempts     Int       @default(0) @map("projection_attempts")
  projectedAt            DateTime? @map("projected_at")
  blobSha                String?   @map("blob_sha")
  markdownContent        String?   @map("markdown_content") @db.Text
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")
  completedAt            DateTime? @map("completed_at")

  account Account                @relation(fields: [identityId], references: [id], onDelete: Cascade)
  binding KnowledgeRemoteBinding @relation(fields: [bindingId], references: [id], onDelete: Cascade)

  @@unique([identityId, requestId])
  @@index([bindingId, status])
  @@index([knowledgeDocumentId])
  @@map("knowledge_write_requests")
}

/// Short-lived distributed worker ownership for rebuildable repository work.
model KnowledgeRepositoryLease {
  id         String   @id
  leaseKey   String   @unique @map("lease_key")
  ownerToken String   @map("owner_token")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([expiresAt])
  @@map("knowledge_repository_leases")
}
