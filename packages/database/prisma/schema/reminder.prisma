// ==========================================
// Reminder Module
// 提醒模板、实例、分组、历史、统计、响应
// ==========================================

model ReminderTemplate {
  id                 String    @id
  identityId         String    @map("identity_id")
  name               String
  description        String?
  type               String
  selfEnabled        Boolean   @map("self_enabled")
  status             String
  importanceLevel    String    @map("importance_level")
  tags               String
  color              String?
  icon               String?
  nextTriggerAt      DateTime? @map("next_trigger_at")
  version            Int       @default(1)
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")
  trigger            String
  recurrence         String?
  activeTime         String    @map("active_time")
  activeHours        String?   @map("active_hours")
  notificationConfig String    @map("notification_config")
  stats              String

  // Smart Frequency: Response Metrics
  clickRate          Float?    @map("click_rate")
  ignoreRate         Float?    @map("ignore_rate")
  avgResponseTime    Int?      @map("avg_response_time")
  snoozeCount        Int       @default(0) @map("snooze_count")
  effectivenessScore Float?    @map("effectiveness_score")
  sampleSize         Int       @default(0) @map("sample_size")
  lastAnalysisTime   DateTime? @map("last_analysis_time")

  // Smart Frequency: Frequency Adjustment
  originalInterval      Int?      @map("original_interval")
  adjustedInterval      Int?      @map("adjusted_interval")
  adjustmentReason      String?   @map("adjustment_reason")
  adjustmentTime        DateTime? @map("adjustment_time")
  isAutoAdjusted        Boolean   @default(false) @map("is_auto_adjusted")
  userConfirmed         Boolean   @default(false) @map("user_confirmed")
  smartFrequencyEnabled Boolean   @default(true) @map("smart_frequency_enabled")

  history     ReminderHistory[]
  instances   ReminderInstance[]
  responses   ReminderResponse[]
  occurrences ReminderOccurrence[]
  account     Account              @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("reminder_templates")
}

model ReminderGroup {
  id          String    @id
  identityId  String    @map("identity_id")
  name        String
  description String?
  color       String?
  icon        String?
  enabled     Boolean
  status      String
  order       Int
  stats       String
  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  account   Account            @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId])
  @@map("reminder_groups")
}

model ReminderInstance {
  id          String    @id
  templateId  String    @map("template_id")
  identityId  String    @map("identity_id")
  triggerAt   DateTime  @map("trigger_at")
  status      String
  result      String?
  processedAt DateTime? @map("processed_at")
  note        String?
  payload     String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  account  Account          @relation(fields: [identityId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  template ReminderTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([triggerAt])
  @@map("reminder_instances")
}

model ReminderHistory {
  id                  String   @id
  identityId          String   @map("identity_id")
  templateId          String   @map("template_id")
  triggeredAt         DateTime @map("triggered_at")
  result              String
  error               String?
  notificationSent    Boolean  @map("notification_sent")
  notificationChannel String?
  createdAt           DateTime @default(now()) @map("created_at")

  identity Account          @relation("AccountReminderHistory", fields: [identityId], references: [id])
  template ReminderTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([identityId])
  @@index([templateId])
  @@map("reminder_history")
}

model ReminderStatistic {
  id            String   @id
  identityId    String   @unique @map("identity_id")
  templateStats String   @map("template_stats")
  groupStats    String   @map("group_stats")
  triggerStats  String   @map("trigger_stats")
  calculatedAt  DateTime @map("calculated_at")

  account Account @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId])
  @@map("reminder_statistics")
}

model ReminderResponse {
  id           String   @id @default(uuid())
  identityId   String   @map("identity_id")
  templateId   String   @map("template_id")
  action       String // clicked, ignored, snoozed, dismissed, completed
  responseTime Int?     @map("response_time") // seconds
  timestamp    DateTime
  createdAt    DateTime @default(now()) @map("created_at")

  identity Account          @relation("AccountReminderResponses", fields: [identityId], references: [id])
  template ReminderTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([identityId])
  @@index([templateId, timestamp(sort: Desc)])
  @@map("reminder_responses")
}

/// UserReminderPreference 聚合根 - 用户提醒偏好
/// 存储用户的最佳/最差响应时间段和智能频率配置
model UserReminderPreference {
  // ============ 主键与外键 ============
  id         String @id
  identityId String @unique @map("identity_id")

  // ============ 时间段偏好 ============
  bestTimeSlots  String @map("best_time_slots") /// JSON: TimeSlotDTO[]
  worstTimeSlots String @map("worst_time_slots") /// JSON: TimeSlotDTO[]

  // ============ 智能频率 ============
  globalReminderEnabled Boolean @default(true) @map("global_reminder_enabled")
  globalSmartFrequency  Boolean @default(true) @map("global_smart_frequency")

  // ============ 审计 ============
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // ============ 关系映射 ============
  account Account @relation(fields: [identityId], references: [id], onDelete: Cascade)

  // ============ 索引优化 ============
  @@index([identityId])
  @@map("user_reminder_preferences")
}

/// ReminderOccurrence 触发实例/投递意图（W1: LeaseClaim 与 durable receipt）
model ReminderOccurrence {
  id                  String    @id
  identityId          String    @map("identity_id")
  templateId          String    @map("template_id")
  source              String    @default("reminder")
  occurrenceKey       String    @map("occurrence_key")
  idempotencyKey      String    @unique @map("idempotency_key")
  status              String
  attempt             Int       @default(0)
  ownerToken          String?   @map("owner_token")
  claimId             String?   @map("claim_id")
  fencingToken        Int       @default(0) @map("fencing_token")
  leaseExpiresAt      DateTime? @map("lease_expires_at")
  lastHeartbeatAt     DateTime? @map("last_heartbeat_at")
  heartbeatIntervalMs Int?      @map("heartbeat_interval_ms")
  lastError           String?   @map("last_error")
  nextRetryAt         DateTime? @map("next_retry_at")
  deadLetterAt        DateTime? @map("dead_letter_at")
  correlationId       String?   @map("correlation_id")
  causationId         String?   @map("causation_id")
  attemptsHistoryJson String?   @map("attempts_history_json")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  finishedAt          DateTime? @map("finished_at")

  template ReminderTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  account  Account          @relation("AccountReminderOccurrences", fields: [identityId], references: [id])

  @@unique([templateId, occurrenceKey])
  @@index([identityId])
  @@index([status])
  @@index([leaseExpiresAt])
  @@map("reminder_occurrences")
}

// ==========================================
// Routine Coach vNext — first-class domain truth
// Legacy Reminder runtime tables above remain for reliability/cutover.
// ==========================================

model RoutineDefinition {
  id          String   @id
  identityId  String   @map("identity_id")
  name        String
  description String?
  enabled     Boolean  @default(true)
  triggerJson String?  @map("trigger_json")
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  account     Account                    @relation(fields: [identityId], references: [id], onDelete: Cascade)
  memberships RoutineProfileMembership[]
  occurrences RoutineOccurrence[]
  temporaryOverride RoutineTemporaryOverride?

  @@unique([identityId, id])
  @@index([identityId, enabled])
  @@map("routine_definitions")
}

model RoutineProfile {
  id          String   @id
  identityId  String   @map("identity_id")
  name        String
  description String?
  enabled     Boolean  @default(true)
  active      Boolean  @default(false)
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  account     Account                    @relation(fields: [identityId], references: [id], onDelete: Cascade)
  memberships RoutineProfileMembership[]

  @@unique([identityId, id])
  @@index([identityId, enabled, active])
  @@map("routine_profiles")
}

model RoutineProfileMembership {
  identityId String   @map("identity_id")
  profileId  String   @map("profile_id")
  routineId  String   @map("routine_id")
  enabled    Boolean  @default(true)
  version    Int      @default(1)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  account Account           @relation(fields: [identityId], references: [id], onDelete: Cascade)
  profile RoutineProfile    @relation(fields: [profileId, identityId], references: [id, identityId], onDelete: Cascade)
  routine RoutineDefinition @relation(fields: [routineId, identityId], references: [id, identityId], onDelete: Cascade)

  @@id([identityId, profileId, routineId])
  @@index([identityId, routineId])
  @@index([identityId, profileId])
  @@map("routine_profile_memberships")
}

model RoutineProtocolDefinition {
  id             String   @id
  identityId     String   @map("identity_id")
  name           String
  definitionJson String   @map("definition_json")
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  account  Account                  @relation(fields: [identityId], references: [id], onDelete: Cascade)
  sessions RoutineProtocolSession[]

  @@unique([identityId, id])
  @@index([identityId, name])
  @@map("routine_protocol_definitions")
}

model RoutineProtocolSession {
  id                String    @id
  identityId        String    @map("identity_id")
  protocolId        String    @map("protocol_id")
  protocolVersion   Int       @map("protocol_version")
  status            String
  snapshotJson      String    @map("snapshot_json")
  terminationReason String?   @map("termination_reason")
  endedAt           DateTime? @map("ended_at")
  version           Int       @default(1)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  account  Account                   @relation(fields: [identityId], references: [id], onDelete: Cascade)
  protocol RoutineProtocolDefinition @relation(fields: [protocolId, identityId], references: [id, identityId], onDelete: Restrict)

  @@index([identityId, status])
  @@index([identityId, protocolId, createdAt])
  @@map("routine_protocol_sessions")
}

/// RoutineOccurrence durable occurrence fence for the ROUTINE-3401 wall-clock lane.
/// Mirrors the protected ReminderOccurrence lease-claim contract (ADR-059 §10)
/// keyed by the canonical occurrenceKey so crash/retry replay is idempotent.
model RoutineOccurrence {
  id               String    @id
  identityId       String    @map("identity_id")
  routineId        String    @map("routine_id")
  source           String    @default("routine")
  occurrenceKey    String    @map("occurrence_key")
  scheduledFor     DateTime  @map("scheduled_for")
  sourceRevision   String?   @map("source_revision")
  idempotencyKey   String    @unique @map("idempotency_key")
  status           String
  attempt          Int       @default(0)
  ownerToken       String?   @map("owner_token")
  claimId          String?   @map("claim_id")
  fencingToken     Int       @default(0) @map("fencing_token")
  leaseExpiresAt   DateTime? @map("lease_expires_at")
  lastError        String?   @map("last_error")
  nextRetryAt      DateTime? @map("next_retry_at")
  deadLetterAt     DateTime? @map("dead_letter_at")
  correlationId    String?   @map("correlation_id")
  causationId      String?   @map("causation_id")
  historyJson      String?   @map("history_json")
  nextOccurrenceAt DateTime? @map("next_occurrence_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  finishedAt       DateTime? @map("finished_at")

  routine RoutineDefinition @relation(fields: [routineId, identityId], references: [id, identityId], onDelete: Cascade)
  account Account           @relation("AccountRoutineOccurrences", fields: [identityId], references: [id])

  @@unique([identityId, routineId, occurrenceKey])
  @@index([identityId])
  @@index([status])
  @@index([leaseExpiresAt])
  @@map("routine_occurrences")
}

/// ROUTINE-3401 durable snooze/suppress state for the routine wall-clock lane.
/// Temporary override is runtime state kept separate from long-lived trigger
/// config so a snooze never rewrites `trigger_json` (ADR-059 §6). One row per
/// routine; the decoded payload uses the W2 trigger-parity codec.
model RoutineTemporaryOverride {
  identityId   String   @map("identity_id")
  routineId    String   @map("routine_id")
  overrideJson String   @map("override_json")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  routine RoutineDefinition @relation(fields: [routineId, identityId], references: [id, identityId], onDelete: Cascade)
  account Account           @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@id([identityId, routineId])
  @@unique([routineId, identityId])
  @@map("routine_temporary_overrides")
}
