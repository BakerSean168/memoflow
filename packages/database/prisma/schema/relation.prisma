// ==========================================
// Relation Module (R5)
// 跨模块 SubjectRef 关系：Note/Goal/Task/Habit/Wallet 双向连接
// ==========================================

model Relation {
  id           String   @id
  identityId   String   @map("identity_id")
  subjectType  String   @map("subject_type") /// note | goal | task | habit | wallet
  subjectId    String   @map("subject_id")
  relationType String   @map("relation_type") /// references | related | depends_on | contributes_to
  objectType   String   @map("object_type")
  objectId     String   @map("object_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  account Account @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@unique([identityId, subjectType, subjectId, relationType, objectType, objectId])
  @@index([identityId, objectType, objectId]) /// 反向查询
  @@map("relations")
}
