// ==========================================
// AI Module
// AI 对话 shell、执行记录、Provider 配置
// ==========================================

model AiConversation {
  id            String    @id
  identityId    String    @map("identity_id")
  name          String
  status        String // ACTIVE, ARCHIVED
  version       Int       @default(1)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  account  Account     @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId])
  @@index([status])
  @@index([createdAt])
  @@map("ai_conversations")
}


model AiExecutionRecord {
  id                   String   @id
  identityId           String   @map("identity_id")
  operation            String
  outcome              String
  conversationId       String?  @map("conversation_id")
  runId                String?  @map("run_id")
  requestId            String?  @map("request_id")
  traceId              String?  @map("trace_id")
  providerConnectionId String?  @map("provider_connection_id")
  modelId              String?  @map("model_id")
  errorCategory        String?  @map("error_category")
  safeError            String?  @map("safe_error") @db.Text
  estimatedCostUsd     Float?   @map("estimated_cost_usd")
  tokenUsage           String?  @map("token_usage")
  latencyMs            Int?     @map("latency_ms")
  createdAt            DateTime @default(now()) @map("created_at")
  completedAt          DateTime @default(now()) @map("completed_at")

  account Account @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId])
  @@index([operation])
  @@index([outcome])
  @@index([createdAt])
  @@index([identityId, conversationId, createdAt])
  @@index([identityId, runId, createdAt])
  @@map("ai_execution_records")
}


model AiProviderConfig {
  id              String    @id
  identityId      String    @map("identity_id")
  name            String // 配置名称
  providerDefinitionId String @map("provider_definition_id")
  baseUrl         String    @map("base_url") // API 基础地址
  credentialRef   String    @map("credential_ref") // Opaque SecretVault reference
  defaultModel    String?   @map("default_model")
  availableModels String    @default("[]") @map("available_models") // 可用模型列表 JSON
  isActive        Boolean   @default(true) @map("is_active")
  isDefault       Boolean   @default(false) @map("is_default")
  priority        Int       @default(100) // 优先级
  version         Int       @default(1)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  account Account @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@unique([identityId, name])
  @@index([identityId])
  @@index([isDefault])
  @@index([isActive])
  @@index([priority])
  @@map("ai_provider_configs")
}

model AiProviderOnboardingSession {
  id                  String    @id
  identityId          String    @map("identity_id")
  catalogId           String    @map("catalog_id")
  baseUrl             String    @map("base_url")
  targetProviderId    String?   @map("target_provider_id")
  credentialRef       String    @map("credential_ref")
  credentialStatus    String    @map("credential_status")
  discoveryStatus     String    @map("discovery_status")
  modelsJson          String    @default("[]") @map("models_json")
  verifiedModelIds    String    @default("[]") @map("verified_model_ids")
  expiresAt           DateTime  @map("expires_at")
  consumedAt          DateTime? @map("consumed_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  account Account @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId, expiresAt])
  @@index([identityId, targetProviderId, expiresAt])
  @@index([expiresAt])
  @@map("ai_provider_onboarding_sessions")
}

/**
 * Host-owned provider SecretVault storage. This table is deliberately not a
 * PowerSync table and has no relation to portable provider connection state.
 */
model AiProviderSecret {
  id             String    @id // opaque credential ref
  identityId     String    @map("identity_id")
  encryptedValue String    @map("encrypted_value")
  expiresAt      DateTime? @map("expires_at")
  revokedAt      DateTime? @map("revoked_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  account Account @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId])
  @@index([identityId, expiresAt])
  @@map("ai_provider_secrets")
}


model AiKnowledgeIndexEntry {
  id              String                     @id
  identityId      String                     @map("identity_id")
  repositoryId    String                     @map("repository_id")
  resourceId      String                     @unique @map("resource_id")
  resourcePath    String                     @map("resource_path")
  title           String?
  mimeType        String                     @map("mime_type")
  contentHash     String                     @map("content_hash")
  status          String
  summary         String?                    @db.Text
  keywords        Json                       @default("[]")
  embedding       Json?
  retrievalVector Unsupported("vector(48)")? @map("retrieval_vector")
  chunks          Json?
  metadata        Json                       @default("{}")
  error           String?                    @db.Text
  indexedAt       DateTime                   @map("indexed_at")
  lastRequestedAt DateTime?                  @map("last_requested_at")
  createdAt       DateTime                   @default(now()) @map("created_at")
  updatedAt       DateTime                   @updatedAt @map("updated_at")
  deletedAt       DateTime?                  @map("deleted_at")

  account Account @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId])
  @@index([repositoryId])
  @@index([status])
  @@index([lastRequestedAt])
  @@map("ai_knowledge_index_entries")
}

model DashboardConfig {
  id           Int      @id @default(autoincrement())
  identityId   String   @unique @map("identity_id")
  widgetConfig Json     @map("widget_config")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  account Account @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId])
  @@map("dashboard_configs")
}
