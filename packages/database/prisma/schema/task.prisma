// ==========================================
// Task Module
// 任务计划、实例、历史、统计
// ==========================================

/// TaskPlan 聚合根 - 任务模板
/// 管理任务的完整定义，包括时间配置、重复规则、提醒、Goal绑定等
model TaskPlan {
  // ============ 主键与外键 ============
  id         String @id
  identityId String @map("identity_id")

  // ============ 基础信息 ============
  name        String
  description String?
  status      String /// Task lifecycle: Active | Paused | Closed
  outcome     String   @default("Open") /// Open | Succeeded | Failed | Abandoned
  completionPolicy String @default("AllowCorrection") @map("completion_policy")
  closedAt    DateTime? @map("closed_at")
  archivedAt  DateTime? @map("archived_at")
  abandonedReason String? @map("abandoned_reason")
  importance  String  @default("moderate") /// ImportanceLevel


  // ============ Canonical scheduling/reminder truth ============
  schedule       Json /// TaskPlanSchedule canonical JSON
  reminderConfig String? @map("reminder_config") /// JSON: TaskReminderConfig

  // ============ Goal 绑定（展开的关系值对象） ============
  goalId              String? @map("goal_id")
  keyResultId         String? @map("key_result_id")
  goalRecordValue     Float?  @map("goal_record_value")
  goalProgressTrigger String? @map("goal_progress_trigger")

  // ============ 检查列表（JSON值对象） ============
  checklist String? @map("checklist") /// JSON: ChecklistItemDefinition[]


  // ============ 版本与审计 ============
  version   Int       @default(1)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // ============ 关系映射 ============
  account   Account     @relation(fields: [identityId], references: [id], onDelete: Cascade)
  keyResult KeyResult?  @relation("KeyResultTaskPlans", fields: [keyResultId, goalId, identityId], references: [id, goalId, identityId], onDelete: Restrict)



  // 实例
  occurrences TaskOccurrence[]
  history   TaskPlanHistory[]
  labelLinks TaskLabel[]

  // ============ 索引优化 ============
  @@unique([id, identityId])
  @@index([identityId])
  @@index([status])
  @@index([importance])
  @@index([identityId, goalId, deletedAt])
  @@index([identityId, keyResultId, deletedAt])
  @@index([deletedAt])
  @@map("task_plans")
}

/// TaskOccurrence 聚合根 - 任务实例
/// 从模板生成的具体任务实例，包含执行状态和时间追踪
model TaskOccurrence {
  id                 String    @id
  planId             String    @map("plan_id")
  identityId         String    @map("identity_id")
  occurrenceKey      String    @map("occurrence_key")
  scheduleDate       String    @map("schedule_date") /// Ymd (YYYY-MM-DD)
  scheduleTiming     String    @map("schedule_timing") /// JSON: TaskTiming
  importanceSnapshot String    @default("Moderate") @map("importance_snapshot")
  status             String /// TaskOccurrenceStatus
  actualStartAt      DateTime? @map("actual_start_at")
  result             String? /// JSON: TaskOccurrenceResult
  checklistState     String    @default("[]") @map("checklist_state") /// JSON: TaskOccurrenceChecklistItem[]
  version            Int       @default(1)
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  account Account  @relation(fields: [identityId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  plan    TaskPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, scheduleDate])
  @@index([identityId, status])
  @@index([identityId, scheduleDate])
  @@unique([planId, occurrenceKey])
  @@map("task_occurrences")
}

/// Durable delivery log for completed tasks that contribute Goal progress.
/// It is intentionally task-specific rather than a generic application outbox.
model TaskGoalOutbox {
  eventId        String    @id @map("event_id")
  identityId     String    @map("identity_id")
  taskOccurrenceId String    @map("task_occurrence_id")
  taskPlanId String    @map("task_plan_id")
  goalId         String    @map("goal_id")
  keyResultId    String    @map("key_result_id")
  payload        String
  action         String    @default("complete")
  status         String    @default("PENDING")
  attempts       Int       @default(0)
  availableAt    DateTime  @default(now()) @map("available_at")
  lastError      String?   @map("last_error")
  dispatchedAt   DateTime? @map("dispatched_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([identityId, status, availableAt])
  @@index([status, availableAt])
  @@index([taskOccurrenceId])
  @@map("task_goal_outbox")
}

model TaskPlanHistory {
  id         String   @id
  identityId String   @map("identity_id")
  planId     String   @map("plan_id")
  action     String
  changes    String?
  createdAt  DateTime @default(now()) @map("created_at")

  identity Account      @relation("AccountTaskPlanHistory", fields: [identityId], references: [id])
  plan      TaskPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([identityId])
  @@index([planId])
  @@map("task_plan_history")
}
