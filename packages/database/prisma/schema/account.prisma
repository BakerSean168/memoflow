// ==========================================
// Account Module
// 账户聚合根
// ==========================================

model Account {
  assistedWorkflows AiAssistedWorkflow[]
  id               String    @id // same as CloudAuthUser.id for cloud accounts
  status           String    @default("Active") // AccountStatus: Active | Closed
  // profile
  profile          Json
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  closedAt         DateTime? @map("closed_at")
  // Cloud avatar reference: the blob lives in AccountAvatar; this is the
  // server-authoritative last-write-wins timestamp used by other devices.
  avatarUpdatedAt  DateTime? @map("avatar_updated_at")

  // 关联关系
  cloudUser CloudAuthUser @relation(fields: [id], references: [id], onDelete: Cascade)
  avatar    AccountAvatar?

  // 关联的业务模块
  externalMutationReceipts         ExternalMutationReceipt[]
  goals                           Goal[]
  profileImportOperations         ProfileImportOperation[]
  profileImportArchives           ProfileImportArchive[]
  labels                          Label[]
  goalLabels                      GoalLabel[]
  taskLabels                      TaskLabel[]
  routineDefinitions               RoutineDefinition[]
  routinePreference                RoutinePreference?
  routineTemporaryOverrides          RoutineTemporaryOverride[]
  routineProfiles                  RoutineProfile[]
  routineProfileMemberships        RoutineProfileMembership[]
  routineProtocolDefinitions       RoutineProtocolDefinition[]
  routineProtocolSessions          RoutineProtocolSession[]
  schedules                       Schedule[]
  schedulingReconcileOperations   SchedulingReconcileOperation[]
  scheduledInvocations            ScheduledInvocation[]
  invocationAttempts              InvocationAttempt[]
  habits                          Habit[]
  relations                       Relation[]
  walletAccounts                  WalletAccount[]
  walletTransactions              WalletTransaction[] @relation("AccountWalletTransactions")
  taskPlans                   TaskPlan[]
  taskOccurrences                   TaskOccurrence[]
  userPreferenceRecords           UserPreferenceRecord[]
  notifications                   Notification[]
  aiConversations                 AiConversation[]
  aiExecutionRecords              AiExecutionRecord[]
  aiPermissionSettings            AiPermissionSetting[]
  aiPermissionRules               AiPermissionRule[]
  aiPermissionAudits              AiPermissionAudit[]
  aiGoalSurfaceLeases             AiGoalSurfaceLease[]
  aiConversationAttention         AiConversationAttention[]
  aiKnowledgeIndexEntries         AiKnowledgeIndexEntry[]
  aiProviderConfigs               AiProviderConfig[]
  aiAgentInstances                AiAgentInstance[]
  aiAgentInstanceBindings         AiAgentInstanceBinding[]
  aiProviderOnboardingSessions     AiProviderOnboardingSession[]
  aiProviderSecrets                AiProviderSecret[]

  // PowerSync: denormalized identity relations
  taskPlanHistory            TaskPlanHistory[]           @relation("AccountTaskPlanHistory")
  routineOccurrences             RoutineOccurrence[]             @relation("AccountRoutineOccurrences")
  routineInteractions             RoutineInteraction[]
  notificationInteractions       NotificationInteraction[]        @relation("AccountNotificationInteractions")
  notificationDispatchOutboxes   NotificationDispatchOutbox[]    @relation("AccountNotificationDispatchOutboxes")
  knowledgeRemoteBindings        KnowledgeRemoteBinding[]
  knowledgeRepositoryInstallationIntents KnowledgeRepositoryInstallationIntent[]
  knowledgeWriteRequests         KnowledgeWriteRequest[]

  @@map("accounts")
}

/// Normalized PNG avatar bytes for a cloud Account (Issue #859).
///
/// Kept out of `accounts.profile` so ordinary Account reads never load the
/// image, and stored in the existing Postgres deployment instead of adding a
/// new object-storage service. `Account.avatarUpdatedAt` is the conflict
/// timestamp surfaced to clients.
model AccountAvatar {
  accountId    String   @id @map("account_id")
  contentBytes Bytes    @map("content_bytes")
  byteSize     Int      @map("byte_size")
  updatedAt    DateTime @map("updated_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("account_avatars")
}
