// =============================================================
// MemoFlow Database Schema — Base Configuration
// =============================================================
//
// This file contains the generator and datasource configuration
// All model files in this folder will be automatically included
// =============================================================

generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// Account Module
// 账户聚合根
// ==========================================

model Account {
  id               String    @id // same as CloudAuthUser.id for cloud accounts
  status           String    @default("ACTIVE") // AccountStatus: ACTIVE | INACTIVE | SUSPENDED | DELETED
  // profile
  profile          Json
  // settings
  settings         Json
  // email object value
  emailAddress     String    @unique @map("email_address") // jdoe@example.com
  emailIsVerified  Boolean   @default(false) @map("email_is_verified")
  emailVerifiedAt  DateTime? @map("email_verified_at")
  emailIsPrimary   Boolean   @default(false) @map("email_is_primary")
  // phone object value
  phoneCountryCode String?   @map("phone_country_code") // +86
  phoneNumber      String?   @map("phone_number") // 13800138000
  phoneFullNumber  String?   @map("phone_full_number") // +8613800138000 (E.164格式)
  phoneIsVerified  Boolean?  @default(false) @map("phone_is_verified")
  phoneVerifiedAt  DateTime? @map("phone_verified_at")
  version          Int       @default(1)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  // 关联关系
  cloudUser CloudAuthUser @relation(fields: [id], references: [id], onDelete: Cascade)

  // 关联的业务模块
  editorWorkspaces                EditorWorkspace[]
  editorWorkspaceSessions         EditorWorkspaceSession[]
  editorWorkspaceSessionGroups    EditorWorkspaceSessionGroup[]
  editorWorkspaceSessionGroupTabs EditorWorkspaceSessionGroupTab[]
  goals                           Goal[]
  labels                          Label[]
  goalLabels                      GoalLabel[]
  taskLabels                      TaskLabel[]
  reminderGroups                  ReminderGroup[]
  reminderTemplates               ReminderTemplate[]
  reminderInstances               ReminderInstance[]
  reminderStatistics              ReminderStatistic?
  routineDefinitions              RoutineDefinition[]
  routineTemporaryOverrides       RoutineTemporaryOverride[]
  routineProfiles                 RoutineProfile[]
  routineProfileMemberships       RoutineProfileMembership[]
  routineProtocolDefinitions      RoutineProtocolDefinition[]
  routineProtocolSessions         RoutineProtocolSession[]
  userReminderPreferences         UserReminderPreference?
  repositories                    Repository[]
  repositoryExplorers             RepositoryExplorer[]
  repositoryStatistics            RepositoryStatistic?
  schedules                       Schedule[]
  scheduleTasks                   ScheduleTask[]
  schedulingReconcileOperations   SchedulingReconcileOperation[]
  scheduleStatistics              ScheduleStatistic?
  habits                          Habit[]
  relations                       Relation[]
  walletAccounts                  WalletAccount[]
  walletTransactions              WalletTransaction[]              @relation("AccountWalletTransactions")
  activityLedger                  ActivityLedger[]
  taskTemplates                   TaskTemplate[]
  taskInstances                   TaskInstance[]
  taskStatistics                  TaskStatistic?
  userSettings                    UserSetting?
  notifications                   Notification[]
  aiConversations                 AiConversation[]
  aiGenerationTasks               AiGenerationTask[]
  aiKnowledgeIndexEntries         AiKnowledgeIndexEntry[]
  aiUsageQuotas                   AiUsageQuota?
  aiProviderConfigs               AiProviderConfig[]
  aiProviderOnboardingSessions    AiProviderOnboardingSession[]
  dashboardConfigs                DashboardConfig?

  // PowerSync: denormalized identity relations
  taskTemplateHistory                    TaskTemplateHistory[]                   @relation("AccountTaskTemplateHistory")
  scheduleExecutions                     ScheduleExecution[]                     @relation("AccountScheduleExecutions")
  reminderHistory                        ReminderHistory[]                       @relation("AccountReminderHistory")
  reminderResponses                      ReminderResponse[]                      @relation("AccountReminderResponses")
  reminderOccurrences                    ReminderOccurrence[]                    @relation("AccountReminderOccurrences")
  routineOccurrences                     RoutineOccurrence[]                     @relation("AccountRoutineOccurrences")
  notificationChannels                   NotificationChannel[]                   @relation("AccountNotificationChannels")
  notificationHistory                    NotificationHistory[]                   @relation("AccountNotificationHistory")
  notificationDispatchOutboxes           NotificationDispatchOutbox[]            @relation("AccountNotificationDispatchOutboxes")
  aiMessages                             AiMessage[]                             @relation("AccountAiMessages")
  folders                                Folder[]                                @relation("AccountFolders")
  resources                              Resource[]                              @relation("AccountResources")
  repositoryResources                    RepositoryResource[]                    @relation("AccountRepositoryResources")
  knowledgeRepositoryConnections         KnowledgeRepositoryConnection[]
  knowledgeRepositoryInstallationIntents KnowledgeRepositoryInstallationIntent[]
  knowledgeWriteRequests                 KnowledgeWriteRequest[]

  @@index([emailAddress])
  @@index([phoneFullNumber])
  @@map("accounts")
}

// ==========================================
// Activity Ledger (R6)
// 全业务事件的可解释活动账本（Dashboard 读模型之源）
// ==========================================

model ActivityLedger {
  id            String   @id
  identityId    String   @map("identity_id")
  actorId       String   @map("actor_id")
  subjectType   String   @map("subject_type") /// goal | task | reminder | schedule | habit | knowledge
  subjectId     String   @map("subject_id")
  action        String   @map("action") /// created | completed | updated | response | executed | ...
  title         String? /// 归档标题快照（跨 DST/归档实体仍显示准确标题）
  correlationId String?  @map("correlation_id")
  beforeSummary String?  @map("before_summary")
  afterSummary  String?  @map("after_summary")
  sourceEvent   String   @map("source_event")
  occurredAt    DateTime @map("occurred_at")
  createdAt     DateTime @default(now()) @map("created_at")

  account Account @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId, occurredAt])
  @@index([identityId, subjectType, subjectId])
  @@map("activity_ledger")
}

// ==========================================
// AI Module
// AI 对话、消息、生成任务、配额、Provider 配置
// ==========================================

model AiConversation {
  id            String    @id
  identityId    String    @map("identity_id")
  name          String
  status        String // ACTIVE, CLOSED, ARCHIVED
  messageCount  Int       @default(0) @map("message_count")
  lastMessageAt DateTime? @map("last_message_at")
  version       Int       @default(1)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  account  Account     @relation(fields: [identityId], references: [id], onDelete: Cascade)
  messages AiMessage[]

  @@index([identityId])
  @@index([status])
  @@index([createdAt])
  @@index([lastMessageAt])
  @@map("ai_conversations")
}

model AiMessage {
  id             String   @id
  identityId     String   @map("identity_id")
  conversationId String   @map("conversation_id")
  role           String // USER, ASSISTANT, SYSTEM
  content        String   @db.Text
  tokenUsage     String?  @map("token_usage") // JSON
  createdAt      DateTime @default(now()) @map("created_at")

  identity     Account        @relation("AccountAiMessages", fields: [identityId], references: [id])
  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([identityId])
  @@index([conversationId])
  @@index([createdAt])
  @@map("ai_messages")
}

model AiGenerationTask {
  id               String    @id
  identityId       String    @map("identity_id")
  taskType         String    @map("task_type") // GOAL_KEY_RESULTS, TASK_TEMPLATES, etc.
  status           String // PENDING, PROCESSING, COMPLETED, FAILED
  conversationId   String?   @map("conversation_id")
  runId            String?   @map("run_id")
  requestId        String?   @map("request_id")
  traceId          String?   @map("trace_id")
  providerId       String?   @map("provider_id")
  model            String?
  estimatedCostUsd Float?    @map("estimated_cost_usd")
  input            String    @db.Text // JSON string
  result           String?   @db.Text // JSON string
  error            String?   @db.Text
  retryCount       Int       @default(0) @map("retry_count")
  tokenUsage       String?   @map("token_usage") // JSON
  processingMs     Int?      @map("processing_ms")
  version          Int       @default(1)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  completedAt      DateTime? @map("completed_at")
  deletedAt        DateTime? @map("deleted_at")

  account Account @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId])
  @@index([taskType])
  @@index([status])
  @@index([createdAt])
  @@index([identityId, conversationId, createdAt])
  @@index([identityId, runId, createdAt])
  @@map("ai_generation_tasks")
}

model AiUsageQuota {
  id           String    @id
  identityId   String    @unique @map("identity_id")
  quotaLimit   Int       @default(50) @map("quota_limit")
  currentUsage Int       @default(0) @map("current_usage")
  resetPeriod  String    @default("DAILY") @map("reset_period") // DAILY, WEEKLY, MONTHLY
  lastResetAt  DateTime  @default(now()) @map("last_reset_at")
  nextResetAt  DateTime  @map("next_reset_at")
  version      Int       @default(1)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  account Account @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId])
  @@index([nextResetAt])
  @@map("ai_usage_quotas")
}

model AiProviderConfig {
  id              String    @id
  identityId      String    @map("identity_id")
  name            String // 配置名称
  providerType    String    @map("provider_type") // OPENAI, QINIU, ANTHROPIC, CUSTOM_OPENAI_COMPATIBLE
  baseUrl         String    @map("base_url") // API 基础地址
  apiKeyEncrypted String    @map("api_key_encrypted") // AES-256-GCM 加密的 API Key
  defaultModel    String?   @map("default_model")
  availableModels String    @default("[]") @map("available_models") // 可用模型列表 JSON
  isActive        Boolean   @default(true) @map("is_active")
  isDefault       Boolean   @default(false) @map("is_default")
  priority        Int       @default(100) // 优先级
  version         Int       @default(1)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  account Account @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@unique([identityId, name])
  @@index([identityId])
  @@index([isDefault])
  @@index([isActive])
  @@index([priority])
  @@map("ai_provider_configs")
}

model AiProviderOnboardingSession {
  id                  String    @id
  identityId          String    @map("identity_id")
  catalogId           String    @map("catalog_id")
  baseUrl             String    @map("base_url")
  targetProviderId    String?   @map("target_provider_id")
  credentialEncrypted String    @map("credential_encrypted")
  credentialStatus    String    @map("credential_status")
  discoveryStatus     String    @map("discovery_status")
  modelsJson          String    @default("[]") @map("models_json")
  verifiedModelIds    String    @default("[]") @map("verified_model_ids")
  expiresAt           DateTime  @map("expires_at")
  consumedAt          DateTime? @map("consumed_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  account Account @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId, expiresAt])
  @@index([identityId, targetProviderId, expiresAt])
  @@index([expiresAt])
  @@map("ai_provider_onboarding_sessions")
}

model KnowledgeGenerationTask {
  id                   String    @id
  identityId           String    @map("identity_id")
  topic                String
  resourceCount        Int       @default(5) @map("resource_count")
  targetAudience       String?   @map("target_audience")
  folderPath           String    @map("folder_path")
  status               String // PENDING, GENERATING, COMPLETED, FAILED
  progress             Int       @default(0) // 0-100
  generatedResourceIds String[]  @map("generated_resource_ids")
  error                String?   @db.Text
  createdAt            DateTime  @default(now()) @map("created_at")
  completedAt          DateTime? @map("completed_at")

  @@index([identityId])
  @@index([status])
  @@index([createdAt])
  @@map("knowledge_generation_tasks")
}

model AiKnowledgeIndexEntry {
  id              String                     @id
  identityId      String                     @map("identity_id")
  repositoryId    String                     @map("repository_id")
  resourceId      String                     @unique @map("resource_id")
  resourcePath    String                     @map("resource_path")
  title           String?
  mimeType        String                     @map("mime_type")
  contentHash     String                     @map("content_hash")
  status          String
  summary         String?                    @db.Text
  keywords        Json                       @default("[]")
  embedding       Json?
  retrievalVector Unsupported("vector(48)")? @map("retrieval_vector")
  chunks          Json?
  metadata        Json                       @default("{}")
  error           String?                    @db.Text
  indexedAt       DateTime                   @map("indexed_at")
  lastRequestedAt DateTime?                  @map("last_requested_at")
  createdAt       DateTime                   @default(now()) @map("created_at")
  updatedAt       DateTime                   @updatedAt @map("updated_at")
  deletedAt       DateTime?                  @map("deleted_at")

  account Account @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId])
  @@index([repositoryId])
  @@index([status])
  @@index([lastRequestedAt])
  @@map("ai_knowledge_index_entries")
}

model DashboardConfig {
  id           Int      @id @default(autoincrement())
  identityId   String   @unique @map("identity_id")
  widgetConfig Json     @map("widget_config")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  account Account @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId])
  @@map("dashboard_configs")
}

// Better Auth cloud identity source.
// Explicit model names avoid confusing provider accounts with MemoFlow Account.

model CloudAuthUser {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  status        String    @default("active")
  disabledAt    DateTime? @map("disabled_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  sessions         CloudAuthSession[]
  providerAccounts CloudAuthProviderAccount[]
  deviceCodes      CloudAuthDeviceCode[]
  account          Account?

  @@map("cloud_auth_users")
}

model CloudAuthSession {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user CloudAuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("cloud_auth_sessions")
}

model CloudAuthProviderAccount {
  id                    String    @id @default(uuid())
  userId                String    @map("user_id")
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user CloudAuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("cloud_auth_provider_accounts")
}

model CloudAuthVerification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("cloud_auth_verifications")
}

model CloudAuthDeviceCode {
  id              String    @id @default(uuid())
  deviceCode      String    @unique @map("device_code")
  userCode        String    @unique @map("user_code")
  userId          String?   @map("user_id")
  expiresAt       DateTime  @map("expires_at")
  status          String
  lastPolledAt    DateTime? @map("last_polled_at")
  pollingInterval Int?      @map("polling_interval")
  clientId        String?   @map("client_id")
  scope           String?

  user CloudAuthUser? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
  @@map("cloud_auth_device_codes")
}

// ==========================================
// Editor Module
// 编辑器工作区、会话、标签页
// ==========================================

model EditorWorkspace {
  id          String    @id
  identityId  String    @map("identity_id")
  name        String
  description String?
  projectPath String    @map("project_path")
  projectType String    @map("project_type")
  layout      Json
  setting     Json
  isActive    Boolean   @default(true) @map("is_active")
  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  accessedAt  DateTime  @default(now()) @map("accessed_at")
  deletedAt   DateTime? @map("deleted_at")

  sessions EditorWorkspaceSession[]
  account  Account                  @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@unique([identityId, projectPath])
  @@index([isActive])
  @@map("editor_workspaces")
}

model EditorWorkspaceSession {
  id          String    @id
  workspaceId String    @map("workspace_id")
  identityId  String    @map("identity_id")
  name        String
  layout      Json
  isActive    Boolean   @default(true) @map("is_active")
  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  groups    EditorWorkspaceSessionGroup[]
  account   Account                       @relation(fields: [identityId], references: [id], onDelete: Cascade)
  workspace EditorWorkspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("editor_workspace_sessions")
}

model EditorWorkspaceSessionGroup {
  id             String    @id
  sessionId      String    @map("session_id")
  workspaceId    String    @map("workspace_id")
  identityId     String    @map("identity_id")
  groupIndex     Int       @map("group_index")
  name           String?
  splitDirection String    @map("split_direction")
  version        Int       @default(1)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  tabs    EditorWorkspaceSessionGroupTab[]
  account Account                          @relation(fields: [identityId], references: [id], onDelete: Cascade)
  session EditorWorkspaceSession           @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("editor_workspace_session_groups")
}

model EditorWorkspaceSessionGroupTab {
  id          String    @id
  groupId     String    @map("group_id")
  sessionId   String    @map("session_id")
  workspaceId String    @map("workspace_id")
  identityId  String    @map("identity_id")
  resourceId  String?   @map("resource_id")
  tabIndex    Int       @map("tab_index")
  tabType     String    @map("tab_type")
  title       String
  viewState   Json      @map("view_state")
  isPinned    Boolean   @default(false) @map("is_pinned")
  isActive    Boolean   @default(false) @map("is_active")
  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  account Account                     @relation(fields: [identityId], references: [id], onDelete: Cascade)
  group   EditorWorkspaceSessionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("editor_workspace_session_group_tabs")
}

// ==========================================
// Goal Module — Core vNext
// Goal = Direction + Measurement
// ==========================================

model Goal {
  id                  String    @id
  identityId          String    @map("identity_id")
  name                String
  description         String?
  feasibilityAnalysis String?   @map("feasibility_analysis")
  motivation          String?
  status              String    @default("Active")
  startDate           DateTime? @map("start_date")
  dueDate             DateTime? @map("due_date")
  completedAt         DateTime? @map("completed_at")
  archivedAt          DateTime? @map("archived_at")
  sortOrder           Int       @default(0) @map("sort_order")
  reminderConfig      String?   @map("reminder_config")
  version             Int       @default(1)
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")

  account                  Account                   @relation(fields: [identityId], references: [id], onDelete: Cascade)
  keyResults               KeyResult[]               @relation("GoalKeyResults")
  reviews                  GoalReview[]
  keyResultWeightSnapshots KeyResultWeightSnapshot[]
  labelLinks               GoalLabel[]

  @@unique([id, identityId])
  @@index([identityId, status])
  @@index([identityId, dueDate])
  @@index([dueDate])
  @@index([deletedAt])
  @@map("goals")
}

model KeyResult {
  id                    String   @id
  identityId            String   @map("identity_id")
  goalId                String   @map("goal_id")
  title                 String
  description           String?
  aggregationMethod     String   @map("aggregation_method")
  startingValue         Float    @default(0) @map("starting_value")
  progressBaselineValue Float?   @map("progress_baseline_value")
  targetValue           Float    @map("target_value")
  currentValue          Float    @default(0) @map("current_value")
  unit                  String?
  weight                Int      @default(1)
  order                 Int      @default(0)
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  goal                     Goal                      @relation("GoalKeyResults", fields: [goalId, identityId], references: [id, identityId], onDelete: Cascade)
  linkedTaskTemplates      TaskTemplate[]            @relation("KeyResultTaskTemplates")
  records                  GoalRecord[]
  keyResultWeightSnapshots KeyResultWeightSnapshot[]

  @@unique([id, identityId])
  @@unique([id, goalId, identityId])
  @@index([identityId])
  @@index([goalId])
  @@index([goalId, order])
  @@map("key_results")
}

model GoalRecord {
  id          String   @id
  identityId  String   @map("identity_id")
  keyResultId String   @map("key_result_id")
  value       Float
  note        String?
  sourceType  String?  @map("source_type")
  sourceId    String?  @map("source_id")
  recordedAt  DateTime @map("recorded_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  keyResult KeyResult @relation(fields: [keyResultId, identityId], references: [id, identityId], onDelete: Cascade)

  @@unique([identityId, sourceType, sourceId])
  @@index([identityId])
  @@index([keyResultId, recordedAt])
  @@index([recordedAt])
  @@map("goal_records")
}

model GoalReview {
  id            String   @id
  identityId    String   @map("identity_id")
  goalId        String   @map("goal_id")
  reflection    String
  challenges    String?
  adjustments   String?
  systemContext String   @map("system_context")
  reviewedAt    DateTime @map("reviewed_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  goal Goal @relation(fields: [goalId, identityId], references: [id, identityId], onDelete: Cascade)

  @@index([identityId])
  @@index([goalId, reviewedAt])
  @@map("goal_reviews")
}

model KeyResultWeightSnapshot {
  id           String   @id
  identityId   String   @map("identity_id")
  goalId       String   @map("goal_id")
  keyResultId  String   @map("key_result_id")
  oldWeight    Int      @map("old_weight")
  newWeight    Int      @map("new_weight")
  weightDelta  Int      @map("weight_delta")
  snapshotTime DateTime @map("snapshot_time")
  trigger      String
  reason       String?
  operatorId   String   @map("operator_id")
  createdAt    DateTime @default(now()) @map("created_at")

  goal      Goal      @relation(fields: [goalId, identityId], references: [id, identityId], onDelete: Cascade)
  keyResult KeyResult @relation(fields: [keyResultId, goalId, identityId], references: [id, goalId, identityId], onDelete: Cascade)

  @@index([identityId])
  @@index([goalId, snapshotTime])
  @@index([keyResultId, snapshotTime])
  @@index([snapshotTime])
  @@map("key_result_weight_snapshots")
}

// ==========================================
// Governance Module
// 规则管理、规则修订记录
// ==========================================

// ==========================================
// 1. 规则聚合根表 (Rule)
// ==========================================
model Rule {
  id          String @id @default(uuid())
  code        String @unique // 规则编码，格式：PREFIX-NUMBER (e.g., DDD-001)
  title       String // 规则标题
  description String // 规则描述

  severity String @default("Recommended") // Mandatory | Recommended
  status   String @default("Draft") // Draft | Active | Deprecated

  deprecationReason     String? @map("deprecation_reason")
  replacementRuleId     String? @map("replacement_rule_id")
  liveReferenceLocation String? @map("live_reference_location")

  // JSON fields
  tags         String // JSON array of tag strings
  goodExamples String @map("good_examples") // JSON array of code snippets
  badExamples  String @map("bad_examples") // JSON array of code snippets

  authorId String @map("author_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // 关联
  revisions RuleRevision[]

  @@map("rules")
}

// ==========================================
// 2. 规则修订记录表 (RuleRevision)
// ==========================================
model RuleRevision {
  id             String @id @default(uuid())
  ruleId         String @map("rule_id")
  revisionNumber Int    @map("revision_number")

  authorId       String  @map("author_id")
  changedFields  String  @map("changed_fields") // JSON array
  previousValues String? @map("previous_values") // JSON object
  newValues      String? @map("new_values") // JSON object
  changeType     String  @map("change_type") // Created | Updated | Deprecated | Reactivated

  createdAt DateTime @default(now()) @map("created_at")

  // 关联
  rule Rule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, revisionNumber])
  @@map("rule_revisions")
}

// ==========================================
// Habit Module (R4)
// 习惯、习惯发生、打卡与连续天数投影
// ==========================================

model Habit {
  id          String    @id
  identityId  String    @map("identity_id")
  name        String
  description String?
  frequency   String    @default("daily") /// daily | weekly
  goalId      String?   @map("goal_id") /// 关联目标（贡献策略使用）
  status      String    @default("Active") /// Active | Archived
  startDate   DateTime? @map("start_date")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  account Account @relation(fields: [identityId], references: [id], onDelete: Cascade)

  occurrences HabitOccurrence[]
  streak      HabitStreakProjection?

  @@index([identityId])
  @@map("habits")
}

model HabitOccurrence {
  id             String   @id
  habitId        String   @map("habit_id")
  occurrenceDate DateTime @map("occurrence_date") /// 本地日 00:00
  status         String   @default("Pending") /// Pending | Completed | Skipped
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  habit    Habit          @relation(fields: [habitId], references: [id], onDelete: Cascade)
  checkIns HabitCheckIn[]

  @@unique([habitId, occurrenceDate])
  @@index([habitId, status])
  @@map("habit_occurrences")
}

model HabitCheckIn {
  id           String   @id
  occurrenceId String   @map("occurrence_id")
  checkedAt    DateTime @map("checked_at")
  note         String?
  createdAt    DateTime @default(now()) @map("created_at")

  occurrence HabitOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)

  @@index([occurrenceId])
  @@map("habit_check_ins")
}

model HabitStreakProjection {
  id              String    @id
  habitId         String    @unique @map("habit_id")
  currentStreak   Int       @map("current_streak")
  longestStreak   Int       @map("longest_streak")
  lastCheckInDate DateTime? @map("last_check_in_date")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@map("habit_streak_projections")
}

// ==========================================
// Shared Labels (ADR-054)
// User-owned classification shared by Goal and Task.
// ==========================================

model Label {
  id             String   @id
  identityId     String   @map("identity_id")
  name           String
  normalizedName String   @map("normalized_name")
  color          String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  account   Account     @relation(fields: [identityId], references: [id], onDelete: Cascade)
  goalLinks GoalLabel[]
  taskLinks TaskLabel[]

  @@unique([id, identityId])
  @@unique([identityId, normalizedName])
  @@index([identityId, name])
  @@map("labels")
}

model GoalLabel {
  identityId String @map("identity_id")
  goalId     String @map("goal_id")
  labelId    String @map("label_id")

  account Account @relation(fields: [identityId], references: [id], onDelete: Cascade)
  goal    Goal    @relation(fields: [goalId, identityId], references: [id, identityId], onDelete: Cascade)
  label   Label   @relation(fields: [labelId, identityId], references: [id, identityId], onDelete: Cascade)

  @@id([identityId, goalId, labelId])
  @@index([identityId, labelId, goalId])
  @@map("goal_labels")
}

model TaskLabel {
  identityId     String @map("identity_id")
  taskTemplateId String @map("task_template_id")
  labelId        String @map("label_id")

  account      Account      @relation(fields: [identityId], references: [id], onDelete: Cascade)
  taskTemplate TaskTemplate @relation(fields: [taskTemplateId, identityId], references: [id, identityId], onDelete: Cascade)
  label        Label        @relation(fields: [labelId, identityId], references: [id, identityId], onDelete: Cascade)

  @@id([identityId, taskTemplateId, labelId])
  @@index([identityId, labelId, taskTemplateId])
  @@map("task_labels")
}

// ==========================================
// Notification Module
// 通知聚合根、渠道、历史、偏好、模板
// ==========================================

model Notification {
  id                String    @id
  identityId        String    @map("identity_id")
  type              String
  category          String
  workflowKey       String    @map("workflow_key")
  topic             String
  idempotencyKey    String    @map("idempotency_key")
  title             String
  content           String
  importance        String
  urgency           String
  relatedEntityType String?   @map("related_entity_type")
  relatedEntityId   String?   @map("related_entity_id")
  metadata          String?
  actions           String?
  navigationIntent  String?   @map("navigation_intent")
  correlationId     String?   @map("correlation_id")
  causationId       String?   @map("causation_id")
  readAt            DateTime? @map("read_at")
  expiresAt         DateTime? @map("expires_at")
  version           Int       @default(1)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")
  isRead            Boolean   @default(false) @map("is_read")

  channels          NotificationChannel[]
  history           NotificationHistory[]
  dispatchOutboxes  NotificationDispatchOutbox[]
  deliveryDecisions NotificationDeliveryDecisionRecord[]
  account           Account                              @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@unique([identityId, idempotencyKey])
  @@index([identityId, workflowKey])
  @@map("notifications")
}

model NotificationChannel {
  id             String    @id
  identityId     String    @map("identity_id")
  notificationId String    @map("notification_id")
  channelType    String    @map("channel_type")
  status         String
  recipient      String?
  maxRetries     Int       @default(3) @map("max_retries")
  error          String?
  response       String?
  retryCount     Int       @default(0) @map("retry_count")
  sentAt         DateTime? @map("sent_at")
  failedAt       DateTime? @map("failed_at")
  attempts       Int       @default(0)

  identity     Account      @relation("AccountNotificationChannels", fields: [identityId], references: [id])
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([identityId])
  @@index([notificationId])
  @@map("notification_channels")
}

model NotificationHistory {
  id             String   @id
  identityId     String   @map("identity_id")
  notificationId String   @map("notification_id")
  action         String
  details        String?
  actorId        String?  @map("actor_id")
  createdAt      DateTime @default(now()) @map("created_at")

  identity     Account      @relation("AccountNotificationHistory", fields: [identityId], references: [id])
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([identityId])
  @@index([notificationId])
  @@map("notification_history")
}

model NotificationDeliveryDecisionRecord {
  id               String    @id
  identityId       String    @map("identity_id")
  notificationId   String    @map("notification_id")
  channel          String
  outcome          String
  reason           String
  preferenceSource String?   @map("preference_source")
  retryAt          DateTime? @map("retry_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel])
  @@index([identityId])
  @@map("notification_delivery_decisions")
}

model NotificationPreference {
  id                String    @id
  identityId        String    @unique @map("identity_id")
  globalChannels    String    @default("{}") @map("global_channels")
  workflowOverrides String    @default("{}") @map("workflow_overrides")
  doNotDisturb      String?   @map("do_not_disturb")
  rateLimit         String?   @map("rate_limit")
  version           Int       @default(1)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  @@index([identityId])
  @@map("notification_preferences")
}

model NotificationTemplate {
  id              String   @id
  name            String   @unique
  displayName     String   @map("display_name")
  description     String?
  type            String
  category        String
  titleTemplate   String   @map("title_template")
  contentTemplate String   @map("content_template")
  variables       String?
  defaultActions  String?  @map("default_actions")
  isSystem        Boolean  @default(false) @map("is_system")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([name])
  @@map("notification_templates")
}

/// NotificationDispatchOutbox 投递意图/Outbox（W2: LeaseClaim 与 durable receipt）
model NotificationDispatchOutbox {
  id                  String    @id
  identityId          String    @map("identity_id")
  notificationId      String    @map("notification_id")
  source              String    @default("notification")
  occurrenceKey       String    @map("occurrence_key")
  channel             String
  payloadJson         String    @map("payload_json")
  idempotencyKey      String    @unique @map("idempotency_key")
  status              String
  attempt             Int       @default(0)
  ownerToken          String?   @map("owner_token")
  claimId             String?   @map("claim_id")
  fencingToken        Int       @default(0) @map("fencing_token")
  leaseExpiresAt      DateTime? @map("lease_expires_at")
  lastHeartbeatAt     DateTime? @map("last_heartbeat_at")
  heartbeatIntervalMs Int?      @map("heartbeat_interval_ms")
  lastError           String?   @map("last_error")
  nextRetryAt         DateTime? @map("next_retry_at")
  deadLetterAt        DateTime? @map("dead_letter_at")
  correlationId       String?   @map("correlation_id")
  causationId         String?   @map("causation_id")
  attemptsHistoryJson String?   @map("attempts_history_json")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  finishedAt          DateTime? @map("finished_at")

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  account      Account      @relation("AccountNotificationDispatchOutboxes", fields: [identityId], references: [id])

  @@index([identityId])
  @@index([status])
  @@index([leaseExpiresAt])
  @@map("notification_dispatch_outbox")
}

// ==========================================
// Relation Module (R5)
// 跨模块 SubjectRef 关系：Note/Goal/Task/Reminder/Habit 双向连接
// ==========================================

model Relation {
  id           String   @id
  identityId   String   @map("identity_id")
  subjectType  String   @map("subject_type") /// note | goal | task | reminder | habit
  subjectId    String   @map("subject_id")
  relationType String   @map("relation_type") /// references | related | depends_on | contributes_to
  objectType   String   @map("object_type")
  objectId     String   @map("object_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  account Account @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@unique([identityId, subjectType, subjectId, relationType, objectType, objectId])
  @@index([identityId, objectType, objectId]) /// 反向查询
  @@map("relations")
}

// ==========================================
// Reliable Messaging (R1-1)
// 通用 outbox / inbox receipt / projection cursor
// 提供跨模块副作用的 durable 边界与崩溃恢复游标
// ==========================================

/// Outbox 消息：跨模块写入与投递意图的 durable 队列。
/// AggregateRepositoryBase 发布事件失败时落入此表，由 dispatcher 重试投递。
model OutboxMessage {
  id              String    @id
  identityId      String?   @map("identity_id")
  messageType     String    @map("message_type")
  schemaVersion   Int       @default(1) @map("schema_version")
  correlationId   String    @map("correlation_id")
  causationId     String?   @map("causation_id")
  payloadJson     String    @map("payload_json")
  idempotencyKey  String?   @unique @map("idempotency_key")
  status          String    @default("pending")
  attempts        Int       @default(0)
  availableAt     DateTime  @default(now()) @map("available_at")
  lastError       String?   @map("last_error")
  dispatchedAt    DateTime? @map("dispatched_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  ownerToken      String?
  claimId         String?
  fencingToken    Int?
  leaseExpiresAt  DateTime? @map("lease_expires_at")
  lastHeartbeatAt DateTime? @map("last_heartbeat_at")

  @@index([status, availableAt])
  @@index([correlationId])
  @@index([messageType])
  @@map("reliable_outbox_messages")
}

/// Inbox 回执：同一消息对同一消费者只允许一次成功处理（幂等去重）。
model InboxReceipt {
  id          String
  consumer    String
  outcome     String
  error       String?
  processedAt DateTime @default(now()) @map("processed_at")

  @@id([id, consumer])
  @@index([consumer, outcome])
  @@map("reliable_inbox_receipts")
}

/// Projection 游标：启动 reconcile 与增量重放的断点。
model ProjectionCursor {
  projector       String
  sourceName      String    @map("source_name")
  lastProcessedId String?   @map("last_processed_id")
  lastProcessedAt DateTime? @map("last_processed_at")
  version         Int       @default(0)
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@id([projector, sourceName])
  @@map("reliable_projection_cursors")
}

/// 闭户操作表：记录账户注销 saga 的状态、幂等键与恢复点。
model AccountClosureOperation {
  id               String    @id @default(uuid())
  identityId       String    @map("identity_id")
  idempotencyKey   String    @map("idempotency_key")
  phase            String
  status           String
  attempts         Int       @default(0)
  version          Int       @default(1)
  ownerToken       String?   @map("owner_token")
  leaseExpiresAt   DateTime? @map("lease_expires_at")
  lastHeartbeatAt  DateTime? @map("last_heartbeat_at")
  nextRetryAt      DateTime? @map("next_retry_at")
  deadLetterAt     DateTime? @map("dead_letter_at")
  eventId          String?   @map("event_id")
  reason           String?
  revokedSessions  Int       @default(0) @map("revoked_sessions")
  piiCleanupStatus String?   @map("pii_cleanup_status")
  piiReason        String?   @map("pii_reason")
  lastErrorCode    String?   @map("last_error_code")
  lastError        String?   @map("last_error")
  receiptJson      String?   @map("receipt_json")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  finishedAt       DateTime? @map("finished_at")

  @@unique([identityId, idempotencyKey])
  @@index([identityId])
  @@index([identityId, phase])
  @@map("reliable_account_closure_operations")
}

/// 运维审计日志 (W7)：记录谁何时对哪个 operation 做了什么（query / replay）。
/// 跨模块共享：Reminder / Notification / Schedule rebuild / Account closure / Knowledge projection
/// 的最小权限查询与 replay 操作都必须写审计记录，禁止静默操作。
model OperationAuditLog {
  id              String   @id @default(uuid())
  actorIdentityId String   @map("actor_identity_id")
  source          String
  operationId     String   @map("operation_id")
  action          String
  details         String?
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([actorIdentityId, createdAt])
  @@index([source, operationId])
  @@index([createdAt])
  @@map("reliable_operation_audit_logs")
}

// ==========================================
// Reminder Module
// 提醒模板、实例、分组、历史、统计、响应
// ==========================================

model ReminderTemplate {
  id                 String    @id
  identityId         String    @map("identity_id")
  name               String
  description        String?
  type               String
  selfEnabled        Boolean   @map("self_enabled")
  status             String
  importanceLevel    String    @map("importance_level")
  tags               String
  color              String?
  icon               String?
  nextTriggerAt      DateTime? @map("next_trigger_at")
  version            Int       @default(1)
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")
  trigger            String
  recurrence         String?
  activeTime         String    @map("active_time")
  activeHours        String?   @map("active_hours")
  notificationConfig String    @map("notification_config")
  stats              String

  // Smart Frequency: Response Metrics
  clickRate          Float?    @map("click_rate")
  ignoreRate         Float?    @map("ignore_rate")
  avgResponseTime    Int?      @map("avg_response_time")
  snoozeCount        Int       @default(0) @map("snooze_count")
  effectivenessScore Float?    @map("effectiveness_score")
  sampleSize         Int       @default(0) @map("sample_size")
  lastAnalysisTime   DateTime? @map("last_analysis_time")

  // Smart Frequency: Frequency Adjustment
  originalInterval      Int?      @map("original_interval")
  adjustedInterval      Int?      @map("adjusted_interval")
  adjustmentReason      String?   @map("adjustment_reason")
  adjustmentTime        DateTime? @map("adjustment_time")
  isAutoAdjusted        Boolean   @default(false) @map("is_auto_adjusted")
  userConfirmed         Boolean   @default(false) @map("user_confirmed")
  smartFrequencyEnabled Boolean   @default(true) @map("smart_frequency_enabled")

  history     ReminderHistory[]
  instances   ReminderInstance[]
  responses   ReminderResponse[]
  occurrences ReminderOccurrence[]
  account     Account              @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("reminder_templates")
}

model ReminderGroup {
  id          String    @id
  identityId  String    @map("identity_id")
  name        String
  description String?
  color       String?
  icon        String?
  enabled     Boolean
  status      String
  order       Int
  stats       String
  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  account Account @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId])
  @@map("reminder_groups")
}

model ReminderInstance {
  id          String    @id
  templateId  String    @map("template_id")
  identityId  String    @map("identity_id")
  triggerAt   DateTime  @map("trigger_at")
  status      String
  result      String?
  processedAt DateTime? @map("processed_at")
  note        String?
  payload     String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  account  Account          @relation(fields: [identityId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  template ReminderTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([triggerAt])
  @@map("reminder_instances")
}

model ReminderHistory {
  id                  String   @id
  identityId          String   @map("identity_id")
  templateId          String   @map("template_id")
  triggeredAt         DateTime @map("triggered_at")
  result              String
  error               String?
  notificationSent    Boolean  @map("notification_sent")
  notificationChannel String?
  createdAt           DateTime @default(now()) @map("created_at")

  identity Account          @relation("AccountReminderHistory", fields: [identityId], references: [id])
  template ReminderTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([identityId])
  @@index([templateId])
  @@map("reminder_history")
}

model ReminderStatistic {
  id            String   @id
  identityId    String   @unique @map("identity_id")
  templateStats String   @map("template_stats")
  groupStats    String   @map("group_stats")
  triggerStats  String   @map("trigger_stats")
  calculatedAt  DateTime @map("calculated_at")

  account Account @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId])
  @@map("reminder_statistics")
}

model ReminderResponse {
  id           String   @id @default(uuid())
  identityId   String   @map("identity_id")
  templateId   String   @map("template_id")
  action       String // clicked, ignored, snoozed, dismissed, completed
  responseTime Int?     @map("response_time") // seconds
  timestamp    DateTime
  createdAt    DateTime @default(now()) @map("created_at")

  identity Account          @relation("AccountReminderResponses", fields: [identityId], references: [id])
  template ReminderTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([identityId])
  @@index([templateId, timestamp(sort: Desc)])
  @@map("reminder_responses")
}

/// UserReminderPreference 聚合根 - 用户提醒偏好
/// 存储用户的最佳/最差响应时间段和智能频率配置
model UserReminderPreference {
  // ============ 主键与外键 ============
  id         String @id
  identityId String @unique @map("identity_id")

  // ============ 时间段偏好 ============
  bestTimeSlots  String @map("best_time_slots") /// JSON: TimeSlotDTO[]
  worstTimeSlots String @map("worst_time_slots") /// JSON: TimeSlotDTO[]

  // ============ 智能频率 ============
  globalReminderEnabled Boolean @default(true) @map("global_reminder_enabled")
  globalSmartFrequency  Boolean @default(true) @map("global_smart_frequency")

  // ============ 审计 ============
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // ============ 关系映射 ============
  account Account @relation(fields: [identityId], references: [id], onDelete: Cascade)

  // ============ 索引优化 ============
  @@index([identityId])
  @@map("user_reminder_preferences")
}

/// ReminderOccurrence 触发实例/投递意图（W1: LeaseClaim 与 durable receipt）
model ReminderOccurrence {
  id                  String    @id
  identityId          String    @map("identity_id")
  templateId          String    @map("template_id")
  source              String    @default("reminder")
  occurrenceKey       String    @map("occurrence_key")
  idempotencyKey      String    @unique @map("idempotency_key")
  status              String
  attempt             Int       @default(0)
  ownerToken          String?   @map("owner_token")
  claimId             String?   @map("claim_id")
  fencingToken        Int       @default(0) @map("fencing_token")
  leaseExpiresAt      DateTime? @map("lease_expires_at")
  lastHeartbeatAt     DateTime? @map("last_heartbeat_at")
  heartbeatIntervalMs Int?      @map("heartbeat_interval_ms")
  lastError           String?   @map("last_error")
  nextRetryAt         DateTime? @map("next_retry_at")
  deadLetterAt        DateTime? @map("dead_letter_at")
  correlationId       String?   @map("correlation_id")
  causationId         String?   @map("causation_id")
  attemptsHistoryJson String?   @map("attempts_history_json")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  finishedAt          DateTime? @map("finished_at")

  template ReminderTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  account  Account          @relation("AccountReminderOccurrences", fields: [identityId], references: [id])

  @@unique([templateId, occurrenceKey])
  @@index([identityId])
  @@index([status])
  @@index([leaseExpiresAt])
  @@map("reminder_occurrences")
}

// ==========================================
// Routine Coach vNext — first-class domain truth
// Legacy Reminder runtime tables above remain for reliability/cutover.
// ==========================================

model RoutineDefinition {
  id          String   @id
  identityId  String   @map("identity_id")
  name        String
  description String?
  enabled     Boolean  @default(true)
  triggerJson String?  @map("trigger_json")
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  account           Account                    @relation(fields: [identityId], references: [id], onDelete: Cascade)
  memberships       RoutineProfileMembership[]
  occurrences       RoutineOccurrence[]
  temporaryOverride RoutineTemporaryOverride?

  @@unique([identityId, id])
  @@index([identityId, enabled])
  @@map("routine_definitions")
}

model RoutineProfile {
  id          String   @id
  identityId  String   @map("identity_id")
  name        String
  description String?
  enabled     Boolean  @default(true)
  active      Boolean  @default(false)
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  account     Account                    @relation(fields: [identityId], references: [id], onDelete: Cascade)
  memberships RoutineProfileMembership[]

  @@unique([identityId, id])
  @@index([identityId, enabled, active])
  @@map("routine_profiles")
}

model RoutineProfileMembership {
  identityId String   @map("identity_id")
  profileId  String   @map("profile_id")
  routineId  String   @map("routine_id")
  enabled    Boolean  @default(true)
  version    Int      @default(1)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  account Account           @relation(fields: [identityId], references: [id], onDelete: Cascade)
  profile RoutineProfile    @relation(fields: [profileId, identityId], references: [id, identityId], onDelete: Cascade)
  routine RoutineDefinition @relation(fields: [routineId, identityId], references: [id, identityId], onDelete: Cascade)

  @@id([identityId, profileId, routineId])
  @@index([identityId, routineId])
  @@index([identityId, profileId])
  @@map("routine_profile_memberships")
}

model RoutineProtocolDefinition {
  id             String   @id
  identityId     String   @map("identity_id")
  name           String
  definitionJson String   @map("definition_json")
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  account  Account                  @relation(fields: [identityId], references: [id], onDelete: Cascade)
  sessions RoutineProtocolSession[]

  @@unique([identityId, id])
  @@index([identityId, name])
  @@map("routine_protocol_definitions")
}

model RoutineProtocolSession {
  id                String    @id
  identityId        String    @map("identity_id")
  protocolId        String    @map("protocol_id")
  protocolVersion   Int       @map("protocol_version")
  status            String
  snapshotJson      String    @map("snapshot_json")
  terminationReason String?   @map("termination_reason")
  endedAt           DateTime? @map("ended_at")
  version           Int       @default(1)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  account  Account                   @relation(fields: [identityId], references: [id], onDelete: Cascade)
  protocol RoutineProtocolDefinition @relation(fields: [protocolId, identityId], references: [id, identityId], onDelete: Restrict)

  @@index([identityId, status])
  @@index([identityId, protocolId, createdAt])
  @@map("routine_protocol_sessions")
}

/// RoutineOccurrence durable occurrence fence for the ROUTINE-3401 wall-clock lane.
/// Mirrors the protected ReminderOccurrence lease-claim contract (ADR-059 §10)
/// keyed by the canonical occurrenceKey so crash/retry replay is idempotent.
model RoutineOccurrence {
  id               String    @id
  identityId       String    @map("identity_id")
  routineId        String    @map("routine_id")
  source           String    @default("routine")
  occurrenceKey    String    @map("occurrence_key")
  scheduledFor     DateTime  @map("scheduled_for")
  sourceRevision   String?   @map("source_revision")
  idempotencyKey   String    @unique @map("idempotency_key")
  status           String
  attempt          Int       @default(0)
  ownerToken       String?   @map("owner_token")
  claimId          String?   @map("claim_id")
  fencingToken     Int       @default(0) @map("fencing_token")
  leaseExpiresAt   DateTime? @map("lease_expires_at")
  lastError        String?   @map("last_error")
  nextRetryAt      DateTime? @map("next_retry_at")
  deadLetterAt     DateTime? @map("dead_letter_at")
  correlationId    String?   @map("correlation_id")
  causationId      String?   @map("causation_id")
  historyJson      String?   @map("history_json")
  nextOccurrenceAt DateTime? @map("next_occurrence_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  finishedAt       DateTime? @map("finished_at")

  routine RoutineDefinition @relation(fields: [routineId, identityId], references: [id, identityId], onDelete: Cascade)
  account Account           @relation("AccountRoutineOccurrences", fields: [identityId], references: [id])

  @@unique([identityId, routineId, occurrenceKey])
  @@index([identityId])
  @@index([status])
  @@index([leaseExpiresAt])
  @@map("routine_occurrences")
}

/// ROUTINE-3401 durable snooze/suppress state for the routine wall-clock lane.
/// Temporary override is runtime state kept separate from long-lived trigger
/// config so a snooze never rewrites `trigger_json` (ADR-059 §6). One row per
/// routine; the decoded payload uses the W2 trigger-parity codec.
model RoutineTemporaryOverride {
  identityId   String   @map("identity_id")
  routineId    String   @map("routine_id")
  overrideJson String   @map("override_json")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  routine RoutineDefinition @relation(fields: [routineId, identityId], references: [id, identityId], onDelete: Cascade)
  account Account           @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@id([identityId, routineId])
  @@unique([routineId, identityId])
  @@map("routine_temporary_overrides")
}

// ==========================================
// Repository Module
// 仓库聚合根、资源、文件夹、浏览器、统计
// ==========================================

model Repository {
  id             String    @id
  identityId     String    @map("identity_id")
  name           String
  type           String
  path           String
  description    String?
  config         Json      @default("{}") // RepositoryConfig JSONB
  stats          Json      @default("{}") // RepositoryStats JSONB
  relatedGoals   String?   @map("related_goals")
  status         String    @default("ACTIVE") // ACTIVE | ARCHIVED | DELETED
  git            String?
  syncStatus     String?   @map("sync_status")
  lastAccessedAt DateTime? @map("last_accessed_at")
  version        Int       @default(1)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  account             Account              @relation(fields: [identityId], references: [id], onDelete: Cascade)
  explorers           RepositoryExplorer[]
  repositoryResources RepositoryResource[]
  resources           Resource[]
  folders             Folder[]

  @@unique([identityId, path])
  @@index([type])
  @@index([status])
  @@map("repositories")
}

model Folder {
  id           String   @id
  identityId   String   @map("identity_id")
  repositoryId String   @map("repository_id")
  parentId     String?  @map("parent_id")
  name         String
  path         String // Auto-generated: /parent/name
  order        Int      @default(0)
  isExpanded   Boolean  @default(true) @map("is_expanded")
  metadata     Json     @default("{}") // FolderMetadata JSONB
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  identity   Account    @relation("AccountFolders", fields: [identityId], references: [id])
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  parent     Folder?    @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children   Folder[]   @relation("FolderHierarchy")

  @@unique([repositoryId, parentId, name])
  @@index([identityId])
  @@index([repositoryId])
  @@index([parentId])
  @@index([path])
  @@map("folders")
}

model Resource {
  id           String    @id
  identityId   String    @map("identity_id")
  repositoryId String    @map("repository_id")
  folderId     String?   @map("folder_id")
  name         String
  type         String // markdown | image | video | audio | pdf | link | code | other
  path         String
  size         Int       @default(0)
  content      String?   @db.Text
  metadata     Json      @default("{}") // ResourceMetadata
  stats        Json      @default("{}") // ResourceStats
  description  String?
  author       String?
  version      String?
  tags         String    @default("[]") // JSON array
  category     String?
  status       String    @default("ACTIVE") // ACTIVE | ARCHIVED | DELETED | DRAFT
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  modifiedAt   DateTime? @map("modified_at")
  deletedAt    DateTime? @map("deleted_at")

  identity   Account    @relation("AccountResources", fields: [identityId], references: [id])
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([identityId])
  @@index([repositoryId])
  @@index([folderId])
  @@index([type])
  @@index([status])
  @@index([category])
  @@index([createdAt])
  @@map("resources")
}

model RepositoryResource {
  id           String    @id
  identityId   String    @map("identity_id")
  repositoryId String    @map("repository_id")
  name         String
  type         String
  path         String
  size         Int?
  description  String?
  author       String?
  version      String?
  tags         String?
  category     String?
  status       String    @default("active")
  metadata     String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  modifiedAt   DateTime? @map("modified_at")

  linkedContents LinkedContent[]
  identity       Account             @relation("AccountRepositoryResources", fields: [identityId], references: [id])
  repository     Repository          @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  sourceRefs     ResourceReference[] @relation("SourceResourceRefs")
  targetRefs     ResourceReference[] @relation("TargetResourceRefs")

  @@unique([repositoryId, path])
  @@index([identityId])
  @@index([type])
  @@map("repository_resources")
}

model LinkedContent {
  id            String    @id
  resourceId    String    @map("resource_id")
  title         String
  url           String
  contentType   String    @map("content_type")
  description   String?
  thumbnail     String?
  author        String?
  publishedAt   DateTime? @map("published_at")
  isAccessible  Boolean   @default(true) @map("is_accessible")
  lastCheckedAt DateTime? @map("last_checked_at")
  cachedAt      DateTime? @map("cached_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  repositoryResource RepositoryResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([url])
  @@map("linked_contents")
}

model ResourceReference {
  id               String    @id
  sourceResourceId String    @map("source_resource_id")
  targetResourceId String    @map("target_resource_id")
  referenceType    String    @map("reference_type")
  description      String?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  lastVerifiedAt   DateTime? @map("last_verified_at")

  sourceResource RepositoryResource @relation("SourceResourceRefs", fields: [sourceResourceId], references: [id], onDelete: Cascade)
  targetResource RepositoryResource @relation("TargetResourceRefs", fields: [targetResourceId], references: [id], onDelete: Cascade)

  @@unique([sourceResourceId, targetResourceId, referenceType])
  @@index([targetResourceId])
  @@map("resource_references")
}

model RepositoryExplorer {
  id           String    @id
  repositoryId String    @map("repository_id")
  identityId   String    @map("identity_id")
  name         String
  description  String?
  currentPath  String    @map("current_path")
  filters      String?
  viewConfig   String?   @map("view_config")
  pinnedPaths  String?   @map("pinned_paths")
  recentPaths  String?   @map("recent_paths")
  lastScanAt   DateTime? @map("last_scan_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  account    Account    @relation(fields: [identityId], references: [id], onDelete: Cascade)
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, identityId])
  @@index([repositoryId])
  @@map("repository_explorers")
}

model RepositoryStatistic {
  id                   Int      @id @default(autoincrement())
  identityId           String   @unique @map("identity_id")
  totalRepositories    Int      @default(0) @map("total_repositories")
  activeRepositories   Int      @default(0) @map("active_repositories")
  archivedRepositories Int      @default(0) @map("archived_repositories")
  totalResources       Int      @default(0) @map("total_resources")
  totalFiles           Int      @default(0) @map("total_files")
  totalFolders         Int      @default(0) @map("total_folders")
  gitEnabledRepos      Int      @default(0) @map("git_enabled_repos")
  totalCommits         Int      @default(0) @map("total_commits")
  totalReferences      Int      @default(0) @map("total_references")
  totalLinkedContents  Int      @default(0) @map("total_linked_contents")
  totalSizeBytes       BigInt   @default(0) @map("total_size_bytes")
  lastUpdatedAt        DateTime @default(now()) @map("last_updated_at")
  createdAt            DateTime @default(now()) @map("created_at")

  account Account @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId])
  @@map("repository_statistics")
}

/// Short-lived, identity-bound GitHub App installation orchestration intent.
/// Only a SHA-256 hash of the provider state is persisted; no raw state or token is stored.
model KnowledgeRepositoryInstallationIntent {
  id                 String    @id
  identityId         String    @map("identity_id")
  stateHash          String    @unique @map("state_hash")
  routeKey           String    @map("route_key")
  clientKind         String    @map("client_kind")
  returnPath         String    @map("return_path")
  status             String    @default("Pending")
  installationId     String?   @map("installation_id")
  providerAccountId  String?   @map("provider_account_id")
  setupAction        String?   @map("setup_action")
  expiresAt          DateTime  @map("expires_at")
  callbackReceivedAt DateTime? @map("callback_received_at")
  finalizedAt        DateTime? @map("finalized_at")
  consumedAt         DateTime? @map("consumed_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  account Account @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId, status])
  @@index([installationId, status])
  @@index([expiresAt])
  @@map("knowledge_repository_installation_intents")
}

/// GitHub App installation bound to one explicitly selected knowledge repository.
/// This authorization is independent from AuthOAuthBinding login credentials.
model KnowledgeRepositoryConnection {
  id                       String    @id
  identityId               String    @map("identity_id")
  githubUserId             String    @map("github_user_id")
  githubRepositoryId       String    @map("github_repository_id")
  githubRepositoryFullName String    @map("github_repository_full_name")
  installationId           String    @map("installation_id")
  defaultBranch            String    @default("main") @map("default_branch")
  isPrivate                Boolean   @default(true) @map("is_private")
  status                   String    @default("PENDING_INSTALL")
  lastSyncedCommitSha      String?   @map("last_synced_commit_sha")
  lastProjectedCommitSha   String?   @map("last_projected_commit_sha")
  lastErrorCode            String?   @map("last_error_code")
  lastErrorMessage         String?   @map("last_error_message")
  version                  Int       @default(1)
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")
  deletedAt                DateTime? @map("deleted_at")

  account                 Account                           @relation(fields: [identityId], references: [id], onDelete: Cascade)
  webhookDeliveries       GithubWebhookDelivery[]
  noteProjections         KnowledgeNoteProjection[]
  attachmentProjections   KnowledgeAttachmentProjection[]
  attachmentContentCaches KnowledgeAttachmentContentCache[]
  writeRequests           KnowledgeWriteRequest[]

  @@unique([identityId, githubRepositoryId])
  @@unique([githubRepositoryId])
  @@index([identityId, status])
  @@index([installationId])
  @@map("knowledge_repository_connections")
}

/// Deduplication and processing cursor for GitHub webhook deliveries.
model GithubWebhookDelivery {
  id           String    @id
  connectionId String    @map("connection_id")
  deliveryId   String    @unique @map("delivery_id")
  eventName    String    @map("event_name")
  beforeSha    String?   @map("before_sha")
  afterSha     String?   @map("after_sha")
  forced       Boolean   @default(false)
  status       String    @default("RECEIVED")
  errorMessage String?   @map("error_message")
  receivedAt   DateTime  @default(now()) @map("received_at")
  processedAt  DateTime? @map("processed_at")

  connection KnowledgeRepositoryConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, status])
  @@map("github_webhook_deliveries")
}

/// Rebuildable read model derived only from the connected repository default branch.
model KnowledgeNoteProjection {
  id              String    @id
  connectionId    String    @map("connection_id")
  relativePath    String    @map("relative_path")
  commitSha       String    @map("commit_sha")
  blobSha         String    @map("blob_sha")
  contentHash     String    @map("content_hash")
  frontmatter     Json      @default("{}")
  markdownContent String    @map("markdown_content") @db.Text
  indexStatus     String    @default("PENDING") @map("index_status")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  connection KnowledgeRepositoryConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, relativePath])
  @@index([connectionId, commitSha])
  @@index([contentHash])
  @@index([indexStatus])
  @@map("knowledge_note_projections")
}

model KnowledgeAttachmentProjection {
  id           String    @id
  connectionId String    @map("connection_id")
  relativePath String    @map("relative_path")
  commitSha    String    @map("commit_sha")
  blobSha      String    @map("blob_sha")
  byteSize     Int?      @map("byte_size")
  mediaType    String    @map("media_type")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  connection KnowledgeRepositoryConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, relativePath])
  @@index([connectionId, commitSha])
  @@index([blobSha])
  @@map("knowledge_attachment_projections")
}

/// Short-lived shared cache for immutable GitHub attachment bytes.
model KnowledgeAttachmentContentCache {
  connectionId String   @map("connection_id")
  blobSha      String   @map("blob_sha")
  byteSize     Int      @map("byte_size")
  contentBytes Bytes    @map("content_bytes")
  cachedAt     DateTime @default(now()) @map("cached_at")
  expiresAt    DateTime @map("expires_at")

  connection KnowledgeRepositoryConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@id([connectionId, blobSha])
  @@index([expiresAt])
  @@map("knowledge_attachment_content_cache")
}

/// Idempotency ledger for confirmed Web note creation requests.
/// The Git commit state (`status`/`commitSha`) and the projection operation
/// state (`projectionStatus`/`projectionError*`/`projectedAt`) are tracked
/// separately so a Committed note whose projection is pending/failed stays
/// visible and replayable instead of being conflated with the commit result.
model KnowledgeWriteRequest {
  id                     String    @id
  identityId             String    @map("identity_id")
  connectionId           String    @map("connection_id")
  requestId              String    @map("request_id")
  requestHash            String    @map("request_hash")
  relativePath           String    @map("relative_path")
  status                 String    @default("PENDING")
  commitSha              String?   @map("commit_sha")
  errorCode              String?   @map("error_code")
  errorMessage           String?   @map("error_message")
  projectionStatus       String    @default("PENDING") @map("projection_status")
  projectionErrorCode    String?   @map("projection_error_code")
  projectionErrorMessage String?   @map("projection_error_message")
  projectionAttempts     Int       @default(0) @map("projection_attempts")
  projectedAt            DateTime? @map("projected_at")
  blobSha                String?   @map("blob_sha")
  markdownContent        String?   @map("markdown_content") @db.Text
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")
  completedAt            DateTime? @map("completed_at")

  account    Account                       @relation(fields: [identityId], references: [id], onDelete: Cascade)
  connection KnowledgeRepositoryConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([identityId, requestId])
  @@index([connectionId, status])
  @@map("knowledge_write_requests")
}

/// Short-lived distributed worker ownership for rebuildable repository work.
model KnowledgeRepositoryLease {
  id         String   @id
  leaseKey   String   @unique @map("lease_key")
  ownerToken String   @map("owner_token")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([expiresAt])
  @@map("knowledge_repository_leases")
}

// ==========================================
// Schedule Module
// 日程聚合根、调度任务、调度作业、执行、统计
// ==========================================

model Schedule {
  id                   String   @id
  identityId           String   @map("identity_id")
  title                String
  description          String?
  startTime            DateTime @map("start_time")
  endTime              DateTime @map("end_time")
  duration             Int
  hasConflict          Boolean  @default(false) @map("has_conflict")
  conflictingSchedules String?  @map("conflicting_schedules")
  priority             Int?
  location             String?
  attendees            String?
  createdAt            DateTime @default(now()) @map("created_at")
  version              Int      @default(1)
  updatedAt            DateTime @updatedAt @map("updated_at")

  account Account @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([startTime, endTime])
  @@map("schedules")
}

model ScheduleTask {
  id                    String    @id
  identityId            String    @map("identity_id")
  name                  String
  description           String?
  sourceModule          String    @map("source_module")
  sourceEntityId        String    @map("source_entity_id")
  // ADR-061 neutral scheduling identity. Legacy projector rows remain NULL until migrated.
  schedulingKey         String?   @map("scheduling_key")
  ownerType             String?   @map("owner_type")
  ownerId               String?   @map("owner_id")
  handlerKey            String?   @map("handler_key")
  payloadVersion        Int?      @map("payload_version")
  sourceRevision        String?   @map("source_revision")
  status                String
  enabled               Boolean
  cronExpression        String?   @map("cron_expression")
  timezone              String
  startDate             DateTime? @map("start_date")
  endDate               DateTime? @map("end_date")
  maxExecutions         Int?      @map("max_executions")
  nextRunAt             DateTime? @map("next_run_at")
  lastRunAt             DateTime? @map("last_run_at")
  executionCount        Int       @default(0) @map("execution_count")
  lastExecutionStatus   String?   @map("last_execution_status")
  lastExecutionDuration Int?      @map("last_execution_duration")
  consecutiveFailures   Int       @default(0) @map("consecutive_failures")
  maxRetries            Int       @map("max_retries")
  initialDelayMs        Int       @map("initial_delay_ms")
  maxDelayMs            Int       @map("max_delay_ms")
  backoffMultiplier     Float     @map("backoff_multiplier")
  retryableStatuses     String    @default("[]") @map("retryable_statuses")
  payload               String?
  tags                  String    @default("[]")
  priority              String
  timeout               Int?
  version               Int       @default(1)
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  deletedAt             DateTime? @map("deleted_at")

  executions ScheduleExecution[]
  account    Account             @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@unique([identityId, ownerType, ownerId, schedulingKey], map: "schedule_tasks_owner_scheduling_key_unique")
  @@index([status])
  @@index([identityId, ownerType, ownerId], map: "schedule_tasks_owner_lookup_idx")
  @@map("schedule_tasks")
}

/// Durable evidence for one owner-level desired-state reconcile.
/// Successful rows are written inside the same transaction as ScheduleTask upsert/delete.
model SchedulingReconcileOperation {
  operationId      String   @id @map("operation_id")
  identityId       String   @map("identity_id")
  ownerType        String   @map("owner_type")
  ownerId          String   @map("owner_id")
  status           String
  desiredCount     Int      @map("desired_count")
  createdCount     Int      @map("created_count")
  updatedCount     Int      @map("updated_count")
  deletedCount     Int      @map("deleted_count")
  unchangedCount   Int      @map("unchanged_count")
  failureCode      String?  @map("failure_code")
  failureMessage   String?  @map("failure_message")
  failureRetryable Boolean? @map("failure_retryable")
  startedAt        DateTime @map("started_at")
  finishedAt       DateTime @map("finished_at")
  createdAt        DateTime @default(now()) @map("created_at")

  account Account @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId, ownerType, ownerId, finishedAt], map: "scheduling_reconcile_owner_history_idx")
  @@map("scheduling_reconcile_operations")
}

model ScheduleExecution {
  id            String   @id
  identityId    String   @map("identity_id")
  taskId        String   @map("task_id")
  executionTime DateTime @map("execution_time")
  status        String
  duration      Int?
  result        String?
  error         String?
  retryCount    Int      @default(0) @map("retry_count")
  createdAt     DateTime @default(now()) @map("created_at")

  identity Account      @relation("AccountScheduleExecutions", fields: [identityId], references: [id])
  task     ScheduleTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([identityId])
  @@index([taskId])
  @@map("schedule_executions")
}

model ScheduleStatistic {
  id                   Int      @id @default(autoincrement())
  identityId           String   @unique @map("identity_id")
  totalTasks           Int      @map("total_tasks")
  activeTasks          Int      @map("active_tasks")
  pausedTasks          Int      @map("paused_tasks")
  completedTasks       Int      @map("completed_tasks")
  cancelledTasks       Int      @map("cancelled_tasks")
  failedTasks          Int      @map("failed_tasks")
  totalExecutions      Int      @map("total_executions")
  successfulExecutions Int      @map("successful_executions")
  failedExecutions     Int      @map("failed_executions")
  skippedExecutions    Int      @map("skipped_executions")
  timeoutExecutions    Int      @map("timeout_executions")
  avgExecutionDuration Float    @map("avg_execution_duration")
  minExecutionDuration Float    @map("min_execution_duration")
  maxExecutionDuration Float    @map("max_execution_duration")
  moduleStatistics     String   @default("{}") @map("module_statistics")
  lastUpdatedAt        DateTime @map("last_updated_at")
  createdAt            DateTime @default(now()) @map("created_at")

  account Account @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId])
  @@map("schedule_statistics")
}

/// R3a：调度器宿主互斥租约（DB lease/heartbeat）。
/// 共享数据库的多个宿主（API 多实例、同库进程）通过本表互斥：
/// 只有成功 acquire 的宿主启动 ScheduleTaskQueue；其余宿主只消费读模型。
model ScheduleLease {
  id         String   @id
  leaseKey   String   @unique @map("lease_key")
  ownerToken String   @map("owner_token")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([expiresAt])
  @@map("schedule_leases")
}

model ScheduleRebuildOutbox {
  id             String    @id @default(uuid())
  identityId     String    @map("identity_id")
  scheduleId     String?   @map("schedule_id")
  startTime      DateTime  @map("start_time")
  endTime        DateTime  @map("end_time")
  sourceRevision Int       @default(1) @map("source_revision")
  idempotencyKey String?   @unique @map("idempotency_key")
  status         String    @default("pending")
  attempts       Int       @default(0)
  claimToken     String?   @map("claim_token")
  claimedAt      DateTime? @map("claimed_at")
  nextAttemptAt  DateTime? @map("next_attempt_at")
  lastError      String?   @map("last_error")
  processedAt    DateTime? @map("processed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([identityId, status])
  @@map("schedule_rebuild_outbox")
}

model ScheduleDomainEventOutbox {
  id             String    @id @default(uuid())
  identityId     String    @map("identity_id")
  scheduleId     String    @map("schedule_id")
  eventType      String    @map("event_type")
  payload        String
  status         String    @default("pending")
  attempts       Int       @default(0)
  claimToken     String?   @map("claim_token")
  claimedAt      DateTime? @map("claimed_at")
  nextAttemptAt  DateTime? @map("next_attempt_at")
  publishedAt    DateTime? @map("published_at")
  lastError      String?   @map("last_error")
  idempotencyKey String    @unique @map("idempotency_key")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([identityId, status])
  @@map("schedule_domain_event_outbox")
}

/// Durable consumer receipt for at-least-once domain-event delivery.
/// Consumers with side effects must record a receipt keyed by the envelope's
/// idempotencyKey inside their own durable transaction; the unique constraint
/// makes the dedup atomic under concurrency.
model ScheduleEventConsumerReceipt {
  id             String   @id @default(uuid())
  idempotencyKey String   @unique @map("idempotency_key")
  effectCount    Int      @default(0) @map("effect_count")
  consumedAt     DateTime @default(now()) @map("consumed_at")

  @@map("schedule_event_consumer_receipt")
}

/// Independent durable business side effect written by the schedule
/// delivery-log consumer (P1-1). The consumer commits the receipt
/// (ScheduleEventConsumerReceipt) and exactly one delivery-log row in the same
/// transaction; both carry their own unique idempotency_key so concurrent
/// duplicate delivery converges to exactly one of each.
model ScheduleEventDeliveryLog {
  id             String   @id @default(uuid())
  idempotencyKey String   @unique @map("idempotency_key")
  eventType      String   @map("event_type")
  aggregateId    String?  @map("aggregate_id")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([aggregateId])
  @@map("schedule_event_delivery_log")
}

// ==========================================
// Setting Module
// User settings with JSONB preferences storage
// ==========================================

model UserSetting {
  id          String   @id @default(uuid())
  identityId  String   @unique @map("identity_id")
  preferences Json     @default("{}")
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  account Account @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId])
  @@map("user_settings")
}

// ==========================================
// Task Module
// 任务计划、实例、历史、统计
// ==========================================

/// TaskTemplate 聚合根 - 任务模板
/// 管理任务的完整定义，包括时间配置、重复规则、提醒、Goal绑定等
model TaskTemplate {
  // ============ 主键与外键 ============
  id         String @id
  identityId String @map("identity_id")

  // ============ 基础信息 ============
  name             String
  description      String?
  status           String /// Task lifecycle: Active | Paused | Closed
  outcome          String    @default("Open") /// Open | Succeeded | Failed | Abandoned
  completionPolicy String    @default("AllowCorrection") @map("completion_policy")
  closedAt         DateTime? @map("closed_at")
  archivedAt       DateTime? @map("archived_at")
  abandonedReason  String?   @map("abandoned_reason")
  importance       String    @default("moderate") /// ImportanceLevel
  color            String?
  tags             String /// JSON: string[]

  // ============ 时间配置（展开值对象） ============
  timeConfigType            String?   @map("time_config_type")
  timeConfigStartTime       DateTime? @map("time_config_start_time")
  timeConfigEndTime         DateTime? @map("time_config_end_time")
  timeConfigDurationMinutes Int?      @map("time_config_duration_minutes")
  timeConfigTimePoint       Int?      @map("time_config_time_point") /// 时间点（分钟数，如 540 = 9:00）
  timeConfigTimeRangeStart  Int?      @map("time_config_time_range_start") /// 时间段开始（分钟数）
  timeConfigTimeRangeEnd    Int?      @map("time_config_time_range_end") /// 时间段结束（分钟数）

  // ============ 重复规则（展开值对象） ============
  recurrenceRuleType       String?   @map("recurrence_rule_type")
  recurrenceRuleInterval   Int?      @map("recurrence_rule_interval")
  recurrenceRuleDaysOfWeek String?   @map("recurrence_rule_days_of_week")
  recurrenceRuleEndDate    DateTime? @map("recurrence_rule_end_date")
  recurrenceRuleCount      Int?      @map("recurrence_rule_count")

  // ============ 提醒配置（展开值对象） ============
  reminderConfigEnabled           Boolean? @map("reminder_config_enabled")
  reminderConfigTimeOffsetMinutes Int?     @map("reminder_config_time_offset_minutes")
  reminderConfigUnit              String?  @map("reminder_config_unit")
  reminderConfigChannel           String?  @map("reminder_config_channel")

  // ============ 循环任务生成 ============
  lastGeneratedDate DateTime? @map("last_generated_date")
  generateAheadDays Int?      @map("generate_ahead_days")

  // ============ Goal 绑定（展开的关系值对象） ============
  goalId              String? @map("goal_id")
  keyResultId         String? @map("key_result_id")
  goalRecordValue     Float?  @map("goal_record_value")
  goalProgressTrigger String? @map("goal_progress_trigger")

  // ============ 检查列表（JSON值对象） ============
  checklist String? @map("checklist") /// JSON: ChecklistItemDefinition[]

  // ============ 版本与审计 ============
  version   Int       @default(1)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // ============ 关系映射 ============
  account   Account    @relation(fields: [identityId], references: [id], onDelete: Cascade)
  keyResult KeyResult? @relation("KeyResultTaskTemplates", fields: [keyResultId, goalId, identityId], references: [id, goalId, identityId], onDelete: Restrict)

  // 实例
  instances  TaskInstance[]
  history    TaskTemplateHistory[]
  labelLinks TaskLabel[]

  // ============ 索引优化 ============
  @@unique([id, identityId])
  @@index([identityId])
  @@index([status])
  @@index([importance])
  @@index([identityId, goalId, deletedAt])
  @@index([identityId, keyResultId, deletedAt])
  @@index([deletedAt])
  @@map("task_templates")
}

/// TaskInstance 聚合根 - 任务实例
/// 从模板生成的具体任务实例，包含执行状态和时间追踪
model TaskInstance {
  // ============ 主键与外键 ============
  id         String @id
  templateId String @map("template_id")
  identityId String @map("identity_id")

  // ============ 实例基本信息 ============
  instanceDate  DateTime @map("instance_date")
  occurrenceKey String?  @map("occurrence_key") /// R2-1 幂等键 templateId:localDate
  status        String /// TaskInstanceStatus
  importance    String   @default("moderate") /// ImportanceLevel

  // ============ 时间追踪 ============
  timeConfig      String    @map("time_config") /// JSON: TaskTimeConfigDTO
  actualStartTime DateTime? @map("actual_start_time")
  actualEndTime   DateTime? @map("actual_end_time")

  // ============ 备注 ============
  comment String? /// 实例备注

  // ============ 版本与审计 ============
  version   Int       @default(1)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // ============ 关系映射 ============
  account  Account      @relation(fields: [identityId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  template TaskTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  // R2-1：同一模板同一天最多一个实例（幂等键，防双宿主/并发重复生成）。
  @@unique([templateId, occurrenceKey])
  // ============ 索引优化 ============
  @@index([templateId, instanceDate])
  @@index([identityId, status])
  @@index([identityId, instanceDate])
  @@map("task_instances")
}

/// Durable delivery log for completed tasks that contribute Goal progress.
/// It is intentionally task-specific rather than a generic application outbox.
model TaskGoalOutbox {
  eventId        String    @id @map("event_id")
  identityId     String    @map("identity_id")
  taskInstanceId String    @map("task_instance_id")
  taskTemplateId String    @map("task_template_id")
  goalId         String    @map("goal_id")
  keyResultId    String    @map("key_result_id")
  payload        String
  action         String    @default("complete")
  status         String    @default("PENDING")
  attempts       Int       @default(0)
  availableAt    DateTime  @default(now()) @map("available_at")
  lastError      String?   @map("last_error")
  dispatchedAt   DateTime? @map("dispatched_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([identityId, status, availableAt])
  @@index([status, availableAt])
  @@index([taskInstanceId])
  @@map("task_goal_outbox")
}

model TaskTemplateHistory {
  id         String   @id
  identityId String   @map("identity_id")
  templateId String   @map("template_id")
  action     String
  changes    String?
  createdAt  DateTime @default(now()) @map("created_at")

  identity Account      @relation("AccountTaskTemplateHistory", fields: [identityId], references: [id])
  template TaskTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([identityId])
  @@index([templateId])
  @@map("task_template_history")
}

model TaskStatistic {
  id                       String   @id
  identityId               String   @unique @map("identity_id")
  calculatedAt             DateTime @map("calculated_at")
  templateTotal            Int      @map("template_total")
  templateActive           Int      @map("template_active")
  templatePaused           Int      @map("template_paused")
  templateArchived         Int      @map("template_archived")
  templateOneTime          Int      @map("template_one_time")
  templateRecurring        Int      @map("template_recurring")
  instanceTotal            Int      @map("instance_total")
  instanceToday            Int      @map("instance_today")
  instanceWeek             Int      @map("instance_week")
  instanceMonth            Int      @map("instance_month")
  instancePending          Int      @map("instance_pending")
  instanceInProgress       Int      @map("instance_in_progress")
  instanceCompleted        Int      @map("instance_completed")
  instanceSkipped          Int      @map("instance_skipped")
  instanceMissed           Int      @map("instance_missed")
  completionToday          Int      @map("completion_today")
  completionWeek           Int      @map("completion_week")
  completionMonth          Int      @map("completion_month")
  completionTotal          Int      @map("completion_total")
  completionAvgTime        Float?   @map("completion_avg_time")
  completionRate           Float    @map("completion_rate")
  timeAllDay               Int      @map("time_all_day")
  timePoint                Int      @map("time_point")
  timeRange                Int      @map("time_range")
  timeOverdue              Int      @map("time_overdue")
  timeUpcoming             Int      @map("time_upcoming")
  distributionByImportance String   @map("distribution_by_importance")
  distributionByUrgency    String   @map("distribution_by_urgency")
  distributionByTag        String   @map("distribution_by_tag")

  account Account @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId])
  @@map("task_statistics")
}

// ==========================================
// Wallet (R7 试点)
// 第一个外部模块：交易/预算/账户，与 Goal 通过 Relation 连接
// ==========================================

model WalletAccount {
  id         String   @id
  identityId String   @map("identity_id")
  name       String
  currency   String   @default("CNY")
  balance    Decimal  @default(0)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  account Account @relation(fields: [identityId], references: [id], onDelete: Cascade)

  transactions WalletTransaction[]

  @@index([identityId])
  @@map("wallet_accounts")
}

model WalletTransaction {
  id         String   @id
  accountId  String   @map("account_id")
  identityId String   @map("identity_id")
  type       String /// income | expense | transfer
  amount     Decimal
  category   String?
  note       String?
  goalId     String?  @map("goal_id") /// 与 Goal 的 relation（contributes_to）
  occurredAt DateTime @map("occurred_at")
  createdAt  DateTime @default(now()) @map("created_at")

  account          WalletAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  account_identity Account       @relation("AccountWalletTransactions", fields: [identityId], references: [id])

  @@index([identityId, occurredAt])
  @@map("wallet_transactions")
}
