{
  "name": "@memoflow/database",
  "version": "0.0.1",
  "description": "MemoFlow Shared Database Infrastructure — Prisma Schema, Client, and Connection Management",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./prisma": {
      "types": "./dist/generated/prisma/client.d.ts",
      "import": "./dist/generated/prisma/client.js",
      "default": "./dist/generated/prisma/client.js"
    }
  },
  "scripts": {
    "postinstall": "prisma generate --config ./prisma/prisma.config.ts && node ../../tools/build/normalize-generated-prisma.mjs"
  },
  "dependencies": {
    "@memoflow/utils": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@prisma/client-runtime-utils": "7.10.0",
    "dotenv": "^18.0.3",
    "dotenv-expand": "13.0.0",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "prisma": "7.10.0",
    "tsup": "^8.3.5",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "files": [
    "dist",
    "prisma"
  ],
  "sideEffects": false
}
