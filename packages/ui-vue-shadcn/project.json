{
  "name": "ui-vue-shadcn",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/ui-vue-shadcn/src",
  "tags": [
    "scope:ui",
    "type:vue",
    "type:shadcn",
    "layer:ui"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/packages/ui-vue-shadcn/dist"
      ],
      "dependsOn": [
        "^build"
      ],
      "options": {
        "command": "node ../../node_modules/vite/bin/vite.js build",
        "cwd": "packages/ui-vue-shadcn"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node ../../node_modules/vite/bin/vite.js build --watch",
        "cwd": "packages/ui-vue-shadcn"
      }
    },
    "storybook": {
      "executor": "nx:run-commands",
      "options": {
        "command": "storybook dev -p 4402 -c packages/ui-vue-shadcn/.storybook",
        "cwd": "."
      }
    },
    "storybook:build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "{workspaceRoot}/packages/*/src/**/*", "{workspaceRoot}/vite.workspace-aliases.ts", "{workspaceRoot}/pnpm-lock.yaml"],
      "outputs": ["{workspaceRoot}/dist/storybook"],
      "options": { "command": "storybook build -c packages/ui-vue-shadcn/.storybook -o dist/storybook --disable-telemetry", "cwd": "." }
    },
    "storybook:preview": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "vite preview --outDir dist/storybook --host 127.0.0.1 --port 4402 --strictPort", "cwd": "." }
    },
    "storybook:test": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "commands": [
          "node -e \"require('node:fs').mkdirSync('test-results',{recursive:true})\"",
          "test-storybook -c packages/ui-vue-shadcn/.storybook --url http://127.0.0.1:4402 --maxWorkers=1 --ci --includeTags ci-interaction --index-json --json --outputFile test-results/storybook-results.json",
          "node --input-type=module -e \"import {readFileSync} from 'node:fs'; import assert from 'node:assert/strict'; const r=JSON.parse(readFileSync('test-results/storybook-results.json','utf8')); assert.equal(r.success,true); assert.equal(r.numPassedTests,6); assert.equal(r.numTotalTests,6); assert.equal(r.numTotalTestSuites,2);\""
        ],
        "parallel": false,
        "cwd": "."
      }
    },
    "lint": {
      "options": {
        "args": [
          "**/*.{ts,tsx}"
        ]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node ../../node_modules/vue-tsc/bin/vue-tsc.js --noEmit -p tsconfig.typecheck.json",
        "cwd": "packages/ui-vue-shadcn"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "inputs": [
        "default",
        "^production"
      ],
      "cache": true,
      "options": {
        "command": "node ../../node_modules/vitest/vitest.mjs run --config vitest.config.ts",
        "cwd": "packages/ui-vue-shadcn"
      }
    },
    "test:watch": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node ../../node_modules/vitest/vitest.mjs --config vitest.config.ts",
        "cwd": "packages/ui-vue-shadcn"
      }
    }
  }
}
