{
  "name": "ui-vue-shadcn",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/ui-vue-shadcn/src",
  "tags": [
    "scope:ui",
    "type:vue",
    "type:shadcn",
    "layer:ui"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/packages/ui-vue-shadcn/dist"
      ],
      "dependsOn": [
        "^build"
      ],
      "options": {
        "command": "node ../../node_modules/vite/bin/vite.js build",
        "cwd": "packages/ui-vue-shadcn"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node ../../node_modules/vite/bin/vite.js build --watch",
        "cwd": "packages/ui-vue-shadcn"
      }
    },
    "storybook": {
      "executor": "nx:run-commands",
      "options": {
        "command": "storybook dev -p 4402 -c packages/ui-vue-shadcn/.storybook",
        "cwd": "."
      }
    },
    "lint": {
      "options": {
        "args": [
          "**/*.{ts,tsx}"
        ]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node ../../node_modules/vue-tsc/bin/vue-tsc.js --noEmit -p tsconfig.typecheck.json",
        "cwd": "packages/ui-vue-shadcn"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "inputs": [
        "default",
        "^production"
      ],
      "cache": true,
      "options": {
        "command": "node ../../node_modules/vitest/vitest.mjs run --config vitest.config.ts",
        "cwd": "packages/ui-vue-shadcn"
      }
    },
    "test:watch": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node ../../node_modules/vitest/vitest.mjs --config vitest.config.ts",
        "cwd": "packages/ui-vue-shadcn"
      }
    }
  }
}
