{
  "name": "@memoflow/contracts",
  "version": "0.0.1",
  "private": false,
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./primitives": {
      "types": "./dist/primitives/index.d.ts",
      "import": "./dist/primitives/index.js"
    },
    "./primitives/*": {
      "types": "./dist/primitives/*.d.ts",
      "import": "./dist/primitives/*.js"
    },
    "./repository": {
      "types": "./dist/modules/repository/index.d.ts",
      "import": "./dist/modules/repository/index.js"
    },
    "./account": {
      "types": "./dist/modules/account/index.d.ts",
      "import": "./dist/modules/account/index.js"
    },
    "./setting": {
      "types": "./dist/modules/setting/index.d.ts",
      "import": "./dist/modules/setting/index.js"
    },
    "./routine": {
      "types": "./dist/modules/routine/index.d.ts",
      "import": "./dist/modules/routine/index.js"
    },
    "./ai": {
      "types": "./dist/modules/ai/index.d.ts",
      "import": "./dist/modules/ai/index.js"
    },
    "./data-portability": {
      "types": "./dist/modules/data-portability/index.d.ts",
      "import": "./dist/modules/data-portability/index.js"
    },
    "./result": {
      "types": "./dist/result/index.d.ts",
      "import": "./dist/result/index.js"
    },
    "./shared": {
      "types": "./dist/shared/index.d.ts",
      "import": "./dist/shared/index.js"
    },
    "./electron": {
      "types": "./dist/electron/index.d.ts",
      "import": "./dist/electron/index.js"
    },
    "./cloud-auth": {
      "types": "./dist/cloud-auth.d.ts",
      "import": "./dist/cloud-auth.js"
    },
    "./mocks": {
      "types": "./dist/mocks/index.d.ts",
      "import": "./dist/mocks/index.js"
    },
    "./agent-gateway": {
      "types": "./dist/modules/agent-gateway/index.d.ts",
      "import": "./dist/modules/agent-gateway/index.js"
    }
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@memoflow/data-portability-contracts": "workspace:*",
    "@memoflow/desktop-contracts": "workspace:*",
    "@memoflow/goal-contracts": "workspace:*",
    "@memoflow/label-contracts": "workspace:*",
    "@memoflow/notification-contracts": "workspace:*",
    "@memoflow/schedule-contracts": "workspace:*",
    "@memoflow/shared-primitives": "workspace:*",
    "@memoflow/task-contracts": "workspace:*",
    "@memoflow/transport-contracts": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@faker-js/faker": "10.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "24.13.3",
    "concurrently": "^10.0.5",
    "rimraf": "^6.1.3",
    "tsup": "^8.3.5",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
}
