{
  "extends": "../../tsconfig.workspace-src.json",
  "compilerOptions": {
    // ============================================================
    // 路径和输出配置
    // ============================================================

    // 输出目录：编译后的 JavaScript 和类型声明文件


    // 源码根目录：限制编译范围


    // ============================================================
    // 纯 tsup 模式配置
    // ============================================================

    // 不使用 tsc 输出，由 tsup 统一处理 JS 和 DTS
    "noEmit": true,

    // 禁用增量编译（noEmit 时不能使用 incremental）
    "incremental": false,

    // ============================================================
    // 库环境配置（Domain Server 包）
    // ============================================================

    // 标准库：仅包含 ES2020（不包含 DOM）
    "lib": ["ES2020"],

    // 类型定义：包含 Node.js 和 Vitest 类型
    "types": ["node", "vitest/globals"],

    // ============================================================
    // 本地路径别名配置
    // ============================================================

    // 路径别名：包内导入走 @/
    "paths": {
      "@/*": ["./src/*"]
    }
  },

  // ============================================================
  // 包含和排除配置
  // ============================================================

  // 包含的文件 - 包含所有 TypeScript 文件
  "include": ["src",],

  // 排除的文件
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts"]
}
