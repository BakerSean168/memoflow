{
  "name": "@memoflow/patterns",
  "version": "0.0.1",
  "description": "Reusable design patterns and utilities for MemoFlow applications",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./scheduler": {
      "types": "./dist/scheduler/index.d.ts",
      "import": "./dist/scheduler/index.js"
    },
    "./repository": {
      "types": "./dist/repository/index.d.ts",
      "import": "./dist/repository/index.js"
    },
    "./cache": {
      "types": "./dist/cache/index.d.ts",
      "import": "./dist/cache/index.js"
    },
    "./events": {
      "types": "./dist/events/index.d.ts",
      "import": "./dist/events/index.js"
    },
    "./operations": {
      "types": "./dist/operations/index.d.ts",
      "import": "./dist/operations/index.js"
    },
    "./lease": {
      "types": "./dist/lease/index.d.ts",
      "import": "./dist/lease/index.js"
    }
  },
  "dependencies": {
    "@memoflow/contracts": "workspace:*",
    "@memoflow/utils": "workspace:*"
  },
  "devDependencies": {
    "@nx/vite": "23.2.1",
    "tsup": "^8.5.0",
    "vite": "8.3.1",
    "vitest": "4.1.11"
  }
}
