{
  "extends": "../../tsconfig.workspace-src.json",

  "compilerOptions": {
    // ============================================================
    // 路径和输出配置
    // ============================================================

    // ============================================================
    // 库环境配置（Governance Module 包）
    // ============================================================

    // 标准库：仅包含 ES2020（不包含 DOM）
    "lib": ["ES2020"],

    // 类型定义：包含 Node.js 和 Vitest 类型
    "types": ["node", "vitest/globals"],

    // ============================================================
    // 本地路径别名配置
    // ============================================================

    // 路径别名：仅用于包内部导入
    "paths": {
      "@/*": ["./src/*"],
      "@memoflow/contracts": ["../contracts/src/index.ts"],
      "@memoflow/contracts/*": [
        "../contracts/src/modules/*/index.ts",
        "../contracts/src/*/index.ts"
      ],
      "@memoflow/http-client": ["../http-client/src/index.ts"],
      "@memoflow/utils": ["../utils/src/index.ts"],
      "@memoflow/utils/*": ["../utils/src/*/index.ts"],
      "@memoflow/patterns": ["../patterns/src/index.ts"]
    }
  },

  // ============================================================
  // 包含和排除配置
  // ============================================================

  // 包含的文件 - 包含所有 TypeScript 文件
  "include": ["src"],

  // 排除的文件
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts"]
}
