{
  "extends": "../../tsconfig.workspace-src.json",
  "compilerOptions": {
    "lib": ["ES2020"],
    "noEmit": true,
    "types": ["node", "vitest/globals"],
    "paths": {
      "@/*": ["./src/*"],
      "@memoflow/database": ["../database/src/index.ts"],
      "@memoflow/http-client": ["../http-client/src/index.ts"],
      "@memoflow/schedule-contracts": ["../schedule-contracts/src/index.ts"],
      "@memoflow/schedule-contracts/*": ["../schedule-contracts/src/*.ts"],
      "@memoflow/goal-contracts": ["../goal-contracts/src/index.ts"],
      "@memoflow/task-contracts": ["../task-contracts/src/index.ts"],
      "@memoflow/task-contracts/*": ["../task-contracts/src/*.ts"],
      "@memoflow/operations-contracts": ["../operations-contracts/src/index.ts"],
      "@memoflow/operations-contracts/*": ["../operations-contracts/src/*.ts"],
      "@memoflow/test-utils": ["../test-utils/src/index.ts"],
      "@memoflow/test-utils/*": ["../test-utils/src/*", "../test-utils/src/*.ts"],
      "@memoflow/utils": ["../utils/src/index.ts"],
      "@memoflow/utils/result": ["../utils/src/result/index.ts"],
      "@memoflow/patterns": ["../patterns/src/index.ts"],
      "@memoflow/patterns/scheduler": ["../patterns/src/scheduler/index.ts"],
      "@memoflow/patterns/operations": ["../patterns/src/operations/index.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts"]
}
