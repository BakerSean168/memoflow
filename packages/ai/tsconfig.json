{
  "extends": "../../tsconfig.workspace-src.json",
  "compilerOptions": {
    "lib": ["ES2020"],
    "types": ["node", "vitest/globals"],
    "paths": {
      "@/*": ["./src/*"],
      "@memoflow/database": ["../database/src/index.ts"],
      "@memoflow/database/prisma": ["../database/src/generated/prisma/client.d.ts"],
      "@memoflow/http-client": ["../http-client/src/index.ts"],
      "@memoflow/ai-contracts": ["../ai-contracts/src/index.ts"],
      "@memoflow/desktop-contracts": ["../desktop-contracts/src/index.ts"],
      "@memoflow/goal-contracts": ["../goal-contracts/src/index.ts"],
      "@memoflow/repository-contracts": ["../../packages/repository-contracts/src/index.ts"],
      "@memoflow/transport-contracts": ["../transport-contracts/src/index.ts"],
      "@memoflow/transport-contracts/result": ["../transport-contracts/src/result/index.ts"],
      "@memoflow/time": ["../time/src/index.ts"],
      "@memoflow/utils": ["../utils/src/index.ts"],
      "@memoflow/utils/result": ["../utils/src/result/index.ts"],
      "@memoflow/ai-contracts/*": ["../ai-contracts/src/*.ts", "../ai-contracts/src/*/index.ts"],
      "@memoflow/ai-client": ["../ai-client/src/index.ts"],
      "@memoflow/ai-client/*": ["../ai-client/src/*.ts", "../ai-client/src/*/index.ts"],
      "@memoflow/desktop-contracts/*": [
        "../desktop-contracts/src/*.ts",
        "../desktop-contracts/src/*/index.ts"
      ]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts"]
}
