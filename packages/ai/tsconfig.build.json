{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": true,
    "noEmit": false,
    "rootDir": "./src",
    "outDir": "./dist",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.build.tsbuildinfo",
    "paths": {
      "@/*": ["./src/*"],
      "@memoflow/database": ["../database/dist/index.d.ts"],
      "@memoflow/database/prisma": ["../database/dist/generated/prisma/client.d.ts"],
      "@memoflow/http-client": ["../http-client/dist/index.d.ts"],
      "@memoflow/transport-contracts": ["../transport-contracts/dist/index.d.ts"],
      "@memoflow/transport-contracts/*": [
        "../transport-contracts/dist/*/index.d.ts",
        "../transport-contracts/dist/*.d.ts"
      ],
      "@memoflow/utils": ["../utils/dist/index.d.ts"],
      "@memoflow/utils/*": ["../utils/dist/*/index.d.ts", "../utils/dist/*.d.ts"],
      "@memoflow/ai-contracts": ["../ai-contracts/dist/index.d.ts"],
      "@memoflow/ai-contracts/*": [
        "../ai-contracts/dist/*.d.ts",
        "../ai-contracts/dist/*/index.d.ts"
      ],
      "@memoflow/ai-client": ["../ai-client/dist/index.d.ts"],
      "@memoflow/ai-client/*": ["../ai-client/dist/*.d.ts", "../ai-client/dist/*/index.d.ts"],
      "@memoflow/desktop-contracts": ["../desktop-contracts/dist/index.d.ts"],
      "@memoflow/desktop-contracts/*": [
        "../desktop-contracts/dist/*.d.ts",
        "../desktop-contracts/dist/*/index.d.ts"
      ]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts", "src/**/__tests__/**/*"]
}
