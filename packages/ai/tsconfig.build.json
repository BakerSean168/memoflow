{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": true,
    "noEmit": false,
    "rootDir": "./src",
    "outDir": "./dist",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.build.tsbuildinfo",
    "paths": {
      "@/*": ["./src/*"],
      "@memoflow/database": ["../database/dist/index.d.ts"],
      "@memoflow/database/prisma": ["../database/dist/generated/prisma/client.d.ts"],
      "@memoflow/http-client": ["../http-client/dist/index.d.ts"],
      "@memoflow/domain-shared": ["../domain-shared/dist/index.d.ts"],
      "@memoflow/domain-shared/shared": ["../domain-shared/dist/shared/index.d.ts"],
      "@memoflow/contracts": ["../contracts/dist/index.d.ts"],
      "@memoflow/contracts/*": [
        "../contracts/dist/modules/*/index.d.ts",
        "../contracts/dist/*/index.d.ts"
      ],
      "@memoflow/utils": ["../utils/dist/index.d.ts"],
      "@memoflow/utils/*": ["../utils/dist/*/index.d.ts", "../utils/dist/*.d.ts"],
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts", "src/**/__tests__/**/*"]
}
