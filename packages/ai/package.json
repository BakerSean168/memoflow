{
  "name": "@memoflow/ai",
  "version": "0.0.1",
  "description": "AI 模块 - 对话管理、内容生成、配额管理、提供商配置",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ports": {
      "types": "./dist/ports/index.d.ts",
      "import": "./dist/ports/index.js"
    },
    "./api": {
      "types": "./dist/api/index.d.ts",
      "import": "./dist/api/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./electron": {
      "types": "./dist/electron/index.d.ts",
      "import": "./dist/electron/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "scripts": {},
  "dependencies": {
    "@ai-sdk/openai-compatible-v6": "npm:@ai-sdk/openai-compatible@2.0.62",
    "@mastra/core": "1.60.0",
    "@mastra/libsql": "1.21.0",
    "@mastra/memory": "1.27.0",
    "@mastra/pg": "1.21.0",
    "@memoflow/contracts": "workspace:*",
    "@memoflow/database": "workspace:*",
    "@memoflow/domain-shared": "workspace:*",
    "@memoflow/http-client": "workspace:*",
    "@memoflow/ipc-client": "workspace:*",
    "@memoflow/repository": "workspace:*",
    "@memoflow/setting": "workspace:*",
    "@memoflow/time": "workspace:*",
    "@memoflow/utils": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "express": "^5.2.1",
    "undici": "^8.7.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.0"
  }
}
