# MemoFlow 测试环境配置
# =============================================================================
# 测试环境专用变量，避免依赖根 .env 中的可变配置
# =============================================================================

NODE_ENV=test
TZ=Asia/Shanghai
LOG_LEVEL=warn

# API
API_PORT=3000
API_HOST=0.0.0.0

# Test DB (matches docker-compose.yml test profile)
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=memoflow_test
DB_USER=test_user
DB_PASSWORD=test_pass
DATABASE_URL=postgresql://test_user:test_pass@127.0.0.1:5433/memoflow_test
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=5433
TEST_DB_NAME=memoflow_test
TEST_DB_USER=test_user
TEST_DB_PASS=test_pass
TEST_DATABASE_URL=postgresql://test_user:test_pass@127.0.0.1:5433/memoflow_test

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# JWT
JWT_SECRET=test-jwt-secret-not-for-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# CORS
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Web / Vite
VITE_APP_NAME=MemoFlow Web
VITE_API_BASE_URL=/api/v1
VITE_UPLOAD_BASE_URL=http://localhost:3000/api/v1/upload
VITE_LOG_LEVEL=warn
VITE_ENABLE_DEVTOOLS=false
VITE_ENABLE_MOCK_API=false

# Shared feature flags
UPLOAD_MAX_SIZE=10485760
ENABLE_DAILY_ANALYSIS=true
USE_PRIORITY_QUEUE_SCHEDULER=true
