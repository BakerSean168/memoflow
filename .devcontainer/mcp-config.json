{
  "mcpServers": {
    "nx-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "nx-mcp@latest"]
    },
    "playwright-mcp": {
      "command": "npx",
      "args": ["-y", "@automatalabs/playwright-mcp@latest"]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "@automatalabs/chrome-devtools-mcp@latest"]
    }
  }
}
