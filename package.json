{
  "name": "memoflow",
  "private": true,
  "author": {
    "name": "bakersean",
    "email": "lulouhao@stu.sicau.edu.cn"
  },
  "description": "MemoFlow Nx monorepo for desktop, web, api, and shared domain packages",
  "version": "0.10.0",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "postinstall": "node ./tools/mcp/ensure-nx-src-link.mjs",
    "// ========== Build ==========": "",
    "build": "pnpm nx run-many -t build --all",
    "build:api": "pnpm nx run api:build",
    "build:web": "pnpm nx run web:build",
    "build:desktop": "pnpm nx run desktop:build",
    "build:packages": "pnpm nx run-many -t build --all --exclude=api,web,desktop",
    "// ========== Type Checking ==========": "",
    "typecheck": "pnpm nx run-many -t typecheck --all --parallel=5",
    "typecheck:api": "pnpm nx run api:typecheck",
    "typecheck:web": "pnpm nx run web:typecheck",
    "typecheck:desktop": "pnpm nx run desktop:typecheck",
    "typecheck:affected": "pnpm nx affected -t typecheck",
    "// ========== Testing ==========": "",
    "test": "pnpm nx run-many -t test --all",
    "test:affected": "pnpm nx affected -t test",
    "test:unit": "pnpm nx run task:test",
    "test:smoke": "pnpm nx run api:test:smoke",
    "test:integration": "pnpm nx run-many -t test:integration --projects=task,goal,schedule,reminder --parallel=1",
    "test:integration:task": "pnpm nx run task:test:integration",
    "test:all": "pnpm nx run-many -t test --projects=task,api",
    "test:coverage:domain": "pnpm nx run-many -t test:coverage --projects=account,ai,cloud-auth,domain-shared,goal,governance,notification,reminder,schedule,setting,task",
    "test:coverage:affected": "pnpm nx affected -t test:coverage",
    "test:api": "pnpm nx run api:test",
    "test:web": "pnpm nx run web:test",
    "test:targets:sync": "pnpm nx g @memoflow/nx-test-system:sync-test-targets",
    "test:targets:check": "node ./tools/test/test-target-governance.mjs --check",
    "test:inventory": "node ./tools/test-system-v2/inventory.mjs",
    "test:inventory:check": "node ./tools/test-system-v2/inventory.mjs --check",
    "test:oracle": "node ./tools/test-system-v2/oracle.mjs",
    "ci:boundary:clean": "node ./tools/ci/run-clean-boundary.mjs",
    "ci:delivery:manifest": "node ./tools/ci-cd-platform/generate-delivery-manifest.mjs",
    "ci:delivery:check": "pnpm nx run ci-cd-platform:governance",
    "// ========== Documentation & Governance ==========": "",
    "docs:check": "pnpm nx run memoflow:docs-check",
    "governance:check": "pnpm nx run memoflow:governance-check",
    "identity:migrate": "node ./tools/governance/apply-product-identity.mjs",
    "identity:check": "node ./tools/governance/product-identity-audit.mjs",
    "// ========== Runtime lanes ==========": "",
    "runtime:preflight": "node ./tools/runtime/preflight.mjs",
    "runtime:preflight:e2e": "node ./tools/runtime/preflight.mjs --profile e2e",
    "runtime:preflight:host-dev": "node ./tools/runtime/preflight.mjs --profile host-dev",
    "runtime:preflight:local-docker": "node ./tools/runtime/preflight.mjs --profile local-docker",
    "// ========== E2E Testing ==========": "",
    "e2e": "node ./tools/runtime/preflight.mjs --profile e2e && pnpm nx run web:e2e",
    "e2e:ai-workspace": "pnpm nx run web:e2e:ai-workspace",
    "e2e:headed": "pnpm nx run web:e2e --configuration=headed",
    "e2e:debug": "pnpm nx run web:e2e --configuration=debug",
    "e2e:ui": "pnpm nx run web:e2e:ui",
    "// ========== Docker Database ==========": "",
    "docker:dev:up": "docker compose --profile dev up -d",
    "docker:dev:down": "docker compose --profile dev down",
    "docker:dev:logs": "docker compose --profile dev logs -f",
    "docker:dev:reset": "docker compose --profile dev down -v && docker compose --profile dev up -d",
    "docker:test:up": "docker compose --profile test up -d",
    "docker:test:down": "docker compose --profile test down",
    "docker:test:reset": "docker compose --profile test down && docker compose --profile test up -d",
    "docker:local:build-prep": "node ./tools/docker/local-compose.mjs build-prep",
    "docker:local:build-prep:rebuild": "node ./tools/docker/local-compose.mjs build-prep:rebuild",
    "docker:local:up": "node ./tools/docker/local-compose.mjs up",
    "docker:local:rebuild": "node ./tools/docker/local-compose.mjs rebuild",
    "docker:local:down": "node ./tools/docker/local-compose.mjs down",
    "docker:local:ps": "node ./tools/docker/local-compose.mjs ps",
    "docker:local:logs": "node ./tools/docker/local-compose.mjs logs",
    "docker:prod:build": "pwsh -File ./tools/docker/publish-images.ps1",
    "docker:prod:build:rebuild": "pwsh -File ./tools/docker/publish-images.ps1 -SkipNxCache",
    "docker:prod:push": "pwsh -File ./tools/docker/publish-images.ps1 -Push",
    "docker:prod:push:rebuild": "pwsh -File ./tools/docker/publish-images.ps1 -Push -SkipNxCache",
    "// ========== Code Quality ==========": "",
    "lint": "pnpm nx run-many -t lint --all --parallel=5",
    "lint:fix": "pnpm nx run-many -t lint --all --parallel=5 --fix",
    "lint:affected": "pnpm nx affected -t lint",
    "lint:api": "pnpm nx run api:lint",
    "lint:web": "pnpm nx run web:lint",
    "lint:desktop": "pnpm nx run desktop:lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "// ========== Nx Utilities ==========": "",
    "graph": "pnpm nx graph",
    "affected:build": "pnpm nx affected -t build",
    "affected:test": "pnpm nx affected -t test",
    "affected:lint": "pnpm nx affected -t lint",
    "affected:typecheck": "pnpm nx affected -t typecheck",
    "affected": "pnpm nx affected",
    "// ========== Maintenance ==========": "",
    "clean": "pnpm nx reset",
    "clean:deps": "pnpm -r exec rm -rf node_modules && rm -rf node_modules",
    "clean:dist": "pnpm nx run-many -t clean --all",
    "reset": "pnpm nx reset && pnpm clean:deps && pnpm install",
    "// ========== Package Management ==========": "",
    "install:all": "pnpm install",
    "update:deps": "pnpm update --latest --recursive",
    "check:deps": "pnpm outdated --recursive"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "@memoflow/contracts": "workspace:*",
    "@memoflow/patterns": "workspace:*",
    "@memoflow/utils": "workspace:*",
    "@prisma/client": "7.8.0",
    "@types/multer": "2.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@vueuse/core": "14.3.0",
    "argon2": "0.44.0",
    "cron-parser": "^5.4.0",
    "cronstrue": "^3.3.0",
    "dotenv-expand": "13.0.0",
    "echarts": "^6.1.0",
    "ioredis": "5.11.1",
    "mitt": "^3.0.1",
    "multer": "2.0.2",
    "node-cron": "^4.2.1",
    "node-schedule": "^2.1.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "vue-draggable-plus": "0.6.0",
    "vue-echarts": "^8.0.1",
    "zod": "4.4.3",
    "@memoflow/time": "workspace:*"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@electron/rebuild": "4.2.0",
    "@nx/eslint": "23.0.2",
    "@nx/eslint-plugin": "23.0.2",
    "@nx/js": "23.0.2",
    "@nx/storybook": "23.0.2",
    "@nx/vite": "23.0.2",
    "@nx/vitest": "23.0.2",
    "@nx/web": "23.0.2",
    "@nx/workspace": "23.0.2",
    "@nxlv/python": "22.2.1",
    "@playwright/test": "1.61.1",
    "@storybook/addon-docs": "^10.5.0",
    "@storybook/vue3": "^10.5.0",
    "@storybook/vue3-vite": "^10.5.0",
    "@swc-node/register": "~1.11.1",
    "@swc/core": "~1.15.43",
    "@swc/helpers": "~0.5.11",
    "@tailwindcss/vite": "4.3.2",
    "@testing-library/vue": "^8.1.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "24.13.3",
    "@types/node-schedule": "^2.1.8",
    "@types/pg": "8.16.0",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "@typescript-eslint/utils": "^8.63.0",
    "@vitejs/plugin-vue": "6.0.7",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "4.1.10",
    "@vue/test-utils": "^2.4.6",
    "eas-cli": "20.5.1",
    "electron": "43.1.0",
    "esbuild-plugin-vue": "0.2.4",
    "eslint": "^10.7.0",
    "eslint-plugin-storybook": "10.5.0",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.7.0",
    "happy-dom": "^20.10.6",
    "jiti": "2.4.2",
    "jscpd": "5.0.12",
    "jsdom": "^29.1.1",
    "jsonc-eslint-parser": "^3.1.0",
    "lodash-es": "^4.17.21",
    "madge": "8.0.0",
    "nx": "23.0.2",
    "nx-mcp": "0.25.0",
    "prettier": "^3.9.5",
    "prisma": "7.8.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sass-embedded": "^1.100.0",
    "shadcn-vue": "2.7.4",
    "storybook": "^10.5.0",
    "tailwindcss": "4.3.2",
    "tslib": "^2.8.1",
    "tsup": "^8.5.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.63.0",
    "verdaccio": "^6.0.5",
    "vite": "8.1.4",
    "vite-plugin-dts": "5.0.3",
    "vitest": "4.1.10",
    "vue-eslint-parser": "^10.3.0",
    "vue-tsc": "3.3.7"
  },
  "nx": {
    "includedScripts": [],
    "targets": {
      "test": {
        "options": {
          "command": "vitest run --project=!task-integration"
        }
      }
    }
  }
}
