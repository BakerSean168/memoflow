# =============================================================================
# MemoFlow Caddy 反向代理配置
# =============================================================================
# Caddy 自动申请和续期 Let's Encrypt HTTPS 证书。
# 主站域名通过 HTTPS 进入 Caddy，再转发到内部 Nginx (web:80)。
# 同步子域名通过 HTTPS 进入 Caddy，再转发到 PowerSync (powersync:{$POWERSYNC_PORT:8080})。
# Nginx 负责静态文件服务、SPA 路由和 /api/ 反向代理。
# =============================================================================

{
	# 全局配置
	email {$ACME_EMAIL:admin@bakersean.top}
	servers {
		# Only Cloudflare socket peers may supply a client address. Direct origin
		# requests use their socket address, regardless of spoofed headers.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		trusted_proxies_strict
		client_ip_headers CF-Connecting-IP
	}
}

{$APP_DOMAIN:memoflow.bakersean.top} {
	reverse_proxy web:80

	# 安全头（Caddy 层补充，Nginx 层也有）
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri delete
				request>headers>Referer delete
				resp_headers>Location delete
			}
		}
	}
}

{$LEGACY_DOMAIN:memoflow.bakersean.top} {
	reverse_proxy web:80

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri delete
				request>headers>Referer delete
				resp_headers>Location delete
			}
		}
	}
}

{$API_DOMAIN:memoflowapi.bakersean.top} {
	reverse_proxy api:3000 {
		header_up X-Forwarded-For {client_ip}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri delete
				request>headers>Referer delete
				resp_headers>Location delete
			}
		}
	}
}

{$POWERSYNC_DOMAIN:memoflowsync.bakersean.top} {
	reverse_proxy powersync:{$POWERSYNC_PORT:8080}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri delete
				request>headers>Referer delete
				resp_headers>Location delete
			}
		}
	}
}
