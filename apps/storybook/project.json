{
  "name": "ui-storybook",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/storybook",
  "tags": ["scope:ui", "type:app", "layer:app"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vue-tsc --noEmit -p apps/storybook/tsconfig.json",
        "cwd": "."
      },
      "dependsOn": ["^build"]
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/test/storybook-wsl-dev.mjs",
        "cwd": "."
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [],
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/packages/*/src/**/*",
        "{workspaceRoot}/vite.workspace-aliases.ts",
        "{workspaceRoot}/pnpm-lock.yaml"
      ],
      "outputs": ["{workspaceRoot}/dist/storybook"],
      "options": {
        "command": "storybook build -c apps/storybook/.storybook -o dist/storybook --disable-telemetry",
        "cwd": "."
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "vite preview --outDir dist/storybook --host 127.0.0.1 --port 4402 --strictPort",
        "cwd": "."
      }
    },
    "test:interaction": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node tools/test/run-storybook-browser.mjs",
        "cwd": "."
      }
    },
    "lint": {
      "options": {
        "args": ["**/*.{ts,tsx,js,jsx,vue}"]
      }
    }
  }
}
