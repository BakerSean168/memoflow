    "../../packages/app-vue/src/env.d.ts",
    "../../packages/goal-ui/src/components/dialogs/GoalRecordDialog.stories.ts",
    "../../packages/goal-ui/src/components/dialogs/KeyResultDialog.stories.ts",
    "../../packages/goal-ui/src/components/dialogs/goal-story-fixtures.ts",
    "../../packages/goal-ui/src/views/GoalDetailView.stories.ts",
    "../../packages/task-ui/src/components/dialogs/TaskCompletionMeasurementDialog.stories.ts",
    "../../packages/task-ui/src/components/dialogs/TaskOccurrenceInspectDialog.stories.ts",
    "../../packages/task-ui/src/components/dialogs/task-story-fixtures.ts",
    "../../packages/task-ui/src/views/TaskManagementView.stories.ts",
    "../../packages/schedule-ui/src/components/PlannerDayDialog.stories.ts",
    "../../packages/schedule-ui/src/views/ScheduleCalendarView.stories.ts",
    "../../packages/routine-ui/src/components/RoutineCapsulePreview.stories.ts",
    "../../packages/routine-ui/src/views/RoutineConfigurationView.stories.ts",
    "../../packages/repository-ui/src/components/KnowledgeCaptureReviewDialog.stories.ts",
    "../../packages/repository-ui/src/views/LocalVaultWorkspaceView.stories.ts",
    "../../packages/repository-ui/src/views/KnowledgeProjectionWorkspaceView.stories.ts",
    "../../packages/repository-ui/src/story-fixtures.ts"
  ],
  "exclude": []
}
