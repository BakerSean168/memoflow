{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/api/src",
  "tags": [
    "scope:api",
    "type:app",
    "layer:app"
  ],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "node ../../node_modules/tsx/dist/cli.mjs watch src/main.ts",
        "cwd": "apps/api"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/apps/api/dist"
      ],
      "dependsOn": [
        "^build"
      ],
      "options": {
        "command": "node ../../node_modules/tsup/dist/cli-default.js",
        "cwd": "apps/api"
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "options": {
        "command": "node ./dist/main.js",
        "cwd": "apps/api"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "inputs": [
        "default",
        "^production"
      ],
      "cache": true,
      "options": {
        "command": "node ./node_modules/vitest/vitest.mjs run --config apps/api/vitest.config.ts"
      }
    },
    "test:watch": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node ./node_modules/vitest/vitest.mjs --config apps/api/vitest.config.ts"
      }
    },
    "test:smoke": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}-smoke"
      ],
      "inputs": [
        "default",
        "^production"
      ],
      "cache": true,
      "options": {
        "command": "node ./node_modules/vitest/vitest.mjs run --config apps/api/vitest.smoke.config.ts"
      }
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        {
          "target": "build",
          "projects": [
            "relation"
          ]
        }
      ],
      "options": {
        "command": "node ./node_modules/vitest/vitest.mjs run --config apps/api/vitest.integration.config.ts"
      }
    },
    "lint": {
      "options": {
        "args": [
          "**/*.{ts,js}"
        ]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "target": "prisma-generate",
          "projects": [
            "database"
          ]
        },
        "^build"
      ],
      "options": {
        "command": "tsc --noEmit -p tsconfig.typecheck.json && tsc --noEmit -p tsconfig.typecheck.spec.json",
        "cwd": "apps/api"
      }
    },
    "prisma:migrate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm nx run database:prisma-migrate"
      }
    },
    "prisma:studio": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm nx run database:prisma-studio"
      }
    },
    "prisma:seed": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm nx run governance:seed"
      }
    },
    "db:push": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm nx run database:prisma-push"
      }
    },
    "docs:export": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node src/scripts/export-api-docs.js",
        "cwd": "apps/api"
      }
    },
    "docs:serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo API 文档访问地址: http://localhost:3888/api-docs",
        "cwd": "apps/api"
      }
    },
    "powersync:snapshot:publish": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node ../../node_modules/tsx/dist/cli.mjs scripts/publish-powersync-profile-snapshot.ts",
        "cwd": "apps/api"
      }
    },
    "powersync:snapshot:build": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node ../../node_modules/tsx/dist/cli.mjs scripts/build-powersync-profile-snapshot.ts",
        "cwd": "apps/api"
      }
    },
    "test:coverage": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "inputs": [
        "default",
        "^production"
      ],
      "cache": true,
      "options": {
        "command": "vitest run --coverage --config apps/api/vitest.config.ts"
      }
    },
    "test:ui": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "vitest --ui --config apps/api/vitest.config.ts"
      }
    },
    "lint:fix": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec eslint . --ext .ts,.tsx --fix",
        "cwd": "apps/api"
      }
    }
  }
}
