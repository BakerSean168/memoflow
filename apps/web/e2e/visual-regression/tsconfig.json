      ],
      "@memoflow/assets": ["../../../../packages/assets/src/index.ts"],
      "@memoflow/assets/audio": ["../../../../packages/assets/src/audio/index.ts"],
      "@memoflow/assets/images": ["../../../../packages/assets/src/images/index.ts"],
      "@memoflow/ui-vue-shadcn": ["../../../../packages/ui-vue-shadcn/dist/index.d.ts"],
      "@memoflow/ui-vue-shadcn/components/ui/*": [
        "../../../../packages/ui-vue-shadcn/dist/components/ui/*/index.d.ts"
      ],
      "@memoflow/ui-vue-shadcn/composables/*": [
        "../../../../packages/ui-vue-shadcn/dist/composables/*.d.ts"
      ],
      "@memoflow/ui-vue-shadcn/*": ["../../../../packages/ui-vue-shadcn/dist/*"],
      "@memoflow/http-client": ["../../../../packages/http-client/src/index.ts"],
      "@memoflow/ai-contracts/*": ["../../../../packages/ai-contracts/dist/*.d.ts"],
      "@memoflow/ai-client/*": ["../../../../packages/ai-client/dist/*.d.ts"],
      "@memoflow/ai-ui": ["../../../../packages/ai-ui/dist/index.d.ts"],
      "@memoflow/ai-ui/*": ["../../../../packages/ai-ui/dist/*.d.ts"],
      "@memoflow/ai-ui/host": ["../../../../packages/ai-ui/dist/ai-ui-host.d.ts"],
      "@memoflow/ai-ui/router": ["../../../../packages/ai-ui/dist/router/index.d.ts"],
      "@memoflow/ai-client": ["../../../../packages/ai-client/dist/index.d.ts"],
      "@memoflow/goal-client": ["../../../../packages/goal-client/dist/index.d.ts"],
      "@memoflow/schedule-client": ["../../../../packages/schedule-client/dist/index.d.ts"],
      "@memoflow/notification/client": ["../../../../packages/notification/dist/client/index.d.ts"],
      "@memoflow/routine-client": ["../../../../packages/routine-client/dist/index.d.ts"],
      "@memoflow/task-client": ["../../../../packages/task-client/dist/index.d.ts"],
      "@memoflow/repository-client": ["../../../../packages/repository-client/dist/index.d.ts"],
      "@memoflow/test-utils": ["../../../../packages/test-utils/src/index.ts"],
      "@memoflow/test-utils/*": [
        "../../../../packages/test-utils/src/*",
        "../../../../packages/test-utils/src/*.ts"
      ],
      "@memoflow/app-vue/*": ["../../../../packages/app-vue/src/*"]
    },
    "allowImportingTsExtensions": true
  },
  "include": [
    "*.ts",
    "../goal/reference/main.ts",
    "../task/visual-grammar/main.ts",
    "../schedule/presentation-authority/main.ts",
    "../../../../packages/app-vue/src/env.d.ts"
