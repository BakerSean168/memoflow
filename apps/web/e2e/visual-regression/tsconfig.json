{
  "extends": "../../../../tsconfig.workspace-src.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "types": ["node", "vite/client", "pinia-plugin-persistedstate"],
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "paths": {
      "@memoflow/contracts": ["../../../../packages/contracts/src/index.ts"],
      "@memoflow/contracts/account": [
        "../../../../packages/contracts/src/modules/account/index.ts"
      ],
      "@memoflow/ai-contracts": ["../../../../packages/ai-contracts/src/index.ts"],
      "@memoflow/goal-contracts": ["../../../../packages/goal-contracts/src/index.ts"],
      "@memoflow/notification-contracts": [
        "../../../../packages/notification-contracts/src/index.ts"
      ],
      "@memoflow/notification-contracts/*": [
        "../../../../packages/notification-contracts/src/*.ts"
      ],
      "@memoflow/contracts/primitives": ["../../../../packages/contracts/src/primitives/index.ts"],
      "@memoflow/repository-contracts": ["../../../../packages/repository-contracts/src/index.ts"],
      "@memoflow/contracts/result": ["../../../../packages/contracts/src/result/index.ts"],
