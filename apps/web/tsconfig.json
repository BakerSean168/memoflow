{
  // 继承基础配置
  "extends": "../../tsconfig.workspace-src.json",
  "compilerOptions": {
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["src/**/*", "env.d.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/*.bench.ts",
    "src/benchmarks/**/*",
    "src/modules/ai/**/*"
  ]
}
