{
  "extends": "../../tsconfig.workspace-src.json",
  "compilerOptions": {
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "paths": {
      "@memoflow/cloud-auth-contracts": ["../../packages/cloud-auth-contracts/src/index.ts"],
      "@memoflow/cloud-auth-contracts/*": ["../../packages/cloud-auth-contracts/src/*.ts"],
      "@memoflow/agent-gateway": ["../../packages/agent-gateway/src/index.ts"],
      "@memoflow/agent-gateway/*": ["../../packages/agent-gateway/src/*/index.ts"],
      "@/*": ["./src/*"],
      "@electron/*": ["./electron/*"],
      "@common/*": ["./common/*"],
      "@memoflow/app-vue": ["../../packages/app-vue/src/index.ts"],
      "@memoflow/goal-ui": ["../../packages/goal-ui/src/index.ts"],
      "@memoflow/goal-ui/host": ["../../packages/goal-ui/src/goal-ui-host.ts"],
      "@memoflow/notification-ui": ["../../packages/notification-ui/src/index.ts"],
      "@memoflow/notification-ui/host": [
        "../../packages/notification-ui/src/notification-ui-host.ts"
      ],
      "@memoflow/desktop-contracts": ["../../packages/desktop-contracts/src/index.ts"],
      "@memoflow/desktop-contracts/*": ["../../packages/desktop-contracts/src/*.ts"],
      "@memoflow/setting-ui": ["../../packages/setting-ui/src/index.ts"],
      "@memoflow/setting-ui/host": ["../../packages/setting-ui/src/setting-ui-host.ts"],
      "@memoflow/task-ui/*": ["../../packages/task-ui/src/*.ts", "../../packages/task-ui/src/*"],
      "@memoflow/task-ui/host": ["../../packages/task-ui/src/task-ui-host.ts"],
      "@memoflow/task-ui": ["../../packages/task-ui/src/index.ts"],
      "@memoflow/repository-ui": ["../../packages/repository-ui/src/index.ts"],
      "@memoflow/repository-ui/host": ["../../packages/repository-ui/src/repository-ui-host.ts"],
      "@memoflow/ui-vue-shadcn/composables/*": ["../../packages/ui-vue-shadcn/src/composables/*"],
      "@memoflow/ai-contracts": ["../../packages/ai-contracts/src/index.ts"],
      "@memoflow/ai-contracts/*": ["../../packages/ai-contracts/src/*.ts"],
      "@memoflow/ai-client/*": ["../../packages/ai-client/src/*.ts"],
      "@memoflow/ai-ui": ["../../packages/ai-ui/src/index.ts"],
      "@memoflow/ai-ui/*": ["../../packages/ai-ui/src/*.ts"],
      "@memoflow/ai-ui/host": ["../../packages/ai-ui/src/ai-ui-host.ts"],
      "@memoflow/ai-ui/router": ["../../packages/ai-ui/src/ai-ui-host.ts"],
      "@memoflow/ai-client": ["../../packages/ai-client/src/index.ts"],
      "@memoflow/ai/electron": ["../../packages/ai/src/electron/index.ts"],
      "@memoflow/ai/ports": ["../../packages/ai/src/ports/index.ts"],
      "@memoflow/goal-client": ["../../packages/goal-client/src/index.ts"],
      "@memoflow/goal/electron": ["../../packages/goal/src/electron/index.ts"],
      "@memoflow/goal/schedule-execution": ["../../packages/goal/src/schedule-execution/index.ts"],
      "@memoflow/goal/schedule-projection": [
        "../../packages/goal/src/schedule-projection/index.ts"
      ],
      "@memoflow/task-client": ["../../packages/task-client/src/index.ts"],
      "@memoflow/task/electron": ["../../packages/task/src/electron/index.ts"],
      "@memoflow/task/schedule-execution": ["../../packages/task/src/schedule-execution/index.ts"],
      "@memoflow/task/schedule-projection": [
        "../../packages/task/src/schedule-projection/index.ts"
      ],
      "@memoflow/schedule-client": ["../../packages/schedule-client/src/index.ts"],
      "@memoflow/schedule/electron": ["../../packages/schedule/src/electron/index.ts"],
      "@memoflow/routine/routine-runtime": ["../../packages/routine/src/routine-runtime/index.ts"],
      "@memoflow/routine-client": ["../../packages/routine-client/src/index.ts"],
      "@memoflow/notification-client": ["../../packages/notification-client/src/index.ts"],
      "@memoflow/setting-client": ["../../packages/setting-client/src/index.ts"],
      "@memoflow/notification/electron": ["../../packages/notification/src/electron/index.ts"],
      "@memoflow/ipc-client": ["../../packages/ipc-client/src/index.ts"],
      "@memoflow/http-client": ["../../packages/http-client/src/index.ts"],
      "@memoflow/desktop-contracts": ["../../packages/desktop-contracts/src/index.ts"],
      "@memoflow/notification-contracts": ["../../packages/notification-contracts/src/index.ts"],
      "@memoflow/notification-contracts/*": ["../../packages/notification-contracts/src/*.ts"],
      "@memoflow/repository-client": ["../../packages/repository-client/src/index.ts"],
      "@memoflow/repository-contracts": ["../../packages/repository-contracts/src/index.ts"],
      "@memoflow/repository-contracts/*": ["../../packages/repository-contracts/src/*.ts"],
      "@memoflow/utils": ["../../packages/utils/src/index.ts"],
      "@memoflow/utils/*": ["../../packages/utils/src/*/index.ts", "../../packages/utils/src/*.ts"],
      "@memoflow/goal/analytics": ["../../packages/goal/src/analytics/index.ts"],
      "@memoflow/notification/commands": ["../../packages/notification/src/commands/index.ts"],
      "@memoflow/task/analytics": ["../../packages/task/src/analytics/index.ts"],
      "@memoflow/assets": ["../../packages/assets/src/index.ts"],
      "@memoflow/assets/*": [
        "../../packages/assets/src/*/index.ts",
        "../../packages/assets/src/*.ts"
      ]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.vue", "electron/**/*", "common/**/*"],
  "exclude": ["node_modules", "dist", "dist-electron", "**/*.test.ts", "**/*.spec.ts"]
}
