{
  "name": "migrator",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/migrator/src",
  "projectType": "application",
  "tags": [
    "scope:migrator",
    "type:app",
    "platform:server",
    "layer:app"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/dist"
      ],
      "options": {
        "cwd": "apps/migrator",
        "command": "tsup"
      }
    },
    "lint": {
      "options": {
        "args": [
          "**/*.ts"
        ]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/migrator",
        "command": "tsc --noEmit -p tsconfig.json"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "inputs": [
        "default",
        "^production"
      ],
      "cache": true,
      "options": {
        "command": "node ../../node_modules/vitest/vitest.mjs run --config vitest.config.ts",
        "cwd": "apps/migrator"
      }
    },
    "test:watch": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node ../../node_modules/vitest/vitest.mjs --config vitest.config.ts",
        "cwd": "apps/migrator"
      }
    }
  }
}
