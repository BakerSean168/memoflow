# 应该是本地调试前端，然后不启动 本地后端，直接连接到生产环境后端接口时候使用。


# MemoFlow 开发环境配置
# =============================================================================
# 此文件包含开发环境的默认值，可安全提交到 Git
# 敏感配置请在 .env.local 或 .env.staging.local 中覆盖
# =============================================================================

# =============================================================================
# 1️⃣  应用基础配置
# =============================================================================
NODE_ENV=staging
API_PORT=3000
API_HOST=0.0.0.0
LOG_LEVEL=debug
TZ=Asia/Shanghai
APP_NAME=MemoFlow
APP_VERSION=0.1.0

# =============================================================================
# 2️⃣  Docker 镜像配置（开发环境本地运行时用）
# =============================================================================
# REGISTRY=docker.io
# IMAGE_NAMESPACE=memoflow
# API_TAG=v1.0.3
# WEB_TAG=v1.0.1

# =============================================================================
# 3️⃣  数据库配置（开发环境使用分解配置）
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=memoflow
DB_USER=memoflow
DB_PASSWORD=memoflow

# =============================================================================
# 4️⃣  Redis 缓存配置
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=                         # 开发环境通常不需要密码
REDIS_DB=0

# =============================================================================
# 5️⃣  JWT 认证配置
# =============================================================================
# 开发环境使用简单密钥即可，生产环境必须强密钥！
JWT_SECRET=dev-only-jwt-secret-do-not-use-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# =============================================================================
# 6️⃣  CORS 跨域配置（开发环境允许本地访问）
# =============================================================================
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost:3000

# =============================================================================
# 7️⃣  Web 前端配置
# =============================================================================
WEB_PORT=8080

# Staging environment (merged from apps/web/.env.staging)
VITE_API_BASE_URL=http://47.108.252.228:3000/api/v1
VITE_UPLOAD_BASE_URL=http://47.108.252.228:3000/api/v1/upload
VITE_LOG_LEVEL=info
VITE_ENABLE_DEVTOOLS=false

# Set to true to enable MSW (Mock Service Worker) — intercepts API requests with mock data.
# Useful when the backend is unavailable. Requires public/mockServiceWorker.js to be present.
VITE_ENABLE_MOCK_API=false

# =============================================================================
# 8️⃣  文件上传配置
# =============================================================================
UPLOAD_MAX_SIZE=10485760                # 10MB

# =============================================================================
# 9️⃣  功能开关
# =============================================================================
ENABLE_DAILY_ANALYSIS=true              # 开发环境启用分析便于测试
USE_PRIORITY_QUEUE_SCHEDULER=true

# =============================================================================
# 🔟 开发环境可选配置
# =============================================================================
# Sentry 错误追踪（开发时可启用，便于测试）
# SENTRY_DSN=

# AI 服务（可选）
# OPENAI_API_KEY=sk-test-key（开发环境测试用）
# OPENAI_MODEL=gpt-4-turbo-preview
