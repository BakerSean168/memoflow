{
  "version": 2,
  "description": "Workspace target baseline and exemption manifest for governance audit",
  "changelog": {
    "2": "Added exemption types (permanent/temporary) with owner and targetDate for temporary exemptions"
  },
  "projectCategories": {
    "app": {
      "description": "Deployable applications",
      "requiredTargets": [
        "build",
        "lint",
        "typecheck",
        "test"
      ]
    },
    "runtime-lib": {
      "description": "Libraries with runtime code consumed by apps or other business libraries",
      "requiredTargets": [
        "build",
        "lint",
        "typecheck",
        "test"
      ]
    },
    "ui-lib": {
      "description": "UI component and presentation libraries",
      "requiredTargets": [
        "build",
        "lint",
        "typecheck",
        "test"
      ]
    },
    "tooling-lib": {
      "description": "Tooling, scaffolding, test helpers, config projects",
      "requiredTargets": [
        "build"
      ]
    },
    "meta-project": {
      "description": "Root/workspace-level governance project",
      "requiredTargets": []
    }
  },
  "projectRules": {
    "memoflow": "meta-project",
    "web": "app",
    "desktop": "app",
    "mobile": "app",
    "api": "app",
    "migrator": "app",
    "account": "runtime-lib",
    "ai": "runtime-lib",
    "cloud-auth": "runtime-lib",
    "goal": "runtime-lib",
    "governance": "runtime-lib",
    "notification": "runtime-lib",
    "reminder": "runtime-lib",
    "schedule": "runtime-lib",
    "scheduler": "runtime-lib",
    "schedule-orchestration": "runtime-lib",
    "setting": "runtime-lib",
    "data-portability": "runtime-lib",
    "task": "runtime-lib",
    "domain-shared": "runtime-lib",
    "contracts": "runtime-lib",
    "label": "runtime-lib",
    "repository": "runtime-lib",
    "database": "runtime-lib",
    "http-client": "runtime-lib",
    "ipc-client": "runtime-lib",
    "powersync-schema": "runtime-lib",
    "utils": "runtime-lib",
    "patterns": "runtime-lib",
    "app-vue": "ui-lib",
    "ui-vue-shadcn": "ui-lib",
    "ui-react-native": "ui-lib",
    "ui-core": "ui-lib",
    "app-react": "ui-lib",
    "dashboard": "ui-lib",
    "assets": "ui-lib",
    "@memoflow/test-utils": "tooling-lib",
    "nx-test-system": "tooling-lib",
    "test-system-v2": "tooling-lib",
    "ci-cd-platform": "tooling-lib",
    "governance-tools": "tooling-lib",
    "time": "runtime-lib"
  },
  "exemptions": [
    {
      "project": "mobile",
      "target": "build",
      "type": "permanent",
      "reason": "React Native: build is handled by Expo/Metro bundler, not a standalone Nx build target"
    },
    {
      "project": "mobile",
      "target": "test",
      "type": "permanent",
      "reason": "React Native app in apps/: test infrastructure requires Expo test runner integration; not a standard package"
    },
    {
      "project": "app-react",
      "target": "build",
      "type": "permanent",
      "reason": "React lib: build handled by React Native bundler; no standalone tsup build"
    },
    {
      "project": "app-react",
      "target": "test",
      "type": "permanent",
      "reason": "UI lib: test infrastructure requires React Native Testing Library + Expo/Metro test runner integration; not a standard vitest setup"
    },
    {
      "project": "ui-react-native",
      "target": "build",
      "type": "permanent",
      "reason": "React Native lib: build handled by Expo/Metro bundler"
    },
    {
      "project": "ui-react-native",
      "target": "test",
      "type": "permanent",
      "reason": "React Native lib: test infrastructure requires React Native Testing Library + Metro bundler mock setup; not a standard vitest setup"
    },
    {
      "project": "assets",
      "target": "lint",
      "type": "permanent",
      "reason": "Static asset lib: no source code to lint; contains only image/font/media files"
    },
    {
      "project": "assets",
      "target": "typecheck",
      "type": "permanent",
      "reason": "Static asset lib: no TypeScript source to type-check"
    },
    {
      "project": "nx-test-system",
      "target": "build",
      "type": "permanent",
      "reason": "Nx plugin: consumed directly by Nx devkit at runtime; no separate build artifact needed"
    },
    {
      "project": "test-system-v2",
      "target": "build",
      "type": "permanent",
      "reason": "CI and governance scripts are executed directly by Node and do not produce a build artifact"
    },
    {
      "project": "ci-cd-platform",
      "target": "build",
      "type": "permanent",
      "reason": "CI/CD orchestration scripts are executed directly by Node and do not produce a build artifact"
    }
  ]
}
