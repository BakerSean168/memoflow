  "exceptions": [
    {
      "id": "host-composition-roots",
      "owner": "apps/api and apps/desktop",
      "reason": "Hosts assemble owner modules and inject adapters at the application boundary.",
      "retireBy": "permanent",
      "architectureJustification": "The canonical host-composer rule keeps cross-owner construction at the two composition roots; owners expose ports and do not import each other for assembly."
    },
    {
      "id": "schedule-orchestration-projection",
      "owner": "@memoflow/schedule-orchestration",
      "reason": "The system scheduling package composes Goal, Task, Routine and Scheduler projection/execution ports.",
      "retireBy": "permanent",
      "architectureJustification": "ADR-060/061 and ADR-081..083 define this package as the neutral orchestration boundary; it owns no product persistence truth and uses owner-driven projections."
    },
    {
      "id": "portability-disclosure-source",
      "owner": "@memoflow/data-portability",
      "reason": "The server-held disclosure endpoint reads a dedicated Prisma disclosure source while V3 owner data uses registered capabilities.",
      "retireBy": "permanent",
      "architectureJustification": "ADR-106 permits this disclosure-only infrastructure port and forbids importing owner modules or cloning their persistence DTOs."
    },
    {
      "id": "account-closure-structural-consumers",
      "owner": "@memoflow/account and apps/api",
      "reason": "Account closure publishes structural consumer ports; the host injects Routine, Notification and Knowledge cleanup consumers.",
      "retireBy": "permanent",
      "architectureJustification": "Account remains the lifecycle owner while host composition supplies cross-owner cleanup behavior; this preserves dependency direction and avoids direct account imports."
    },
    {
      "id": "ai-owner-read-contracts",
      "owner": "@memoflow/ai",
      "reason": "AI consumes narrow owner contract/read ports for knowledge, planner, notification and analytics projections.",
      "retireBy": "permanent",
      "architectureJustification": "The canonical ownership matrix and ADR-108 allow consumer projections over explicit owner contracts; AI does not import owner persistence or command implementations."
    },
    {
      "id": "knowledge-external-repository-identity",
      "owner": "@memoflow/repository",
      "reason": "Knowledge retains external GitHub repository identity and repository routes; these are not the retired local Repository/Folder/Resource persistence model.",
      "retireBy": "permanent",
      "architectureJustification": "The accepted Knowledge/GitHub projection architecture owns external repository identity and stable document projections; removing the word would change valid current V2 terminology rather than remove residue."
    },
    {
      "id": "integration-test-composition",
      "owner": "account and notification integration tests",
      "reason": "Integration tests compose public owner server modules to verify closure and scheduler-to-fact behavior; those packages are dev-only dependencies.",
      "retireBy": "permanent",
      "architectureJustification": "Test-only composition exercises the same public ports used by host composition and cannot create production ownership coupling because production imports and dependencies are audited separately."
    }
  ]
}
