{
  "version": 2,
  "collectors": {
    "apps/desktop/playwright.config.ts": {
      "lane": "desktop",
      "lifecycle": "active",
      "execution": {
        "kind": "nx",
        "target": "desktop:e2e"
      }
    },
    "apps/web/playwright.ai-provider.config.ts": {
      "lane": "secure-acceptance",
      "lifecycle": "active",
      "execution": {
        "kind": "nx",
        "target": "web:e2e:ai-provider",
        "entrypoint": "apps/web/e2e/helpers/run-ai-provider-playwright.ts"
      },
      "automation": [
        {
          "kind": "github-workflow",
          "workflow": ".github/workflows/ci.yml",
          "target": "web:e2e:ai-provider"
        },
        {
          "kind": "github-workflow",
          "workflow": ".github/workflows/web-flow-audit.yml",
          "target": "web:e2e:ai-provider"
        }
      ]
    },
    "apps/web/playwright.ai-workspace.config.ts": {
      "lane": "specialized",
      "lifecycle": "active",
      "execution": {
        "kind": "nx",
        "target": "web:e2e:ai-workspace",
        "entrypoint": "apps/web/e2e/helpers/run-ai-workspace-playwright.ts"
      }
    },
    "apps/web/playwright.audit.config.ts": {
      "lane": "nightly",
      "lifecycle": "active",
      "execution": {
        "kind": "nx",
        "target": "web:e2e:audit"
      },
      "automation": [
        {
          "kind": "github-workflow",
          "workflow": ".github/workflows/web-flow-audit.yml",
          "target": "web:e2e:audit"
        }
      ]
    },
    "apps/web/playwright.config.ts": {
      "lane": "required",
      "lifecycle": "active",
      "execution": {
        "kind": "nx",
        "target": "web:e2e"
      },
      "automation": [
        {
          "kind": "github-workflow",
          "workflow": ".github/workflows/ci.yml",
          "entrypoint": "tools/test-system-v2/run-web-shard.mjs"
        }
      ]
    },
    "apps/web/playwright.desktop-screenshot.config.ts": {
      "lane": "visual-artifact",
      "lifecycle": "active",
      "execution": {
        "kind": "nx",
        "target": "web:e2e:desktop-screenshots"
      }
    },
    "apps/web/playwright.goal-reference.config.ts": {
      "lane": "reference",
      "lifecycle": "active",
      "execution": {
        "kind": "manual",
        "command": "pnpm exec playwright test --config apps/web/playwright.goal-reference.config.ts"
      }
    },
    "apps/web/playwright.local-docker.config.ts": {
      "lane": "local-validation",
