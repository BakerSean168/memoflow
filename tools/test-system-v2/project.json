{
  "name": "test-system-v2",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "tags": ["scope:tools", "type:plugin", "layer:testing"],
  "sourceRoot": "tools/test-system-v2",
  "namedInputs": {
    "repoTestInventory": [
      "{workspaceRoot}/apps/**/project.json",
      "{workspaceRoot}/packages/**/project.json",
      "{workspaceRoot}/tools/**/project.json",
      "{workspaceRoot}/apps/**/*.{test,spec,bench}.{js,mjs,cjs,ts,mts,cts,jsx,tsx}",
      "{workspaceRoot}/packages/**/*.{test,spec,bench}.{js,mjs,cjs,ts,mts,cts,jsx,tsx}",
      "{workspaceRoot}/tools/**/*.{test,spec,bench}.{js,mjs,cjs,ts,mts,cts,jsx,tsx}",
      "{workspaceRoot}/apps/**/playwright*.config.{js,mjs,ts,mts}",
      "{workspaceRoot}/apps/**/vitest*.config.{js,mjs,ts,mts,cts}",
      "{workspaceRoot}/packages/**/vitest*.config.{js,mjs,ts,mts,cts}",
      "{workspaceRoot}/tools/**/vitest*.config.{js,mjs,ts,mts,cts}",
      "{workspaceRoot}/apps/**/e2e/**/*",
      "{workspaceRoot}/.github/workflows/ci.yml"
    ]
  },
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["contracts:build"],
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*",
        "{workspaceRoot}/apps/web/web-specialized-specs.mjs",
        "{workspaceRoot}/tools/ci-cd-platform/generate-delivery-manifest.mjs",
        "{workspaceRoot}/tools/ci-cd-platform/lib/**/*",
        "{workspaceRoot}/tools/ci-cd-platform/unit-test-durations.json",
        "{workspaceRoot}/tools/test/storybook-process.mjs",
        "{workspaceRoot}/apps/storybook/vitest.config.ts",
        "repoTestInventory"
      ],
      "options": { "command": "node --test tools/test-system-v2/__tests__/*.test.mjs" }
    },
    "test:inventory": {
      "executor": "nx:run-commands",
      "dependsOn": ["contracts:build"],
      "cache": true,
      "inputs": [
        "repoTestInventory",
        "{workspaceRoot}/apps/**/*",
        "{workspaceRoot}/packages/**/*",
        "{workspaceRoot}/tools/test-system-v2/**/*"
      ],
      "outputs": ["{workspaceRoot}/tools/test-system-v2/test-inventory.json"],
      "options": { "command": "node ./tools/test-system-v2/inventory.mjs --check" }
    },
    "test:governance": {
      "executor": "nx:run-commands",
      "dependsOn": ["contracts:build"],
      "cache": true,
      "inputs": [
        "repoTestInventory",
        "{workspaceRoot}/apps/**/*",
        "{workspaceRoot}/packages/**/*",
        "{workspaceRoot}/tools/test-system-v2/**/*",
        "{workspaceRoot}/tools/test/test-target-governance.mjs"
      ],
      "options": {
        "command": "node ./tools/test-system-v2/inventory.mjs --check && node ./tools/test/test-target-governance.mjs --check"
      }
    },
    "scope": {
      "executor": "nx:run-commands",
      "cache": false,
      "outputs": ["{workspaceRoot}/scope/delivery-manifest-v1.json"],
      "options": { "command": "node ./tools/ci-cd-platform/generate-delivery-manifest.mjs" }
    },
    "ruleset": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["{workspaceRoot}/.github/rulesets/main.json", "{projectRoot}/ruleset-check.mjs"],
      "options": { "command": "node ./tools/test-system-v2/ruleset-check.mjs" }
    }
  }
}
