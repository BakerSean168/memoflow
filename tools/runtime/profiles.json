{
  "version": 2,
  "description": "Single source of truth for MemoFlow runtime environments and host-port ownership. The four primary environments are host-dev, prod-like, staging, and prod; e2e/dev-infra/test-infra are supporting lanes, not deployment environments.",
  "primaryEnvironments": ["host-dev", "prod-like", "staging", "prod"],
  "profiles": {
    "host-dev": {
      "category": "environment",
      "hostGroup": "gcp-dev",
      "portBlock": "20220-20239",
      "title": "Host development (hot reload)",
      "description": "API + Web run directly on GCP Dev with hot reload; Docker carries only PostgreSQL, Redis, and PowerSync. Access from the workstation through VS Code/SSH port forwarding.",
      "commands": {
        "infra": "pnpm docker:dev:up",
        "app": "pnpm nx run-many -t serve --projects=api,web --parallel=2"
      },
      "ports": {
        "web": 20220,
        "api": 20221,
        "powersync": 20222,
        "postgres": 20230,
        "redis": 20231
      },
      "hostPortEnv": {
        "WEB_HOST_PORT": 20220,
        "API_HOST_PORT": 20221,
        "POWERSYNC_HOST_PORT": 20222,
        "POSTGRES_HOST_PORT": 20230,
        "REDIS_HOST_PORT": 20231
      },
      "urls": {
        "web": "http://localhost:20220",
        "api": "http://localhost:20221",
        "powersync": "http://localhost:20222"
      },
      "composeProject": "memoflow-host-dev"
    },
    "prod-like": {
      "category": "environment",
      "hostGroup": "gcp-dev",
      "portBlock": "20200-20219",
      "title": "Local prod-like Docker stack",
      "description": "Full production-shaped Docker stack on GCP Dev for deployment-level acceptance. Implemented by docker-compose.local.yml and pnpm docker:local:*.",
      "commands": {
        "app": "pnpm docker:local:up"
      },
      "ports": {
        "web": 20200,
        "api": 20201,
        "powersync": 20202,
        "postgres": 20210,
        "redis": 20211
      },
      "hostPortEnv": {
        "WEB_HOST_PORT": 20200,
        "API_HOST_PORT": 20201,
        "POWERSYNC_HOST_PORT": 20202,
        "POSTGRES_HOST_PORT": 20210,
        "REDIS_HOST_PORT": 20211
      },
      "urls": {
        "web": "http://localhost:20200",
        "api": "http://localhost:20201",
        "powersync": "http://localhost:20202"
      },
      "composeProject": "memoflow-prod-like"
    },
    "staging": {
      "category": "environment",
      "hostGroup": "gcp-dev",
      "portBlock": "20250-20269",
      "title": "Canonical staging",
      "description": "Watcher-owned exact-digest staging runtime on GCP Dev. This is a stable integration environment, not a hot-reload development surface.",
      "ports": {
        "web": 20250,
        "api": 20251,
        "powersync": 20252,
        "postgres": 20260,
        "redis": 20261
      },
      "hostPortEnv": {
        "WEB_HOST_PORT": 20250,
        "API_HOST_PORT": 20251,
        "POWERSYNC_HOST_PORT": 20252,
        "POSTGRES_HOST_PORT": 20260,
        "REDIS_HOST_PORT": 20261
      },
      "urls": {
        "web": "https://gcp-dev-01.taile92a8e.ts.net:20250",
        "api": "https://gcp-dev-01.taile92a8e.ts.net:20251",
        "powersync": "https://gcp-dev-01.taile92a8e.ts.net:20252"
      },
      "composeProject": "memoflow-staging"
    },
    "prod": {
      "category": "environment",
      "hostGroup": "alibaba-production",
      "title": "Canonical production",
      "description": "Alibaba production selected from a Published Release and reconciled by the production watcher. Caddy owns public 80/443; PostgreSQL and Redis remain loopback-only host bindings.",
      "localProbe": false,
      "ports": {
        "http": 80,
        "https": 443,
        "postgres": 5432,
        "redis": 6379
      },
      "urls": {
        "web": "https://memoflow.bakersean.top",
        "api": "https://memoflowapi.bakersean.top",
        "powersync": "https://memoflowsync.bakersean.top"
      },
      "composeProject": "memoflow"
    },
    "e2e": {
      "category": "support",
      "hostGroup": "gcp-dev",
      "title": "Playwright core e2e",
      "description": "Playwright-owned test lane. It is not one of the four deployment environments.",
      "commands": {
        "infra": "pnpm docker:test:up",
        "app": "pnpm e2e"
      },
      "ports": {
        "api": 3000,
        "web": 5173,
        "postgres": 5433
      },
      "urls": {
        "api": "http://localhost:3000",
        "web": "http://127.0.0.1:5173"
      },
      "runtimeLane": "e2e"
    },
    "dev-infra": {
      "category": "support",
      "hostGroup": "gcp-dev",
      "title": "Host-dev infrastructure only",
      "description": "Docker dependencies owned by host-dev: PostgreSQL, Redis, and PowerSync.",
      "commands": {
        "infra": "pnpm docker:dev:up"
      },
      "ports": {
        "powersync": 20222,
        "postgres": 20230,
        "redis": 20231
      }
    },
    "test-infra": {
      "category": "support",
      "hostGroup": "gcp-dev",
      "title": "Test infrastructure only",
      "description": "Docker test database used by the Playwright/integration lane.",
      "commands": {
        "infra": "pnpm docker:test:up"
      },
      "ports": {
        "postgres": 5433
      }
    }
  }
}
