{
  "name": "ci-cd-platform",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "tools/ci-cd-platform",
  "tags": ["scope:tools", "type:platform", "layer:ci"],
  "namedInputs": {
    "testContracts": [
      "default",
      "{workspaceRoot}/nx.json",
      "{workspaceRoot}/project.json",
      "{workspaceRoot}/apps/**/project.json",
      "{workspaceRoot}/packages/**/project.json",
      "{workspaceRoot}/tools/**/project.json",
      "{workspaceRoot}/apps/**/*.config.{ts,mts,cts,js,mjs,cjs}",
      "{workspaceRoot}/packages/**/*.config.{ts,mts,cts,js,mjs,cjs}",
      "{workspaceRoot}/tools/build/**/*",
      "{workspaceRoot}/tools/ci/node-process-bootstrap.cjs",
      "{workspaceRoot}/apps/web/web-flow-specs.mjs",
      "{workspaceRoot}/tools/test-system-v2/lib/web-shards.mjs",
      "{workspaceRoot}/tools/test-system-v2/lib/shard-balance.mjs",
      "{workspaceRoot}/tools/test-system-v2/web-spec-durations.json",
      "{workspaceRoot}/tools/test-system-v2/run-command.mjs",
      "{workspaceRoot}/tools/test-system-v2/lib/failure-classification.mjs",
      "{workspaceRoot}/.github/workflows/**/*",
      "{workspaceRoot}/.github/actions/**/*",
      "{workspaceRoot}/apps/desktop/*.mjs",
      "{workspaceRoot}/apps/desktop/*.json5",
      "{workspaceRoot}/apps/desktop/package.json",
      "{workspaceRoot}/apps/desktop/e2e/**/*",
      "{workspaceRoot}/apps/desktop/scripts/**/*",
      "{workspaceRoot}/deployment/**/*",
      "{workspaceRoot}/docker/powersync/Dockerfile.bake",
      "{workspaceRoot}/docker-compose*.yml",
      "{workspaceRoot}/.dockerignore",
      "{workspaceRoot}/release-please-config.json"
    ]
  },
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["testContracts"],
      "options": {
        "command": "node --test --test-concurrency=4 tools/ci-cd-platform/__tests__/*.test.mjs"
      }
    },
    "contract": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["testContracts"],
      "options": {
        "command": "node --test tools/ci-cd-platform/__tests__/contracts.test.mjs tools/ci-cd-platform/__tests__/risk.test.mjs"
      }
    },
    "schema": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["{projectRoot}/schemas/**/*", "{projectRoot}/schema-check.mjs"],
      "options": { "command": "node tools/ci-cd-platform/schema-check.mjs" }
    },
    "governance": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["testContracts"],
      "options": {
        "command": "node tools/ci-cd-platform/schema-check.mjs && node tools/ci-cd-platform/registry-check.mjs && node --test --test-concurrency=4 tools/ci-cd-platform/__tests__/*.test.mjs"
      }
    },
    "manifest": {
      "executor": "nx:run-commands",
      "cache": false,
      "outputs": ["{workspaceRoot}/scope/delivery-manifest-v1.json"],
      "options": { "command": "node tools/ci-cd-platform/generate-delivery-manifest.mjs" }
    },
    "artifact": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "node tools/ci-cd-platform/__tests__/artifact-contract.test.mjs" }
    },
    "promotion": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "node tools/ci-cd-platform/__tests__/promotion.test.mjs" }
    },
    "failure-matrix": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["{projectRoot}/**/*"],
      "options": {
        "command": "node tools/ci-cd-platform/run-fault-injection.mjs reports/ci-cd-platform/fault-injection-report-v1.json"
      }
    },
    "registry": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/lib/**/*",
        "{projectRoot}/registry-check.mjs",
        "{projectRoot}/schemas/lane-registry-v1.schema.json"
      ],
      "options": { "command": "node tools/ci-cd-platform/registry-check.mjs" }
    },
    "observation": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node tools/ci-cd-platform/observe-run.mjs"
      }
    },
    "timing": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["{projectRoot}/**/*"],
      "options": {
        "command": "node --test tools/ci-cd-platform/__tests__/timing.test.mjs"
      }
    },
    "fault-injection": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["{projectRoot}/**/*"],
      "outputs": ["{workspaceRoot}/reports/ci-cd-platform/fault-injection-report-v1.json"],
      "options": {
        "command": "node tools/ci-cd-platform/run-fault-injection.mjs reports/ci-cd-platform/fault-injection-report-v1.json"
      }
    }
  }
}
