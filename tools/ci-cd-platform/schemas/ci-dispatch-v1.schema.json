{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memoflow.dev/schemas/ci-dispatch-v1.schema.json",
  "type": "object",
  "required": ["kind", "version", "selection", "jobs", "serverShards", "skippedTasks", "ownership"],
  "properties": {
    "kind": {
      "const": "ci-dispatch-v1"
    },
    "version": {
      "const": 1
    },
    "selection": {
      "type": "object"
    },
    "jobs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["required", "skipReason", "tasks"],
        "properties": {
          "required": {
            "type": "boolean"
          },
          "skipReason": {
            "type": ["string", "null"]
          },
          "tasks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["key"],
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "serverShards": {
      "type": "array"
    },
    "skippedTasks": {
      "type": "array"
    },
    "ownership": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
