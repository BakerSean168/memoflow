{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memoflow.dev/schemas/delivery-manifest-v1.schema.json",
  "type": "object",
  "required": [
    "kind",
    "version",
    "commit",
    "event",
    "full",
    "changedFiles",
    "risk",
    "scope",
    "lanes",
    "provenance",
    "digest",
    "unitShards",
    "webShards"
  ],
  "properties": {
    "kind": {
      "const": "delivery-manifest-v1"
    },
    "version": {
      "const": 1
    },
    "commit": {
      "type": "string",
      "minLength": 1
    },
    "event": {
      "type": "string",
      "minLength": 1
    },
    "full": {
      "type": "boolean"
    },
    "base": {
      "type": ["string", "null"]
    },
    "head": {
      "type": ["string", "null"]
    },
    "changedFiles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risk": {
      "type": "object",
      "required": ["level", "reasons"],
      "properties": {
        "level": {
          "enum": ["docs", "package", "desktop", "runtime", "web-flow", "root", "release"]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "matchedLevels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "lanes": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "provenance": {
      "type": "object",
      "required": ["generator", "inputDigest"],
      "properties": {
        "generator": {
          "type": "string",
          "minLength": 1
        },
        "inputDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "execution": {
      "type": "object",
      "required": ["mode", "candidate"],
      "properties": {
        "mode": {
          "enum": ["reuse", "full"]
        },
        "candidate": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        },
        "testRunId": {
          "type": "integer",
          "minimum": 1
        },
        "testRunAttempt": {
          "type": "integer",
          "minimum": 1
        },
        "testHead": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "testedCommit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "testedTree": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "manifestDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "inputsDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "prNumber": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "unitShards": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "tasks"],
        "properties": {
          "id": {
            "enum": ["unit-1", "unit-2", "unit-3"]
          },
          "tasks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["project"],
              "properties": {
                "project": {
                  "type": "string",
                  "minLength": 1
                },
                "shard": {
                  "enum": ["1/2", "2/2"]
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "webShards": {
      "type": "object",
      "required": ["specs", "fallback", "estimatedTotalMs", "shardCount", "shards"],
      "properties": {
        "specs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "fallback": {
          "type": "boolean"
        },
        "estimatedTotalMs": {
          "type": "number",
          "minimum": 0
        },
        "shardCount": {
          "type": "integer",
          "minimum": 0
        },
        "shards": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "specs", "estimatedMs"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[1-9][0-9]*/[1-9][0-9]*$"
              },
              "specs": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "estimatedMs": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
