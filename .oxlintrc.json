{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "vue"],
  "categories": {
    "correctness": "off"
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/build/**",
    "**/node_modules/**",
    "**/coverage/**",
    "**/.nx/**",
    "**/test-results/**",
    "**/playwright-report/**",
    "**/playwright-*-report/**",
    "**/dist-renderer/**",
    "**/dist-electron/**",
    "**/src/generated/prisma/**",
    "**/*.min.js",
    "**/*.d.ts"
  ],
  "rules": {
    "no-array-constructor": "error",
    "no-unused-expressions": "error",
    "no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],
    "vue/no-arrow-functions-in-watch": "error",
    "vue/no-async-in-computed-properties": "error",
    "vue/no-computed-properties-in-data": "error",
    "vue/no-deprecated-data-object-declaration": "error",
    "vue/no-deprecated-delete-set": "error",
    "vue/no-deprecated-destroyed-lifecycle": "error",
    "vue/no-deprecated-events-api": "error",
    "vue/no-deprecated-model-definition": "error",
    "vue/no-deprecated-props-default-this": "error",
    "vue/no-deprecated-vue-config-keycodes": "error",
    "vue/no-dupe-keys": "error",
    "vue/no-export-in-script-setup": "error",
    "vue/no-expose-after-await": "error",
    "vue/no-lifecycle-after-await": "error",
    "vue/no-reserved-component-names": "error",
    "vue/no-reserved-keys": "error",
    "vue/no-reserved-props": "error",
    "vue/no-shared-component-data": "error",
    "vue/no-side-effects-in-computed-properties": "warn",
    "vue/no-watch-after-await": "error",
    "vue/prefer-import-from-vue": "error",
    "vue/require-prop-type-constructor": "error",
    "vue/require-render-return": "error",
    "vue/require-slots-as-functions": "error",
    "vue/return-in-computed-property": "error",
    "vue/return-in-emits-validator": "error",
    "vue/valid-define-emits": "error",
    "vue/valid-define-options": "error",
    "vue/valid-define-props": "error",
    "vue/valid-next-tick": "error",
    "typescript/no-duplicate-enum-values": "error",
    "typescript/no-explicit-any": "warn",
    "typescript/no-extra-non-null-assertion": "error",
    "typescript/no-misused-new": "error",
    "typescript/no-non-null-asserted-optional-chain": "error",
    "typescript/no-unnecessary-type-constraint": "error",
    "typescript/no-unsafe-declaration-merging": "error",
    "typescript/no-wrapper-object-types": "error",
    "typescript/prefer-as-const": "error",
    "typescript/prefer-namespace-keyword": "error",
    "typescript/triple-slash-reference": "error",
    "@nx/enforce-module-boundaries": [
      "error",
      {
        "enforceBuildableLibDependency": true,
        "allow": ["./generated/prisma/**", "@memoflow/test-utils", "@memoflow/test-utils/*"],
        "checkDynamicDependenciesExceptions": ["@memoflow/database"],
        "depConstraints": [
          {
            "sourceTag": "layer:shared",
            "onlyDependOnLibsWithTags": ["layer:shared"]
          },
          {
            "sourceTag": "layer:infra",
            "onlyDependOnLibsWithTags": ["layer:shared", "layer:infra"]
          },
          {
            "sourceTag": "layer:domain",
            "onlyDependOnLibsWithTags": ["layer:shared", "layer:infra", "layer:domain"]
          },
          {
            "sourceTag": "layer:ui",
            "onlyDependOnLibsWithTags": ["layer:shared", "layer:infra", "layer:domain", "layer:ui"]
          },
          {
            "sourceTag": "layer:app",
            "onlyDependOnLibsWithTags": [
              "layer:shared",
              "layer:infra",
              "layer:domain",
              "layer:ui",
              "layer:app"
            ]
          },
          {
            "sourceTag": "layer:testing",
            "onlyDependOnLibsWithTags": ["layer:shared", "layer:infra", "layer:testing"]
          },
          {
            "sourceTag": "layer:service",
            "onlyDependOnLibsWithTags": ["layer:shared"]
          },
          {
            "sourceTag": "tier:core",
            "notDependOnLibsWithTags": ["tier:client", "tier:server"]
          },
          {
            "sourceTag": "tier:client",
            "notDependOnLibsWithTags": ["tier:server"]
          },
          {
            "sourceTag": "tier:server",
            "notDependOnLibsWithTags": ["tier:client"]
          },
          {
            "sourceTag": "scope:account",
            "onlyDependOnLibsWithTags": ["scope:shared", "scope:patterns", "scope:account"]
          },
          {
            "sourceTag": "scope:ai",
            "onlyDependOnLibsWithTags": ["scope:shared", "scope:patterns", "scope:ai"]
          },
          {
            "sourceTag": "scope:authentication",
            "onlyDependOnLibsWithTags": ["scope:shared", "scope:patterns", "scope:authentication"]
          },
          {
            "sourceTag": "scope:goal",
            "onlyDependOnLibsWithTags": [
              "scope:shared",
              "scope:patterns",
              "scope:goal",
              "scope:schedule",
              "scope:scheduler"
            ]
          },
          {
            "sourceTag": "scope:notification",
            "onlyDependOnLibsWithTags": ["scope:shared", "scope:patterns", "scope:notification"]
          },
          {
            "sourceTag": "scope:reminder",
            "onlyDependOnLibsWithTags": [
              "scope:shared",
              "scope:patterns",
              "scope:reminder",
              "scope:schedule"
            ]
          },
          {
            "sourceTag": "scope:repository",
            "onlyDependOnLibsWithTags": ["scope:shared", "scope:patterns", "scope:repository"]
          },
          {
            "sourceTag": "scope:schedule",
            "onlyDependOnLibsWithTags": ["scope:shared", "scope:patterns", "scope:schedule"]
          },
          {
            "sourceTag": "scope:scheduler",
            "onlyDependOnLibsWithTags": ["scope:shared", "scope:patterns", "scope:scheduler"]
          },
          {
            "sourceTag": "scope:setting",
            "onlyDependOnLibsWithTags": ["scope:shared", "scope:patterns", "scope:setting"]
          },
          {
            "sourceTag": "scope:task",
            "onlyDependOnLibsWithTags": [
              "scope:shared",
              "scope:patterns",
              "scope:task",
              "scope:schedule",
              "scope:scheduler"
            ]
          },
          {
            "sourceTag": "scope:data-portability",
            "onlyDependOnLibsWithTags": [
              "scope:shared",
              "scope:patterns",
              "scope:data-portability",
              "scope:goal",
              "scope:task",
              "scope:reminder",
              "scope:notification",
              "scope:setting"
            ]
          },
          {
            "sourceTag": "scope:app-vue",
            "onlyDependOnLibsWithTags": [
              "scope:shared",
              "scope:patterns",
              "scope:app-vue",
              "scope:ui",
              "scope:account",
              "scope:ai",
              "scope:authentication",
              "scope:goal",
              "scope:notification",
              "scope:reminder",
              "scope:repository",
              "scope:schedule",
              "scope:scheduler",
              "scope:setting",
              "scope:task",
              "scope:data-portability"
            ]
          },
          {
            "sourceTag": "scope:app-react",
            "onlyDependOnLibsWithTags": [
              "scope:shared",
              "scope:patterns",
              "scope:app-react",
              "scope:ui",
              "scope:account",
              "scope:ai",
              "scope:authentication",
              "scope:goal",
