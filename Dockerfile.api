FROM node:24-bookworm-slim AS node-base

RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

FROM node-base AS builder

RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 make g++ \
  && rm -rf /var/lib/apt/lists/*

ARG PNPM_VERSION=11.20.0
ARG PNPM_REGISTRY=https://registry.npmjs.org
ARG USE_PREBUILT_ARTIFACT=0

ENV CI=true
ENV PNPM_HOME=/pnpm
ENV PATH=/pnpm:$PATH

RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate

WORKDIR /app

COPY tools/build/normalize-generated-prisma.mjs ./tools/build/normalize-generated-prisma.mjs
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc tsconfig.base.json tsconfig.workspace-src.json tsconfig.workspace-dist.json tsconfig.json nx.json vitest.shared.ts vite.workspace-aliases.ts ./

# Copy only the package manifests in the API/migrator build closure so source
# edits do not invalidate dependency installation. `pnpm fetch` is deliberately
# avoided because it cannot filter a workspace lockfile and fetched all 3225
# packages even though this build links only roughly 1925.
COPY apps/api/package.json ./apps/api/package.json
COPY apps/migrator/package.json ./apps/migrator/package.json
COPY packages/account/package.json ./packages/account/package.json
COPY packages/ai/package.json ./packages/ai/package.json
COPY packages/cloud-auth/package.json ./packages/cloud-auth/package.json
COPY packages/contracts/package.json ./packages/contracts/package.json
COPY packages/dashboard/package.json ./packages/dashboard/package.json
COPY packages/data-portability/package.json ./packages/data-portability/package.json
COPY packages/database/package.json ./packages/database/package.json
COPY packages/database/prisma ./packages/database/prisma
COPY packages/domain-shared/package.json ./packages/domain-shared/package.json
COPY packages/goal/package.json ./packages/goal/package.json
COPY packages/governance/package.json ./packages/governance/package.json
COPY packages/http-client/package.json ./packages/http-client/package.json
COPY packages/ipc-client/package.json ./packages/ipc-client/package.json
COPY packages/label/package.json ./packages/label/package.json
COPY packages/relation/package.json ./packages/relation/package.json
COPY packages/notification/package.json ./packages/notification/package.json
COPY packages/patterns/package.json ./packages/patterns/package.json
COPY packages/powersync-schema/package.json ./packages/powersync-schema/package.json
COPY packages/reminder/package.json ./packages/reminder/package.json
COPY packages/repository/package.json ./packages/repository/package.json
COPY packages/schedule/package.json ./packages/schedule/package.json
COPY packages/scheduler/package.json ./packages/scheduler/package.json
COPY packages/schedule-orchestration/package.json ./packages/schedule-orchestration/package.json
COPY packages/setting/package.json ./packages/setting/package.json
COPY packages/task/package.json ./packages/task/package.json
COPY packages/test-utils/package.json ./packages/test-utils/package.json
COPY packages/time/package.json ./packages/time/package.json
COPY packages/utils/package.json ./packages/utils/package.json
COPY tools/mcp/ensure-nx-src-link.mjs ./tools/mcp/ensure-nx-src-link.mjs

# Isolated linking makes each workspace package consume only its declared
# dependencies. The root is selected explicitly because Nx and shared build
# adapters intentionally live at the workspace seam.
RUN --mount=type=cache,id=memoflow-api-pnpm-store,target=/pnpm/store \
  pnpm --config.node-linker=isolated \
  --filter . --filter @memoflow/api... --filter @memoflow/migrator... install \
  --frozen-lockfile --network-concurrency=4 --registry=${PNPM_REGISTRY}

COPY apps/api ./apps/api
COPY apps/migrator ./apps/migrator
COPY packages/account ./packages/account
COPY packages/ai ./packages/ai
COPY packages/cloud-auth ./packages/cloud-auth
COPY packages/contracts ./packages/contracts
COPY packages/dashboard ./packages/dashboard
COPY packages/data-portability ./packages/data-portability
COPY packages/database ./packages/database
COPY packages/domain-shared ./packages/domain-shared
COPY packages/goal ./packages/goal
COPY packages/governance ./packages/governance
COPY packages/http-client ./packages/http-client
COPY packages/ipc-client ./packages/ipc-client
COPY packages/label ./packages/label
COPY packages/relation ./packages/relation
COPY packages/notification ./packages/notification
COPY packages/patterns ./packages/patterns
COPY packages/powersync-schema ./packages/powersync-schema
COPY packages/reminder ./packages/reminder
COPY packages/repository ./packages/repository
COPY packages/schedule ./packages/schedule
COPY packages/scheduler ./packages/scheduler
COPY packages/schedule-orchestration ./packages/schedule-orchestration
COPY packages/setting ./packages/setting
COPY packages/task ./packages/task
COPY packages/test-utils ./packages/test-utils
COPY packages/time ./packages/time
COPY packages/utils ./packages/utils
COPY tools/mcp ./tools/mcp
COPY tools/build ./tools/build
COPY tools/nx-test-system ./tools/nx-test-system

# Build the package surfaces consumed by production and the one-shot migrator.
# Cache Nx data independently from pnpm's content-addressed store.
RUN --mount=type=cache,id=memoflow-api-nx-cache,target=/app/.nx/cache \
  if [ "$USE_PREBUILT_ARTIFACT" = "1" ]; then \
    test -f apps/api/dist/main.js \
      && test -f apps/migrator/dist/main.js \
      && test -f packages/database/dist/index.js \
      && test -d packages/database/dist/runtime-scripts; \
  else \
    ./node_modules/.bin/nx run api:build \
      && ./node_modules/.bin/nx run migrator:build \
      && ./node_modules/.bin/nx run database:runtime-scripts:build; \
  fi

RUN --mount=type=cache,id=memoflow-api-pnpm-store,target=/pnpm/store \
  pnpm --config.inject-workspace-packages=true \
  --filter @memoflow/api deploy --prod --ignore-scripts /prod/api \
  && pnpm --config.inject-workspace-packages=true \
  --filter @memoflow/migrator deploy --prod --ignore-scripts /prod/migrator \
  && node /prod/migrator/node_modules/@prisma/engines/scripts/postinstall.js \
  && schema_engine="$(find /prod/migrator/node_modules/@prisma/engines -maxdepth 1 -type f -name 'schema-engine-*' -print -quit)" \
  && test -n "$schema_engine" \
  && test -x "$schema_engine"

FROM node-base AS migrator-runtime

ARG BUILD_DATE
ARG VCS_REF
ARG VERSION=dev

ENV NODE_ENV=production
ENV CI=true
ENV PRISMA_HIDE_UPDATE_MESSAGE=1

LABEL org.opencontainers.image.title="memoflow-migrator"
LABEL org.opencontainers.image.description="MemoFlow one-shot database initialization module"
LABEL org.opencontainers.image.created=$BUILD_DATE
LABEL org.opencontainers.image.revision=$VCS_REF
LABEL org.opencontainers.image.version=$VERSION

WORKDIR /app

COPY --from=builder /prod/migrator/node_modules ./node_modules
COPY --from=builder /prod/migrator/package.json ./apps/migrator/package.json
COPY --from=builder /prod/migrator/dist ./apps/migrator/dist

RUN schema_engine="$(find /app/node_modules/@prisma/engines -maxdepth 1 -type f -name 'schema-engine-*' -print -quit)" \
  && test -n "$schema_engine" \
  && test -x "$schema_engine" \
  && /app/node_modules/.bin/prisma -v | grep -q 'Schema Engine'

WORKDIR /app/apps/migrator

CMD ["node", "dist/main.js"]

FROM node-base AS api-runtime

ARG BUILD_DATE
ARG VCS_REF
ARG VERSION=dev

ENV NODE_ENV=production
ENV CI=true

LABEL org.opencontainers.image.title="memoflow-api"
LABEL org.opencontainers.image.description="MemoFlow production API service"
LABEL org.opencontainers.image.created=$BUILD_DATE
LABEL org.opencontainers.image.revision=$VCS_REF
LABEL org.opencontainers.image.version=$VERSION

WORKDIR /app

COPY --from=builder /prod/api/node_modules ./node_modules
COPY --from=builder /prod/api/package.json ./apps/api/package.json
COPY --from=builder /prod/api/dist ./apps/api/dist

WORKDIR /app/apps/api

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD node -e "require('node:http').get('http://127.0.0.1:3000/healthz', (res) => process.exit(res.statusCode === 200 ? 0 : 1)).on('error', () => process.exit(1))"

CMD ["node", "dist/main.js"]
