# MemoFlow 环境配置示例
# =============================================================================
# 本文件包含所有可用的环境变量配置项，按功能分类整理
# 
# 使用说明：
#   1. 复制此文件为 .env（基础共享配置）
#   2. 复制此文件为 .env.development 或 .env.production（环境特定配置）
#   3. 创建 .env.local 或 .env.{NODE_ENV}.local（本地或敏感信息覆盖）
# 
# 文件加载优先级（后覆盖前）：
#   .env → .env.{NODE_ENV} → .env.local → .env.{NODE_ENV}.local → OS env vars
#
# .gitignore 规则（已配置）：
#   ✅ 可提交:  .env, .env.development, .env.production, .env.example
#   ❌ 不提交:  .env.local, .env.*.local (含敏感信息)
#
# 配置项说明：
#   ✅ 必需:    应用启动时必须提供
#   ⚠️  重要:   强烈建议配置，否则功能受限
#   ℹ️  可选:   可选配置，有默认值
#   💬 已注释: 暂不需要，但可选启用
# =============================================================================

# =============================================================================
# 1️⃣  应用基础配置
# =============================================================================
# 应用环境: development | production | test
NODE_ENV=development

# API 服务
API_PORT=3000                          # ℹ️  API 监听端口（Docker 内部）
API_HOST=0.0.0.0                       # ℹ️  API 监听地址（0.0.0.0 = 所有网卡）
AUTH_BASE_URL=http://localhost:20201/api/auth # Better Auth 对客户端公开的规范地址
LOCAL_VALIDATION=0 # 仅本地验证环境设为 1；开放验证码链接捕获端点
MEMOFLOW_WEB_URL=http://localhost:5173        # Desktop 邮箱验证/密码重置在系统浏览器完成时的 Web 地址
LOG_LEVEL=debug                        # ℹ️  日志级别: debug | info | warn | error

# OpenTelemetry（默认关闭，无需 collector；启用时必须同时配置 endpoint 与 service name）
OTEL_TRACING_ENABLED=0                  # 0=off（默认）| 1=on
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
# OTEL_SERVICE_NAME=memoflow-api

# 应用元信息
APP_NAME=MemoFlow                       # ℹ️  应用名称
APP_VERSION=0.1.0                       # ℹ️  应用版本
TZ=Asia/Shanghai                        # ℹ️  时区

# =============================================================================
# 2️⃣  Docker 镜像配置
# =============================================================================
# Docker 镜像仓库
REGISTRY=docker.io                      # ℹ️  镜像仓库地址（docker.io | 阿里云镜像仓库 等）
IMAGE_NAMESPACE=MemoFlow                # ℹ️  镜像命名空间

# 各服务镜像版本标签
API_TAG=v0.3.0-prod                     # ℹ️  API 镜像版本标签（建议由发布脚本自动更新）
WEB_TAG=v0.3.0-prod                     # ℹ️  Web 前端镜像版本标签（建议由发布脚本自动更新）
POSTGRES_IMAGE=pgvector/pgvector:0.8.5-pg18   # ℹ️ runtime image; China prod may use ACR@sha256
REDIS_IMAGE=redis:8-alpine                # ℹ️ runtime image; China prod may use ACR@sha256
CADDY_IMAGE=caddy:2-alpine                # ℹ️ runtime image; China prod may use ACR@sha256
POWERSYNC_IMAGE=journeyapps/powersync-service:1.25.0 # ℹ️ runtime image; China prod may use ACR@sha256
WATCHTOWER_IMAGE=containrrr/watchtower     # ℹ️ runtime image; pin/mirror for production
POSTGRES_HOST_PORT=20210                # ℹ️  PostgreSQL 对外暴露端口
# Host ports for local-docker are SSOT'd in tools/runtime/profiles.json (see docs/guides/development/runtime-lanes.md).
REDIS_HOST_PORT=20211                   # ℹ️  Redis 对外暴露端口
API_HOST_PORT=20201                     # ℹ️  API 对外暴露端口
WEB_HOST_PORT=20200                     # ℹ️  Web 对外暴露端口
POWERSYNC_HOST_PORT=20202               # ℹ️  PowerSync 对外暴露端口
LOCAL_DOCKER_BIND_HOST=127.0.0.1         # 🔐 local-docker 默认仅宿主 loopback；远程访问应通过 TLS reverse proxy / Tailscale Serve

# =============================================================================
# 3️⃣  数据库配置 (PostgreSQL)
# =============================================================================
# 推荐使用分解配置（Docker 最佳实践）✅
# 
# 处理逻辑：
#   • 如果提供 DATABASE_URL，直接使用（优先级最高）
#   • 否则从 DB_* 变量自动生成：
#     postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public
# 
# 优势：
#   • Docker Compose 中轻松变量替换 ${DB_HOST}
#   • PostgreSQL 和 API 容器共用配置
#   • 特殊字符无需 URL 编码
#   • 清晰易维护

# ✅ 推荐方案：分解配置
DB_HOST=localhost                       # ⚠️  数据库主机（localhost | postgres 服务名）
DB_PORT=5432                            # ℹ️  数据库端口（默认 5432）
DB_NAME=MemoFlow                        # ℹ️  数据库名
DB_USER=MemoFlow                        # ℹ️  数据库用户（必须与 PostgreSQL 的 POSTGRES_USER 一致）
DB_PASSWORD=your-secure-password        # ⚠️  数据库密码（必须修改为强密码）

# ⚠️  备选方案：完整连接字符串（不推荐）
# 如果提供此变量，应用会忽略上面的 DB_* 配置
# DATABASE_URL=postgresql://user:password@localhost:5432/MemoFlow?schema=public

# 集成测试数据库（可选覆盖）
# TEST_DB_HOST=127.0.0.1
# TEST_DB_PORT=5433
# TEST_DB_NAME=memoflow_test
# TEST_DB_USER=test_user
# TEST_DB_PASS=test_pass
# TEST_DB_CONTAINER=MemoFlow-test-db
# TEST_DATABASE_URL=postgresql://test_user:test_pass@127.0.0.1:5433/memoflow_test

# =============================================================================
# 4️⃣  Redis 缓存配置
# =============================================================================
# Redis 连接方式（二选一）

# 推荐方案 1：分解配置（Docker 最佳实践）✅
REDIS_HOST=localhost                    # ℹ️  Redis 主机（localhost | redis 服务名）
REDIS_PORT=6379                         # ℹ️  Redis 端口（默认 6379）
REDIS_PASSWORD=                         # ⚠️  Redis 密码（无密码留空，生产环境需要密码）
REDIS_DB=0                              # ℹ️  Redis 数据库号（默认 0）

# 备选方案 2：完整连接字符串（不推荐）
# 如果提供此变量，应用会忽略上面的 REDIS_* 配置
# REDIS_URL=redis://:password@localhost:6379/0

# =============================================================================
# 5️⃣  JWT 认证配置
# =============================================================================
# ⚠️  生产环境必须使用强随机密钥！
# 生成强密钥命令：
#   macOS/Linux:  openssl rand -base64 64
#   PowerShell:   [Convert]::ToBase64String($(New-Object -TypeName byte[] -ArgumentList 64 | % { $_[+$_] = Get-Random -Maximum 256 }))

JWT_SECRET=dev-jwt-secret-change-me-in-production-at-least-32-chars  # ⚠️  JWT 签名密钥（最少 32 字符）
JWT_EXPIRES_IN=7d                       # ℹ️  JWT Token 有效期（7d | 24h | 3600 等）
JWT_REFRESH_EXPIRES_IN=30d              # ℹ️  刷新 Token 有效期

# 可选：使用单独的刷新 Token 密钥
# REFRESH_TOKEN_SECRET=your-refresh-token-secret  # ℹ️  默认使用 JWT_SECRET，可选覆盖

# 可选：GitHub 登录（可插拔认证方式，ADR-034）
# ℹ️  仅在同时配置 CLIENT_ID 与 CLIENT_SECRET 时启用 GitHub 登录；
#     登录只做身份认证，不申请仓库 Contents 权限，仓库连接是独立授权。
# GITHUB_OAUTH_CLIENT_ID=your-github-app-client-id
# GITHUB_OAUTH_CLIENT_SECRET=your-github-app-client-secret  # ⚠️  仅服务端持有，切勿泄漏

# 可选：GitHub 知识仓库（同一个 GitHub App，但使用 App installation 权限链）
# ℹ️  四项必须成组配置。Private Key 支持把 PEM 换行写成 \n。
#     登录 OAuth token 不得替代 installation token；仓库权限建议仅 Contents: Read and write。
# GITHUB_APP_ID=your-github-app-id
# GITHUB_APP_SLUG=your-github-app-slug
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# GITHUB_APP_WEBHOOK_SECRET=your-at-least-32-character-webhook-secret

# =============================================================================
# 6️⃣  CORS 跨域配置
# =============================================================================
# 允许的请求来源（逗号分隔多个，* = 允许所有）
# ⚠️  生产环境不要使用 *，必须指定具体域名！
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
# CORS_ORIGIN=https://app.example.com,https://admin.example.com  # 生产环境示例

# =============================================================================
# 7️⃣  Web 前端配置
# =============================================================================
# Web 服务
WEB_PORT=8080                           # ℹ️  Web 服务端口（Docker 内部）
POWERSYNC_PORT=8080                     # ℹ️  PowerSync 服务端口（Docker 内部）

# Vite 环境变量（前端编译时使用）
# ⚠️  若值会随环境变化（如 VITE_ENABLE_MOCK_API），请优先放到 .env.development/.env.test/.env.production
VITE_DEV_PORT=5173                      # ℹ️  Web / Desktop 本地 Vite 开发端口
# VITE_DEV_SERVER_URL=http://localhost:5173  # 💬 Desktop 显式指定开发服务器地址（需要与 VITE_DEV_PORT 对齐）
VITE_API_BASE_URL=/api/v1               # ℹ️  API 基础路径（相对路径由 Nginx 反向代理）
VITE_API_URL=http://localhost:20201     # ℹ️  完整 API 地址（仅开发环境，生产用相对路径）
VITE_ENABLE_MOCK_API=false              # ℹ️  是否启用前端 Mock API（建议按环境分别配置）

# 应用域名（生产环境）
APP_DOMAIN=MemoFlow.bakersean.top       # ℹ️  应用前端域名（用于生成链接）
API_DOMAIN=api.MemoFlow.bakersean.top   # ℹ️  API 域名（用于生成文档链接）

# =============================================================================
# 8️⃣  文件上传配置
# =============================================================================
UPLOAD_MAX_SIZE=10485760                # ℹ️  最大上传文件大小（字节，默认 10MB）
# UPLOAD_PATH=/app/uploads              # ℹ️  上传文件保存路径（可选）

# Repository / Editor / AI knowledge 文件存储根目录
REPOSITORY_STORAGE_PATH=/tmp/memoflow-repository-storage  # ℹ️  默认为 /tmp/memoflow-repository-storage

# =============================================================================
# 9️⃣  AI 服务配置（可选）
# =============================================================================
# OpenAI API（用于 AI 对话、分析功能）
# OPENAI_API_KEY=sk-your-api-key                          # 💬 OpenAI 密钥
# OPENAI_MODEL=gpt-4-turbo-preview                        # 💬 默认模型
# OPENAI_BASE_URL=https://api.openai.com/v1              # 💬 API 地址

# 七牛云 AI 服务（可选替代方案）
# QI_NIU_YUN_API_KEY=your-key                             # 💬 七牛云密钥
# QI_NIU_YUN_BASE_URL=https://ai.qiniuapi.com            # 💬 七牛云 API 地址
# QI_NIU_YUN_MODEL_ID=your-model-id                       # 💬 模型 ID

# AI Provider 加密密钥（用于加密存储的第三方 API 密钥，AES-256-GCM）
# ⚠️  启用 AI 模块时必填：缺失时 AI provider 仓储会 fail-fast 拒绝启动，不再回退到公开默认密钥
AI_PROVIDER_ENCRYPTION_KEY=CHANGE_ME_dev_only_32byte_secret  # ⚠️  开发占位值；生产请用 `openssl rand -hex 32` 生成并替换
AI_PROVIDER_ENCRYPTION_KEY_ID=primary                          # ℹ️  active key id；轮换时改成新的稳定 ID
AI_PROVIDER_PRIVATE_ENDPOINT_ALLOWLIST=                        # 可选：仅部署管理员设置，如 10.0.0.5:8443,localhost:11434
AI_PROVIDER_ENCRYPTION_PREVIOUS_KEYS=                         # ℹ️  轮换兼容：old-id=old-secret,older-id=older-secret


# =============================================================================
# 9️⃣  PowerSync 同步配置（Desktop / Web 实时同步）
# =============================================================================
# 生产环境必须完整配置以下变量，否则 desktop 与 web 无法双向同步。
#
# 推荐公网暴露方式：
#   APP_DOMAIN=memoflow.example.com
#   POWERSYNC_DOMAIN=sync.memoflow.example.com
#   POWERSYNC_URL=https://sync.memoflow.example.com
#
# 生成 RSA 密钥后：
#   - API 使用私钥签发 PowerSync token
#   - PowerSync 服务使用公钥 JWK 验证 token
#
# POWERSYNC_DOMAIN=sync.memoflow.example.com               # ⚠️  PowerSync 公网域名（供 Caddy 反代）
# POWERSYNC_URL=https://sync.memoflow.example.com          # ⚠️  API 返回给 desktop/web 的 PowerSync endpoint
# POWERSYNC_PRIVATE_KEY=base64-encoded-pem                 # ⚠️  RS256 私钥（base64 编码后的 PEM）
# POWERSYNC_PUBLIC_KEY_N=...                               # ⚠️  RSA 公钥 JWK n
# POWERSYNC_PUBLIC_KEY_E=AQAB                              # ⚠️  RSA 公钥 JWK e（通常为 AQAB）
# POWERSYNC_KEY_ID=powersync-prod-key                      # ⚠️  JWK key id
# POWERSYNC_SNAPSHOT_DIR=/var/lib/memoflow/powersync-snapshots  # 可选：per-user SQLite snapshot 根目录
# SNAPSHOT_REBUILD_ENABLED=false                               # 启用自动 snapshot 重建（默认 false）
# SNAPSHOT_REBUILD_SCHEDULE="0 */4 * * *"                      # snapshot 重建 cron 表达式（默认每 4 小时）
# snapshot builder:
#   pnpm nx run api:powersync:snapshot:build -- --identity-id <identityId>

# 可选：live eval 使用的 provider 凭据

# =============================================================================
# 🔟 邮件服务配置（可选）
# =============================================================================
# Transactional auth mail (verify code / password reset). Default is console
# capture (local + LOCAL_VALIDATION last-email-code). Set EMAIL_PROVIDER=smtp
# or resend only when credentials are complete. Do not infer from NODE_ENV alone.
# Guide: docs/guides/development/transactional-email-smtp.md
# EMAIL_PROVIDER=console                                  # 💬 console | smtp | resend（默认 console）
# SMTP_HOST=smtp-relay.brevo.com                          # 💬 通用 SMTP 主机（任意中继）
# SMTP_PORT=587                                           # 💬 587=STARTTLS, 465=SSL
# SMTP_SECURE=false                                       # 💬 可选；465 时通常 true
# SMTP_USER=your-smtp-login                               # 💬 SMTP 用户名
# SMTP_PASS=your-smtp-key                                 # 💬 SMTP 密码 / API key（勿提交）
# SMTP_FROM=MemoFlow <noreply@mail.example.com>           # 💬 已验证域名的 From
# SMTP_REPLY_TO=support@example.com                       # 💬 可选 Reply-To
# SMTP_LOCALE=zh                                          # 💬 邮件模板 zh | en（也可用 EMAIL_LOCALE）
# RESEND_API_KEY=re_xxx                                   # 💬 EMAIL_PROVIDER=resend 时必填
# RESEND_FROM=MemoFlow <noreply@mail.example.com>         # 💬 Resend From（可回退 SMTP_FROM）
# SMTP_SECONDARY_HOST=                                    # 💬 可选第二 SMTP（主通道失败热备）
# SMTP_SECONDARY_PORT=587
# SMTP_SECONDARY_USER=
# SMTP_SECONDARY_PASS=
# SMTP_SECONDARY_FROM=
# AUTH_CHALLENGE_STORE=memory                             # 💬 memory（默认）| redis（多 API 副本）

# =============================================================================
# 1️⃣1️⃣ 阿里云 OSS 配置（可选）
# =============================================================================
# 用于存储用户上传的文件（替代本地存储）
# ALIYUN_ACCESS_KEY_ID=your-access-key-id                 # 💬 阿里云 AccessKey ID
# ALIYUN_ACCESS_KEY_SECRET=your-access-key-secret         # 💬 阿里云 AccessKey Secret
# ALIYUN_OSS_BUCKET=MemoFlow-bucket                       # 💬 OSS Bucket 名称
# ALIYUN_OSS_REGION=oss-cn-hangzhou                       # 💬 OSS 地域
# ALIYUN_OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com  # 💬 OSS 端点

# =============================================================================
# 1️⃣2️⃣ 监控和错误追踪配置（可选）
# =============================================================================
# Sentry 错误追踪（用于生产环境监控）
# SENTRY_DSN=https://xxxxx@sentry.io/xxxxx                # 💬 Sentry 项目 DSN

# 日志文件（可选，默认仅输出到控制台）
# LOG_FILE=/var/log/memoflow/app.log                      # 💬 日志文件路径

# =============================================================================
# 1️⃣3️⃣ 功能开关
# =============================================================================
# 日常分析功能
ENABLE_DAILY_ANALYSIS=true              # ℹ️  是否启用日常统计分析（true | false）

# 定时任务调度
USE_PRIORITY_QUEUE_SCHEDULER=true       # ℹ️  是否使用优先级队列调度器（true | false）

# =============================================================================
# 1️⃣4️⃣ 构建信息（CI/CD 自动注入，无需手动设置）
# =============================================================================
# BUILD_TIMESTAMP=2025-12-22T10:30:00Z   # 💬 构建时间戳（自动注入）
# GIT_COMMIT=abc1234567890def           # 💬 Git 提交 Hash（自动注入）
# GIT_BRANCH=main                        # 💬 Git 分支名（自动注入）

# 允许的 CORS 来源
# CORS_ORIGIN=http://localhost,http://localhost:20201,https://yourdomain.com

# Governance reference workbench navigation (production diagnostic opt-in)
VITE_ENABLE_GOVERNANCE_DEV_SURFACE=false
